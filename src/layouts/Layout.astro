        '/voice-recorder/': '/pt-br/gravador-de-voz/', '/mic-quality-test/': '/pt-br/teste-de-qualidade-do-microfone/',
        '/audio-reaction-test/': '/pt-br/teste-de-reacao-audio/', '/decibel-meter/': '/pt-br/medidor-de-decibeis/',
        '/loudness-meter/': '/pt-br/medidor-de-volume/', '/echo-test/': '/pt-br/teste-de-eco/', '/bpm-detector/': '/pt-br/detector-de-bpm/',
        '/key-detector/': '/pt-br/detector-de-tom-musical/', '/key-and-bpm-detector/': '/pt-br/detector-de-tom-e-bpm/',
        '/bluetooth-codec-guide/': '/pt-br/guia-de-codecs-bluetooth/', '/airpods-latency-test/': '/pt-br/teste-de-latencia-airpods/',
        '/devices/': '/pt-br/dispositivos/', '/about/': '/pt-br/sobre/', '/contact/': '/pt-br/contato/',
        '/privacy/': '/pt-br/privacidade/', '/terms/': '/pt-br/termos/',
      };
      document.querySelectorAll('a[href]').forEach((link) => {
        const href = link.getAttribute('href');
        const localePrefix = `/${locale.toLowerCase()}/`;
        if (!href || /^https?:/.test(href) || (locale !== 'pt-BR' && href.startsWith(localePrefix))) return;
        const target = locale === 'pt-BR' ? localizedPaths[href] : (href === '/' ? `/${locale.toLowerCase()}/` : `/${locale.toLowerCase()}${href}`);
        if (target) link.setAttribute('href', target);
      });
    }
  </script>
