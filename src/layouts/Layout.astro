  a { color: inherit; text-decoration: none; }
  button { cursor: pointer; font-family: inherit; }
  ul { list-style: none; }

  /* ── Layout helpers ── */
  .container {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-pad);
  }

  /* ── Typography tokens ── */
  .display-xl { font-size: 48px; font-weight: 600; line-height: 48px; letter-spacing: -2.4px; }
  .display-lg { font-size: 32px; font-weight: 600; line-height: 40px; letter-spacing: -1.28px; }
  .display-md { font-size: 24px; font-weight: 600; line-height: 32px; letter-spacing: -0.96px; }
  .display-sm { font-size: 20px; font-weight: 600; line-height: 28px; letter-spacing: -0.6px; }
  .body-lg    { font-size: 18px; font-weight: 400; line-height: 28px; }
  .body-md    { font-size: 16px; font-weight: 400; line-height: 24px; }
  .body-sm    { font-size: 14px; font-weight: 400; line-height: 20px; letter-spacing: -0.28px; }
  .caption    { font-size: 12px; font-weight: 400; line-height: 16px; }
  .caption-mono { font-family: var(--font-mono); font-size: 12px; font-weight: 400; line-height: 16px; }

  /* ── Buttons ── */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-xs);
    border: none;
    cursor: pointer;
    font-family: var(--font-sans);
    font-weight: 500;
    transition: opacity .15s, transform .1s;
    text-decoration: none;
    white-space: nowrap;
  }
  .btn:active { transform: scale(.98); }
  .btn:disabled { opacity: .45; cursor: not-allowed; pointer-events: none; }

  .btn-primary {
    background: var(--grad-develop);
    color: var(--on-gradient);
    font-size: 16px;
    line-height: 24px;
    border-radius: var(--r-pill);
    padding: 0 var(--s-sm);
    height: 40px;
    font-weight: 600;
  }
  .btn-primary:hover { opacity: .88; }

  .btn-secondary {
    background: var(--canvas);
    color: var(--ink);
    font-size: 16px;
    line-height: 24px;
    border-radius: var(--r-pill);
    padding: 0 var(--s-sm);
    height: 44px;
    box-shadow: var(--shadow-1);
  }
  .btn-secondary:hover { background: var(--canvas-soft-2); }

  .btn-sm {
    font-size: 14px;
    line-height: 20px;
    border-radius: var(--r-pill);
    padding: 0 var(--s-xs);
    height: 32px;
  }

  .btn-ghost {
    background: transparent;
    color: var(--body-text);
    font-size: 14px;
    border-radius: var(--r-full);
    padding: var(--s-xxs) var(--s-sm);
    height: 32px;
  }
  .btn-ghost:hover { background: var(--canvas-soft-2); }

  .btn-lg {
    font-size: 16px;
    height: 48px;
    padding: 0 var(--s-xl);
    border-radius: var(--r-pill);
  }

  /* ── Cards ── */
  .card {
    background: var(--canvas);
    border-radius: var(--r-md);
    padding: var(--s-lg);
    box-shadow: var(--shadow-2);
  }
  .card-lg {
    background: var(--canvas);
    border-radius: var(--r-lg);
    padding: var(--s-xl);
    box-shadow: var(--shadow-3);
  }
  .card-soft {
    background: var(--canvas-soft);
    border-radius: var(--r-md);
    padding: var(--s-lg);
    box-shadow: var(--shadow-1);
  }

  /* ── Badge ── */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--s-xxs);
    background: var(--canvas-soft);
    color: var(--body-text);
    font-family: var(--font-mono);
    font-size: 12px;
    border-radius: var(--r-full);
    padding: 0 var(--s-xs);
    height: 24px;
    box-shadow: var(--shadow-1);
  }
  .badge-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--hairline-strong);
    flex-shrink: 0;
  }
  .badge-dot.green  { background: #00b894; }
  .badge-dot.blue   { background: var(--link); }
  .badge-dot.purple { background: #7928ca; }

  /* ── Eyebrow label ── */
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--mute);
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  /* ════════════════════════
       NAV
  ════════════════════════ */
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--nav-bg);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--hairline);
  }

  /* Row 1 — brand, language selector, and theme toggle */
  .nav-top {
    height: var(--nav-top-height);
    border-bottom: 1px solid var(--hairline);
  }
  .nav-top-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }
  .nav-logo {
    display: flex;
    align-items: center;
    gap: var(--s-xs);
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.3px;
    flex-shrink: 0;
    text-decoration: none;
  }
  .language-menu {
    position: relative;
    margin-left: auto;
    margin-right: var(--s-sm);
    color: var(--body-text);
  }
  .language-menu-trigger {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 36px;
    max-width: min(42vw, 190px);
    padding: 5px 10px;
    border: 1px solid var(--hairline);
    border-radius: var(--r-full);
    color: var(--body-text);
    background: var(--canvas);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
    list-style: none;
    transition: color .15s, border-color .15s, background .15s;
  }
  .language-menu-trigger::-webkit-details-marker { display: none; }
  .language-menu-trigger:hover,
  .language-menu[open] .language-menu-trigger { color: var(--ink); border-color: var(--hairline-strong); background: var(--canvas-soft-2); }
  .language-menu-trigger span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .language-menu-trigger:focus-visible,
  .language-menu-option:focus-visible { outline: 2px solid var(--link); outline-offset: 2px; }
  .language-menu-chevron { flex: 0 0 auto; transition: transform .15s; }
  .language-menu[open] .language-menu-chevron { transform: rotate(180deg); }
  .language-menu-options {
    position: absolute;
    z-index: 120;
    top: calc(100% + 6px);
    right: 0;
    display: grid;
    width: min(260px, calc(100vw - 32px));
    max-height: min(70vh, 420px);
    overflow-y: auto;
    padding: 5px;
    border: 1px solid var(--hairline);
    border-radius: 12px;
    background: var(--canvas);
    box-shadow: 0 12px 32px rgba(0, 0, 0, .14);
  }
  .language-menu-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 40px;
    padding: 8px 10px;
    border-radius: 8px;
    color: var(--body-text);
    font-size: 14px;
    text-decoration: none;
  }
  .language-menu-option:hover,
  .language-menu-option-current { color: var(--ink); background: var(--canvas-soft-2); }
  .language-menu-option-current { font-weight: 600; }
  .language-menu-current-label { color: var(--mute); font-size: 11px; font-weight: 400; }

  /* Row 2 — scrollable tools strip */
  .nav-tools-bar {
    height: var(--nav-tools-height);
  }
  .nav-tools-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    gap: 2px;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0 2px;
  }
  .nav-tools-inner::-webkit-scrollbar { display: none; }
  .nav-tool {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 13px;
    color: var(--body-text);
    padding: 0 10px;
    height: 28px;
    border-radius: var(--r-full);
    white-space: nowrap;
    text-decoration: none;
    transition: color .15s, background .15s;
    flex-shrink: 0;
  }
  .nav-tool:hover { color: var(--ink); background: var(--canvas-soft-2); }
  .nav-tool.nav-active {
    color: var(--ink);
    font-weight: 500;
    background: var(--canvas-soft-2);
  }
  .nav-tool svg { flex-shrink: 0; }

  /* Theme toggle */
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    background: transparent;
    border-radius: var(--r-full);
    color: var(--body-text);
    cursor: pointer;
    position: relative;
    flex-shrink: 0;
    transition: color .15s, background .15s;
  }
  .theme-toggle:hover {
    color: var(--ink);
    background: var(--canvas-soft-2);
  }
  .theme-toggle svg {
    position: absolute;
    transition: opacity .22s ease, transform .22s ease;
  }
  .theme-toggle .icon-sun {
    opacity: 0;
    transform: rotate(30deg) scale(.85);
  }
  .theme-toggle .icon-moon {
    opacity: 1;
    transform: rotate(0) scale(1);
  }
  html[data-theme="dark"] .theme-toggle .icon-sun {
    opacity: 1;
    transform: rotate(0) scale(1);
  }
  html[data-theme="dark"] .theme-toggle .icon-moon {
    opacity: 0;
    transform: rotate(-30deg) scale(.85);
  }

  /* Mobile: hide logo wordmark on very small screens */
  @media (max-width: 380px) {
    .logo-text { display: none; }
  }

  /* ════════════════════════
       FOOTER
  ════════════════════════ */
  .footer {
    background: var(--canvas);
    border-top: 1px solid var(--hairline);
    padding-top: var(--s-4xl);
    padding-bottom: var(--s-xl);
    margin-top: 0;
  }
  .footer-inner {
    display: flex;
    gap: var(--s-4xl);
    padding-bottom: var(--s-xl);
    border-bottom: 1px solid var(--hairline);
    flex-wrap: wrap;
  }
  .footer-brand {
    flex: 1;
    min-width: 200px;
    display: flex;
    flex-direction: column;
    gap: var(--s-sm);
  }
  .footer-logo { color: var(--body-text); }
  .footer-tagline { font-size: 14px; color: var(--mute); max-width: 260px; line-height: 1.5; }
  .footer-cols { display: flex; gap: var(--s-4xl); flex-wrap: wrap; }
  .footer-col { display: flex; flex-direction: column; gap: var(--s-xs); min-width: 120px; }
  .footer-col-label {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink);
    text-transform: uppercase;
    letter-spacing: .06em;
    margin-bottom: var(--s-xxs);
  }
  .footer-link { font-size: 14px; color: var(--body-text); transition: color .15s; }
  .footer-link:hover { color: var(--ink); }
  .footer-bottom { padding-top: var(--s-lg); display: flex; align-items: center; flex-wrap: wrap; gap: var(--s-md); }
  .footer-bottom .caption-mono { color: var(--mute); flex: 1; }

  /* ── AS SEEN ON MARQUEE ── */
  .marquee-section {
    background: var(--canvas);
    border-top: 1px solid var(--hairline);
    display: flex;
    align-items: center;
    gap: var(--s-lg);
    padding: 0;
    overflow: hidden;
  }
  .marquee-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--mute);
    white-space: nowrap;
    padding: 0 var(--s-lg);
    flex-shrink: 0;
    border-right: 1px solid var(--hairline);
    align-self: stretch;
    display: flex;
    align-items: center;
  }
  .marquee-track-wrap {
    flex: 1;
    overflow: hidden;
    /* fade edges */
    mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
  }
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee-scroll 40s linear infinite;
  }
  .marquee-track:hover {
    animation-play-state: paused;
  }
  @keyframes marquee-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  .marquee-set {
    display: flex;
    align-items: center;
    gap: var(--s-xl);
    padding: var(--s-md) var(--s-xl);
    flex-shrink: 0;
  }
  .marquee-item {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    opacity: 0.75;
    transition: opacity .2s;
    text-decoration: none;
  }
  .marquee-item:hover { opacity: 1; }
  .marquee-item img { display: block; height: 36px; width: auto; max-width: none; }
  .marquee-item-tinystartups {
    gap: 8px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
    background: linear-gradient(#fff,#fff) padding-box, linear-gradient(90deg,#3525E6,#D81FE0,#22B8F0) border-box;
    border: 1.5px solid transparent;
    border-radius: 8px;
    padding: 6px 12px 6px 10px;
  }
  [data-theme="dark"] .marquee-item-tinystartups {
    background: linear-gradient(var(--canvas),var(--canvas)) padding-box, linear-gradient(90deg,#3525E6,#D81FE0,#22B8F0) border-box;
    color: var(--ink);
  }
  .ts-text { white-space: nowrap; }

  @media (max-width: 480px) {
    .marquee-label { display: none; }
  }

  /* ════════════════════════
       TOOL PAGE COMMONS
  ════════════════════════ */
  .tool-hero {
    padding-top: var(--s-4xl);
    padding-bottom: var(--s-xl);
    text-align: center;
  }
  .tool-hero h1 {
    font-size: clamp(32px, 5vw, 48px);
    font-weight: 600;
    letter-spacing: -2px;
    line-height: 1;
    color: var(--ink);
    margin-bottom: var(--s-md);
  }
  .tool-hero p {
    font-size: 18px;
    color: var(--body-text);
    max-width: 540px;
    margin-inline: auto;
    line-height: 1.6;
  }

  .tool-card-wrap {
    max-width: 640px;
    margin-inline: auto;
    padding: 0 var(--container-pad);
    margin-bottom: var(--s-3xl);
  }

  .tool-card {
    background: var(--canvas);
    border-radius: var(--r-lg);
    padding: var(--s-xl);
    box-shadow: var(--shadow-4);
    display: flex;
    flex-direction: column;
    gap: var(--s-lg);
  }

  /* Status pill */
  .status-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-sm);
  }
  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--mute);
    background: var(--canvas-soft);
    border-radius: var(--r-full);
    padding: 4px 10px;
    box-shadow: var(--shadow-1);
  }
  .status-pill .dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--hairline-strong);
    transition: background .3s;
    flex-shrink: 0;
  }
  .status-pill .dot.active  { background: #60a5fa; box-shadow: 0 0 0 3px rgba(96,165,250,.25); }
  .status-pill .dot.error   { background: var(--error); }
  .status-pill .dot.warning { background: var(--warning, #f5a623); }

  /* Channel indicators */
  .channels {
    display: flex;
    gap: var(--s-sm);
    justify-content: center;
  }
  .channel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-xs);
  }
  .channel-ring {
    width: 72px; height: 72px;
    border-radius: 50%;
    border: 1.5px solid var(--hairline);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    color: var(--mute);
    background: var(--canvas-soft);
    transition: all .25s;
    position: relative;
    overflow: hidden;
  }
  .channel-ring::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    opacity: 0;
    transition: opacity .25s;
  }
  .channel-ring.active {
    border-color: transparent;
    color: var(--on-gradient);
  }
  .channel-ring.active::before { opacity: 1; }
  .channel-ring.left.active  { background: var(--grad-develop); box-shadow: 0 0 0 4px rgba(96,165,250,.2); }
  .channel-ring.right.active { background: #7928ca; box-shadow: 0 0 0 4px rgba(121,40,202,.15); }
  .channel-ring.both.active  { background: var(--grad-develop); }
  .channel-label { font-size: 12px; color: var(--mute); font-family: var(--font-mono); }

  /* Action row */
  .action-row {
    display: flex;
    gap: var(--s-sm);
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    padding: 24px 0;
  }

  /* Level meter */
  .meter-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--s-xs);
  }
  .meter-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .meter-track {
    height: 6px;
    background: var(--canvas-soft-2);
    border-radius: var(--r-full);
    overflow: hidden;
    box-shadow: var(--shadow-1);
  }
  .meter-fill {
    height: 100%;
    border-radius: var(--r-full);
    background: var(--grad-develop);
    width: 0%;
    transition: width .08s linear;
  }
  .meter-fill.high { background: var(--grad-preview); }
  .meter-fill.clip { background: var(--grad-ship); }

  /* Canvas waveform */
  .waveform-canvas {
    width: 100%;
    height: 80px;
    border-radius: var(--r-sm);
    background: var(--canvas-soft-2);
    display: block;
  }

  /* Result note */
  .result-note {
    font-size: 14px;
    color: var(--mute);
    text-align: center;
    min-height: 20px;
    font-family: var(--font-mono);
    transition: color .2s;
  }
  .result-note.success { color: var(--link); }
  .result-note.error   { color: var(--error); }

  /* FAQ section */
  .faq-section {
    max-width: 680px;
    margin-inline: auto;
    padding: 0 var(--container-pad);
    padding-bottom: var(--s-5xl);
  }
  .faq-section h2 {
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.96px;
    margin-bottom: var(--s-xl);
  }
  .faq-item { border-top: 1px solid var(--hairline); padding: var(--s-lg) 0; }
  .faq-item:last-child { border-bottom: 1px solid var(--hairline); }
  .faq-q { font-size: 15px; font-weight: 500; color: var(--ink); margin-bottom: var(--s-xs); }
  .faq-a { font-size: 14px; color: var(--body-text); line-height: 1.6; }
  .faq-a a { color: var(--link); text-decoration: underline; text-underline-offset: 2px; }

  /* How it works */
  .how-section {
    max-width: 680px;
    margin-inline: auto;
    padding: 0 var(--container-pad);
    margin-bottom: var(--s-3xl);
  }
  .how-section h2 {
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.96px;
    margin-bottom: var(--s-xl);
  }
  .steps { display: flex; flex-direction: column; gap: var(--s-md); }
  .step {
    display: flex;
    gap: var(--s-md);
    align-items: flex-start;
  }
  .step-num {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--mute);
    background: var(--canvas-soft-2);
    width: 28px; height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-top: 2px;
    box-shadow: var(--shadow-1);
  }
  .step-body { font-size: 14px; color: var(--body-text); line-height: 1.6; }
  .step-body strong { color: var(--ink); font-weight: 500; }

  /* Ad slot */
  .ad-slot {
    background: var(--canvas-soft);
    border: 1px dashed var(--hairline);
    border-radius: var(--r-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: var(--s-xxs);
    color: var(--mute);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .04em;
    text-transform: uppercase;
  }
  .ad-slot-lg    { width: 100%; height: 90px; max-width: 728px; margin-inline: auto; }
  .ad-slot-rect  { width: 100%; height: 280px; max-width: 336px; margin-inline: auto; }
  .ad-wrap { padding: 0 var(--container-pad); margin-bottom: var(--s-3xl); }
  .ad-wrap-center { display: flex; justify-content: center; }

  /* Utilities */
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; }
  .text-center { text-align: center; }
  .mt-sm { margin-top: var(--s-sm); }
  .mt-md { margin-top: var(--s-md); }
  .mt-lg { margin-top: var(--s-lg); }
  .mb-lg { margin-bottom: var(--s-lg); }

  /* ════════════════════════
       PAGE + SIDEBAR LAYOUT
  ════════════════════════ */
  .page-layout {
    max-width: 1440px;
    margin-inline: auto;
    display: flex;
    align-items: stretch;
  }
  .page-main {
    flex: 1;
    min-width: 0;
  }
  .tool-sidebar {
    width: 256px;
    flex-shrink: 0;
    border-left: 1px solid var(--hairline);
  }
  .sidebar-inner {
    display: flex;
    flex-direction: column;
    gap: 2px;
    position: sticky;
    top: var(--nav-height);
