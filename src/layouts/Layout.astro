---
import ThemeToggle from '../components/ThemeToggle.astro';
import { buildAlternateLinks, buildSiteAlternates, getLocale, LOCALES, localizedToolPath, type AlternateLink } from '../lib/i18n';
import { getLocalizedChromeCopy, getLocalizedToolName } from '../data/localizedSiteCopy';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: object;
  pageClass?: string;
  sidebar?: boolean;
  keywords?: string;
  locale?: string;
  alternates?: AlternateLink[];
}

const { title, description, canonical, schema, pageClass = '', sidebar = false, keywords, locale = 'en', alternates = [] } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const site = 'https://onlineaudiotest.com';
const canonicalURL = canonical || new URL(Astro.url.pathname, site).href;
const ogImage = `${site}/ogImage.webp`;
const localeDefinition = getLocale(locale);
const navLabels = {
  mic: getLocalizedToolName(locale, 'mic-test'),
  speaker: getLocalizedToolName(locale, 'speaker-test'),
  latency: getLocalizedToolName(locale, 'latency-test'),
  hearing: getLocalizedToolName(locale, 'hearing-test'),
  frequency: getLocalizedToolName(locale, 'frequency-generator'),
  spectrum: getLocalizedToolName(locale, 'audio-spectrum-analyzer'),
  recorder: getLocalizedToolName(locale, 'voice-recorder'),
  quality: getLocalizedToolName(locale, 'mic-quality-test'),
  bpm: getLocalizedToolName(locale, 'bpm-detector'),
  key: getLocalizedToolName(locale, 'key-detector'),
};
const chrome = getLocalizedChromeCopy(locale);
const alternateLinks = buildSiteAlternates(currentPath).length ? buildSiteAlternates(currentPath) : buildAlternateLinks(alternates);
const localeOptions = Object.values(LOCALES).map((option) => {
  const alternate = alternateLinks.find((link) => link.hreflang === option.code);
  const homePath = option.code === 'en' ? '/' : option.code === 'pt-BR' ? '/pt-br/' : `/${option.code.toLowerCase()}/`;
  return { ...option, href: alternate?.href ?? homePath };
});
---
<!doctype html>
<html lang={localeDefinition.language} dir={localeDefinition.direction}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="shortcut icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="canonical" href={canonicalURL} />
  {alternateLinks.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}
  <meta name="generator" content={Astro.generator} />

  <!-- Primary Meta -->
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <meta name="robots" content="index, follow" />
  <meta name="theme-color" content="#ffffff" />
  <meta name="author" content="Dik Jain" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />
  <meta property="og:site_name" content="OnlineAudioTest.com" />
  <meta property="og:locale" content={localeDefinition.ogLocale} />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@onlineaudiotest" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={title} />

  <!-- Schema.org JSON-LD -->
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

  <!-- Ahrefs Analytics -->
  <script src="https://analytics.ahrefs.com/analytics.js" data-key="eQMqha88BpuLnkdURH6i7w" async></script>

  <!-- Apply saved theme before paint to prevent flash -->
  <script is:inline>
    (function () {
      try {
        var stored = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = stored === 'light' || stored === 'dark' ? stored : (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.style.colorScheme = theme;
      } catch (_) {}
    })();
  </script>
</head>
<body class={pageClass}>

  <!-- ───── NAV ───── -->
  <header class="nav" role="banner">

    <!-- Row 1: brand, language selector, and theme toggle -->
    <div class="nav-top">
      <div class="nav-top-inner container">
        <a href={locale === 'en' ? '/' : locale === 'pt-BR' ? '/pt-br/' : `/${locale.toLowerCase()}/`} class="nav-logo" aria-label="OnlineAudioTest home">
          <img src="/icon.png" width="22" height="22" alt="" aria-hidden="true" decoding="async" />
          <span class="logo-text">onlineaudiotest</span>
        </a>
        <details class="language-menu">
          <summary class="language-menu-trigger" aria-label={`Choose language. Current language: ${localeDefinition.label}`}>
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <circle cx="10" cy="10" r="7.25" stroke="currentColor" stroke-width="1.4" />
              <path d="M2.9 10h14.2M10 2.75c2 2 3 4.42 3 7.25s-1 5.25-3 7.25c-2-2-3-4.42-3-7.25s1-5.25 3-7.25Z" stroke="currentColor" stroke-width="1.2" />
            </svg>
            <span>{localeDefinition.label}</span>
            <svg class="language-menu-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path d="m3 4.5 3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <nav class="language-menu-options" aria-label="Choose language">
            {localeOptions.map((option) => (
              <a
                href={option.href}
                lang={option.language}
                aria-current={option.code === localeDefinition.code ? 'page' : undefined}
                class:list={['language-menu-option', { 'language-menu-option-current': option.code === localeDefinition.code }]}
              >
                <span>{option.label}</span>
                {option.code === localeDefinition.code && <span class="language-menu-current-label">Current</span>}
              </a>
            ))}
          </nav>
        </details>
        <ThemeToggle />
      </div>
    </div>

    <!-- Row 2: tools strip -->
    <div class="nav-tools-bar" role="navigation" aria-label="Audio tools">
      <div class="nav-tools-inner container">
        <a href={localizedToolPath('/mic-test/', locale)} class:list={['nav-tool', { 'nav-active': currentPath === '/mic-test' }]}>
          <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <rect x="7" y="2" width="6" height="11" rx="3" stroke="currentColor" stroke-width="1.5"/>
            <path d="M4 10a6 6 0 0012 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <line x1="10" y1="16" x2="10" y2="19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <line x1="7" y1="19" x2="13" y2="19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          {navLabels.mic}
        </a>
        <a href={localizedToolPath('/speaker-test/', locale)} class:list={['nav-tool', { 'nav-active': currentPath === '/speaker-test' }]}>
          <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M3 7h3.5L11 3v14l-4.5-4H3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="M14 7a4 4 0 010 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          {navLabels.speaker}
        </a>
        <a href={localizedToolPath('/latency-test/', locale)} class:list={['nav-tool', { 'nav-active': currentPath === '/latency-test' }]}>
          <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.5"/>
            <path d="M10 6v4.5l2.5 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          {navLabels.latency}
        </a>
        <a href={localizedToolPath('/hearing-test/', locale)} class:list={['nav-tool', { 'nav-active': currentPath === '/hearing-test' }]}>
          <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M2 10h2.5l2-5 3 10 2-7 2 5 1.5-3H18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          {navLabels.hearing}
        </a>
        <a href={localizedToolPath('/frequency-generator/', locale)} class:list={['nav-tool', { 'nav-active': currentPath === '/frequency-generator' }]}>
          <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M1 10 Q4 3 7 10 Q10 17 13 10 Q16 3 19 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          {navLabels.frequency}
        </a>
        <a href={localizedToolPath('/audio-spectrum-analyzer/', locale)} class:list={['nav-tool', { 'nav-active': currentPath === '/audio-spectrum-analyzer' }]}>
          <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <rect x="1" y="12" width="3" height="7" rx="1" stroke="currentColor" stroke-width="1.5"/>
            <rect x="6" y="7" width="3" height="12" rx="1" stroke="currentColor" stroke-width="1.5"/>
            <rect x="11" y="4" width="3" height="15" rx="1" stroke="currentColor" stroke-width="1.5"/>
            <rect x="16" y="9" width="3" height="10" rx="1" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          {navLabels.spectrum}
        </a>
        <a href={localizedToolPath('/voice-recorder/', locale)} class:list={['nav-tool', { 'nav-active': currentPath === '/voice-recorder' }]}>
          <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <rect x="7" y="2" width="6" height="9" rx="3" stroke="currentColor" stroke-width="1.5"/>
            <path d="M4 10a6 6 0 0012 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <line x1="10" y1="16" x2="10" y2="19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <circle cx="16" cy="4" r="2.5" fill="#ee0000"/>
          </svg>
          {navLabels.recorder}
        </a>
        <a href={localizedToolPath('/mic-quality-test/', locale)} class:list={['nav-tool', { 'nav-active': currentPath === '/mic-quality-test' }]}>
          <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <rect x="7" y="2" width="6" height="9" rx="3" stroke="currentColor" stroke-width="1.5"/>
            <path d="M4 10a6 6 0 0012 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M13 6l4-3M13 10h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          {navLabels.quality}
        </a>
        <a href={localizedToolPath('/bpm-detector/', locale)} class:list={['nav-tool', { 'nav-active': currentPath === '/bpm-detector' }]}>
          <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.5"/>
            <path d="M10 6v4.2l2.5 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          {navLabels.bpm}
        </a>
        <a href={localizedToolPath('/key-detector/', locale)} class:list={['nav-tool', { 'nav-active': currentPath === '/key-detector' || currentPath === '/key-and-bpm-detector' }]}>
          <svg width="14" height="14" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M9 19V6l12-3v13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="6" cy="19" r="3" stroke="currentColor" stroke-width="1.5"/>
            <circle cx="18" cy="16" r="3" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          {navLabels.key}
        </a>
      </div>
    </div>

  </header>

  <!-- ───── CONTENT ───── -->
  {sidebar ? (
    <div class="page-layout">
      <main id="main-content" class="page-main">
        <slot />
      </main>
      <aside class="tool-sidebar" aria-label="Other tests">
        <div class="sidebar-inner">

          <a href="/mic-test/" class:list={['sidebar-item', { active: currentPath === '/mic-test' }]}>
            <div class="sidebar-icon">
              <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <rect x="7" y="2" width="6" height="11" rx="3" stroke="currentColor" stroke-width="1.5"/>
                <path d="M4 10a6 6 0 0012 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <line x1="10" y1="16" x2="10" y2="19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <line x1="7" y1="19" x2="13" y2="19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </div>
            <div class="sidebar-text">
              <span class="sidebar-item-title">Test your Microphone</span>
              <span class="sidebar-item-desc">Input levels &amp; recording</span>
            </div>
          </a>

          <a href="/speaker-test/" class:list={['sidebar-item', { active: currentPath === '/speaker-test' }]}>
            <div class="sidebar-icon">
              <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M3 7h3.5L11 3v14l-4.5-4H3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                <path d="M14 7a4 4 0 010 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </div>
            <div class="sidebar-text">
              <span class="sidebar-item-title">Test your Speakers</span>
              <span class="sidebar-item-desc">Left, right &amp; stereo output</span>
            </div>
          </a>

          <a href="/latency-test/" class:list={['sidebar-item', { active: currentPath === '/latency-test' }]}>
            <div class="sidebar-icon">
              <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.5"/>
                <path d="M10 6v4.5l2.5 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="sidebar-text">
              <span class="sidebar-item-title">Audio Latency Test</span>
              <span class="sidebar-item-desc">Bluetooth delay &amp; lag check</span>
            </div>
          </a>

          <a href="/hearing-test/" class:list={['sidebar-item', { active: currentPath === '/hearing-test' }]}>
            <div class="sidebar-icon">
              <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M2 10h2.5l2-5 3 10 2-7 2 5 1.5-3H18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="sidebar-text">
              <span class="sidebar-item-title">Hearing Test</span>
              <span class="sidebar-item-desc">Frequency range &amp; hearing age</span>
            </div>
          </a>

          <a href="/frequency-generator/" class:list={['sidebar-item', { active: currentPath === '/frequency-generator' }]}>
            <div class="sidebar-icon">
              <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M1 10 Q4 3 7 10 Q10 17 13 10 Q16 3 19 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="sidebar-text">
              <span class="sidebar-item-title">Frequency Generator</span>
              <span class="sidebar-item-desc">Tone generator, 20 Hz–20 kHz</span>
            </div>
          </a>

          <a href="/audio-spectrum-analyzer/" class:list={['sidebar-item', { active: currentPath === '/audio-spectrum-analyzer' }]}>
            <div class="sidebar-icon">
              <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <rect x="1" y="12" width="3" height="7" rx="1" stroke="currentColor" stroke-width="1.5"/>
                <rect x="6" y="7" width="3" height="12" rx="1" stroke="currentColor" stroke-width="1.5"/>
                <rect x="11" y="4" width="3" height="15" rx="1" stroke="currentColor" stroke-width="1.5"/>
                <rect x="16" y="9" width="3" height="10" rx="1" stroke="currentColor" stroke-width="1.5"/>
              </svg>
            </div>
            <div class="sidebar-text">
              <span class="sidebar-item-title">Spectrum Analyzer</span>
              <span class="sidebar-item-desc">Real-time FFT frequency analysis</span>
            </div>
          </a>

          <a href="/voice-recorder/" class:list={['sidebar-item', { active: currentPath === '/voice-recorder' }]}>
            <div class="sidebar-icon">
              <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <rect x="7" y="2" width="6" height="9" rx="3" stroke="currentColor" stroke-width="1.5"/>
                <path d="M4 10a6 6 0 0012 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <line x1="10" y1="16" x2="10" y2="19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </div>
            <div class="sidebar-text">
              <span class="sidebar-item-title">Voice Recorder</span>
              <span class="sidebar-item-desc">Record, trim &amp; download audio</span>
            </div>
          </a>

          <a href="/mic-quality-test/" class:list={['sidebar-item', { active: currentPath === '/mic-quality-test' }]}>
            <div class="sidebar-icon">
              <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <rect x="7" y="2" width="6" height="9" rx="3" stroke="currentColor" stroke-width="1.5"/>
                <path d="M4 10a6 6 0 0012 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M13 6l4-3M13 10h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </div>
            <div class="sidebar-text">
              <span class="sidebar-item-title">Mic Quality Test</span>
              <span class="sidebar-item-desc">SNR, noise floor &amp; quality score</span>
            </div>
          </a>

          <a href="/bpm-detector/" class:list={['sidebar-item', { active: currentPath === '/bpm-detector' }]}>
            <div class="sidebar-icon">
              <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.5"/>
                <path d="M10 6v4.2l2.5 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="sidebar-text">
              <span class="sidebar-item-title">BPM Detector</span>
              <span class="sidebar-item-desc">Find the tempo of any song</span>
            </div>
          </a>

          <a href="/key-detector/" class:list={['sidebar-item', { active: currentPath === '/key-detector' }]}>
            <div class="sidebar-icon">
              <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M9 19V6l12-3v13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="6" cy="19" r="3" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="18" cy="16" r="3" stroke="currentColor" stroke-width="1.5"/>
              </svg>
            </div>
            <div class="sidebar-text">
              <span class="sidebar-item-title">Key Detector</span>
              <span class="sidebar-item-desc">Find the musical key of a song</span>
            </div>
          </a>

          <a href="/key-and-bpm-detector/" class:list={['sidebar-item', { active: currentPath === '/key-and-bpm-detector' }]}>
            <div class="sidebar-icon">
              <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M9 19V6l12-3v13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="6" cy="19" r="3" stroke="currentColor" stroke-width="1.5"/>
                <circle cx="18" cy="16" r="3" stroke="currentColor" stroke-width="1.5"/>
                <path d="M15 7.5l3-1.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
              </svg>
            </div>
            <div class="sidebar-text">
              <span class="sidebar-item-title">Key + BPM Detector</span>
              <span class="sidebar-item-desc">Key and tempo in one analysis</span>
            </div>
          </a>

        </div>
      </aside>
    </div>
  ) : (
    <main id="main-content">
      <slot />
    </main>
  )}

  <!-- ───── FOOTER ───── -->
  <footer class="footer" role="contentinfo">
    <div class="container footer-inner">
      <div class="footer-brand">
        <a href={locale === 'en' ? '/' : locale === 'pt-BR' ? '/pt-br/' : `/${locale.toLowerCase()}/`} class="nav-logo footer-logo">
          <img src="/icon.png" width="18" height="18" alt="" aria-hidden="true" loading="lazy" decoding="async" />
          <span>onlineaudiotest</span>
        </a>
        <p class="footer-tagline">{chrome.tagline}</p>
      </div>

      <div class="footer-cols">
        <div class="footer-col">
          <span class="footer-col-label">{chrome.tools}</span>
          <a href={localizedToolPath('/audio-test/', locale)} class="footer-link">{getLocalizedToolName(locale, 'audio-test')}</a>
          <a href={localizedToolPath('/audio-device-check/', locale)} class="footer-link">{getLocalizedToolName(locale, 'audio-device-check')}</a>
          <a href={localizedToolPath('/mic-test/', locale)} class="footer-link">{getLocalizedToolName(locale, 'mic-test')}</a>
          <a href={localizedToolPath('/speaker-test/', locale)} class="footer-link">{getLocalizedToolName(locale, 'speaker-test')}</a>
          <a href={localizedToolPath('/headphone-test/', locale)} class="footer-link">{getLocalizedToolName(locale, 'headphone-test')}</a>
          <a href={localizedToolPath('/latency-test/', locale)} class="footer-link">{getLocalizedToolName(locale, 'latency-test')}</a>
          <a href={localizedToolPath('/airpods-latency-test/', locale)} class="footer-link">{getLocalizedToolName(locale, 'airpods-latency-test')}</a>
          <a href={localizedToolPath('/bluetooth-latency-test/', locale)} class="footer-link">{getLocalizedToolName(locale, 'bluetooth-latency-test')}</a>
          <a href={localizedToolPath('/hearing-test/', locale)} class="footer-link">{getLocalizedToolName(locale, 'hearing-test')}</a>
          <a href={localizedToolPath('/frequency-generator/', locale)} class="footer-link">{getLocalizedToolName(locale, 'frequency-generator')}</a>
