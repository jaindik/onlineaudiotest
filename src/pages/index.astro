---
import Layout from '../layouts/Layout.astro';
import { buildHomeAlternates } from '../lib/i18n';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "name": "OnlineAudioTest.com",
      "url": "https://onlineaudiotest.com/",
      "description": "Free browser-based audio test tools. Mic check online, left right audio test, stereo audio test, headphone test, and audio latency test — no download required.",
    },
    {
      "@type": "Organization",
      "name": "OnlineAudioTest.com",
      "url": "https://onlineaudiotest.com/",
      "logo": "https://onlineaudiotest.com/icon.png"
    },
    {
      "@type": "ItemList",
      "name": "Free Online Audio Test Tools",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "url": "https://onlineaudiotest.com/mic-test/",                    "name": "Mic Check Online — Free Microphone & Earphone Mic Test" },
        { "@type": "ListItem", "position": 2, "url": "https://onlineaudiotest.com/speaker-test/",               "name": "Speaker Test — Check Speaker Sound and Left/Right Channels" },
        { "@type": "ListItem", "position": 3, "url": "https://onlineaudiotest.com/headphone-test/",            "name": "Headphone Test — Check Sound, Left/Right Channels, and Balance" },
        { "@type": "ListItem", "position": 4, "url": "https://onlineaudiotest.com/latency-test/",               "name": "Audio Latency Test — Check Audio Delay" },
        { "@type": "ListItem", "position": 5, "url": "https://onlineaudiotest.com/hearing-test/",               "name": "Online Hearing Test — Check Your Hearing Range" },
        { "@type": "ListItem", "position": 6, "url": "https://onlineaudiotest.com/audio-spectrum-analyzer/",    "name": "Audio Spectrum Analyzer — Real-Time Microphone Frequency Visualizer" },
        { "@type": "ListItem", "position": 7, "url": "https://onlineaudiotest.com/voice-recorder/",             "name": "Online Voice Recorder — Record and Download Audio" },
        { "@type": "ListItem", "position": 8, "url": "https://onlineaudiotest.com/mic-quality-test/",           "name": "Microphone Quality Test — Analyze Noise and Clipping" },
        { "@type": "ListItem", "position": 9, "url": "https://onlineaudiotest.com/bpm-detector/",               "name": "BPM Detector — Find the Tempo of a Song" },
        { "@type": "ListItem", "position": 10, "url": "https://onlineaudiotest.com/key-detector/",              "name": "Song Key Detector — Find the Musical Key" },
        { "@type": "ListItem", "position": 11, "url": "https://onlineaudiotest.com/key-and-bpm-detector/",      "name": "Key and BPM Detector — Find Key and Tempo Together" }
      ]
    },
  ]
};

const tools = [
  {
    href: '/mic-test/',
    eyebrow: 'Mic Check Online',
    title: 'Mic Test',
    desc: 'Check whether your browser receives microphone input, then record and play back a short sample.',
    gradClass: 'develop',
    cta: 'Test my microphone →',
  },
  {
    href: '/speaker-test/',
    eyebrow: 'Left Right Audio Test',
    title: 'Speaker Test',
    desc: 'Check speaker sound, left and right channels, and stereo balance. Use the test with speakers, soundbars, or another audio output.',
    gradClass: 'preview',
    cta: 'Run stereo test →',
  },
  {
    href: '/headphone-test/',
    eyebrow: 'Headphone Sound Test',
    title: 'Headphone Test',
    desc: 'Check left and right headphone audio, balance, bass, treble, and distortion with separate listening tests.',
    gradClass: 'ship',
    cta: 'Test headphones →',
  },
  {
    href: '/latency-test/',
    eyebrow: 'Bluetooth & System Delay',
    title: 'Latency Test',
    desc: 'View browser-reported output timing or estimate playback-to-microphone round-trip delay. Neither isolates Bluetooth codec latency.',
    gradClass: 'ship',
    cta: 'Measure latency →',
  },
  {
    href: '/hearing-test/',
    eyebrow: 'Frequency Listening Check',
    title: 'Hearing Test',
    desc: 'A browser tone sweep that reports the highest frequency heard in this session. Results are affected by playback equipment and are not a clinical hearing assessment.',
    gradClass: 'develop',
    cta: 'Test my hearing →',
  },
  {
    href: '/audio-spectrum-analyzer/',
    eyebrow: 'Real-Time FFT Visualizer',
    title: 'Spectrum Analyzer',
    desc: 'View a live spectrum of the selected microphone input, with peak hold, dominant-frequency estimate, and note labels. Values depend on input and browser processing.',
    gradClass: 'preview',
    cta: 'Open spectrum analyzer →',
  },
  {
    href: '/voice-recorder/',
    eyebrow: 'Browser Audio Recorder',
    title: 'Voice Recorder',
    desc: 'Record, pause, trim, normalize, and export audio in this browser. The recording tool does not upload audio; the site separately loads page-usage analytics.',
    gradClass: 'ship',
    cta: 'Start recording →',
  },
  {
    href: '/mic-quality-test/',
    eyebrow: 'Mic Diagnostic Report',
    title: 'Microphone Quality Test',
    desc: 'Review relative input-level, clipping, and quiet-frame indicators from a short recording. The score and suggestions are session heuristics, not a microphone grade.',
    gradClass: 'develop',
    cta: 'Test mic quality →',
  },
  {
    href: '/bpm-detector/',
    eyebrow: 'Tempo Finder',
    title: 'BPM Detector',
    desc: 'Upload an audio file your browser can decode to estimate tempo. Short, noisy, or rhythmically ambiguous clips can produce uncertain or half/double-time results.',
    gradClass: 'preview',
    cta: 'Detect BPM →',
  },
  {
    href: '/key-detector/',
    eyebrow: 'Musical Key Finder',
    title: 'Song Key Detector',
    desc: 'Upload a browser-decodable audio file for a musical-key estimate and Camelot reference. Results can be uncertain for short, noisy, or weakly tonal tracks.',
    gradClass: 'ship',
    cta: 'Find the key →',
  },
  {
    href: '/key-and-bpm-detector/',
    eyebrow: 'DJ Analysis Tool',
    title: 'Key + BPM Detector',
    desc: 'Estimate key and tempo from one uploaded clip, with a Camelot reference. Check uncertain results and preview transitions by ear.',
    gradClass: 'develop',
    cta: 'Analyze track →',
  },
  {
    href: '/decibel-meter/',
    eyebrow: 'Live Sound Level',
    title: 'Decibel Meter',
    desc: 'View a relative microphone input level in dBFS with peak, average, and minimum. It is not a calibrated sound-pressure meter.',
    gradClass: 'ship',
    cta: 'Measure sound level →',
  },
  {
    href: '/loudness-meter/',
    eyebrow: 'Mic Level Estimate',
    title: 'Loudness Meter',
    desc: 'View a simplified live microphone level estimate. This browser tool is not a standards-compliant LUFS meter.',
    gradClass: 'preview',
    cta: 'Check loudness →',
  },
  {
    href: '/echo-test/',
    eyebrow: 'Call Diagnostic',
    title: 'Echo Test',
    desc: 'Play and record a short local check to hear whether your mic picks up speaker sound in this setup. It cannot certify echo cancellation in a meeting app.',
    gradClass: 'develop',
    cta: 'Test for echo →',
  },
  {
    href: '/audio-reaction-test/',
    eyebrow: 'Reflex Test',
    title: 'Audio Reaction Test',
    desc: 'Try a five-round browser reaction exercise. Results include audio, display, input, browser, and device timing; they are not a universal benchmark.',
    gradClass: 'ship',
    cta: 'Test my reflexes →',
  },
];
---

<Layout
  alternates={buildHomeAlternates()}
  title="Online Audio Test - Free Mic, Speaker, Headphone & Latency"
  description="Free browser tools to check microphone input, speaker and headphone channels, audio timing, and more. No download or account required."
  keywords="online audio test, microphone test online, speaker test, left right audio test, headphone sound test, audio latency test"
  schema={schema}
>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-gradient" aria-hidden="true"></div>
    <div class="container hero-content">
      <div class="hero-badge-row">
        <span class="badge">
          <span class="badge-dot green"></span>
          All tools free · No signup
        </span>
      </div>
      <h1 class="hero-title">
        Free online audio tests.<br />Check your setup.
      </h1>
      <p class="hero-desc">
        Choose a browser test for your microphone, speakers, headphones, or audio timing. Results describe what this browser and selected setup can report.
      </p>
      <div class="hero-actions">
        <a href="/mic-test/" class="btn btn-primary btn-lg">
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <rect x="7" y="2" width="6" height="11" rx="3" stroke="currentColor" stroke-width="1.5"/>
            <path d="M4 10a6 6 0 0012 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <line x1="10" y1="16" x2="10" y2="19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <line x1="7" y1="19" x2="13" y2="19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          Mic Check Online
        </a>
        <a href="/speaker-test/" class="btn btn-secondary btn-lg">
          <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M3 7h3.5L11 3v14l-4.5-4H3z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="M14 7a4 4 0 010 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          Left Right Audio Test
        </a>
      </div>
    </div>
  </section>

  <!-- TOOL GRID -->
  <section class="tools-section">
    <div class="container">
      <div class="tools-header">
        <span class="eyebrow">Audio Tools</span>
        <h2 class="display-md tools-title">Free audio tools. Every device.</h2>
        <p><a href="/audio-test/">Not sure which test to choose? Browse audio diagnostics →</a></p>
      </div>
      <div class="tools-grid">
        {tools.map(tool => (
          <a href={tool.href} class="tool-card-link">
            <article class="tool-card-item">
              <div class={`tool-card-accent accent-${tool.gradClass}`}></div>
              <div class="tool-card-body">
                <span class="eyebrow">{tool.eyebrow}</span>
                <h3 class="tool-card-title">{tool.title}</h3>
                <p class="tool-card-desc">{tool.desc}</p>
              </div>
              <div class="tool-card-footer">
                <span class="tool-card-cta">{tool.cta}</span>
              </div>
            </article>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- WHY SECTION -->
  <section class="why-section">
    <div class="container">
      <div class="why-header">
        <span class="eyebrow">Why OnlineAudioTest</span>
        <h2 class="display-md why-title">Built for clarity. Designed for speed.</h2>
      </div>
      <div class="why-grid">
        <div class="why-card card-soft">
          <span class="why-icon">⚡</span>
          <h3 class="why-card-title">No install or account</h3>
          <p class="why-card-desc">Open a tool in your browser. Tests that need a microphone ask for permission before accessing it.</p>
        </div>
        <div class="why-card card-soft">
          <span class="why-icon">🎯</span>
          <h3 class="why-card-title">Purpose-built checks</h3>
          <p class="why-card-desc">Choose a tool for a particular audio task and see what its result can and cannot tell you.</p>
        </div>
        <div class="why-card card-soft">
          <span class="why-icon">🔒</span>
          <h3 class="why-card-title">Audio processed in your browser</h3>
          <p class="why-card-desc">The audio tools do not upload microphone audio or test result values. The site separately loads analytics for page usage; see the <a href="/privacy/">privacy policy</a>.</p>
        </div>
        <div class="why-card card-soft">
          <span class="why-icon">📱</span>
          <h3 class="why-card-title">Use in a modern browser</h3>
          <p class="why-card-desc">Tools that use a microphone or Web Audio need browser support and permission. File decoding and recording formats vary by browser.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SEO CONTENT -->
  <section class="seo-section">
    <div class="container seo-inner">
      <h2>Choose an online audio test for your setup</h2>
      <p>Start with the problem you notice. These browser checks help you inspect a signal or compare settings; they cannot identify every hardware fault or replace calibrated measurement equipment.</p>

      <h3>Check whether a microphone is working</h3>
      <p>Open the <a href="/mic-test/">online microphone test</a>, choose the input if prompted, allow browser access, and speak. A moving level display means the browser is receiving input. Record and play back a short sample to check how it sounds. If the browser receives nothing, confirm the selected input and site permission in your browser and operating system. This is a basic signal check, not a complete microphone-quality rating.</p>
      <p>For a longer session, the <a href="/mic-quality-test/">microphone quality test</a> reports relative level, clipping, and a quiet-frame estimate. Its score and suggestions are heuristics affected by room sound, gain, and browser processing.</p>

      <h3>Test speaker or headphone channels</h3>
      <p>Use the <a href="/speaker-test/">speaker sound test</a> or <a href="/headphone-test/">headphone test</a> to play left and right channels separately. Listen for which channel you hear and whether the routing matches the control. Mono settings, spatial audio, Bluetooth processing, and room acoustics can change what you hear; a listening test does not measure a driver or prove that hardware is damaged.</p>

      <h3>Understand browser audio timing</h3>
      <p>The <a href="/latency-test/">audio latency test</a> shows timing reported by the browser or an approximate playback-to-microphone round trip. The round-trip result also includes the speaker, room, mic placement, and processing; neither result isolates a Bluetooth codec or measures sound at your ear. For wireless setup context, see the <a href="/bluetooth-latency-test/">Bluetooth latency guide</a> and <a href="/bluetooth-codec-guide/">codec guide</a>.</p>

      <h3>Know what a microphone level reading means</h3>
      <p>The <a href="/decibel-meter/">online decibel meter</a> displays relative microphone input in dBFS. It is not calibrated to sound pressure (dB SPL or dBA) and should not be used to assess noise exposure. Use the <a href="/privacy/">privacy policy</a> to see how browser audio handling differs from site analytics.</p>
    </div>
  </section>

    <!-- FAQ SECTION -->
  <section class="faq-home-section">
    <div class="container faq-home-inner">
      <div class="faq-home-header">
        <span class="eyebrow">FAQ</span>
        <h2 class="display-md">Frequently asked questions</h2>
      </div>

      <div class="faq-home-grid">

        <details class="faq-home-item">
          <summary class="faq-home-q">Why does my headphone audio keep cutting out?</summary>
          <p class="faq-home-a">Audio dropouts can come from the source, connection, app, or headphones. Try the same headphones with another source, move closer if using Bluetooth, and check the app and device connection settings. A browser listening check cannot identify the faulty component.</p>
        </details>

        <details class="faq-home-item">
          <summary class="faq-home-q">Why is audio only playing in one headphone?</summary>
          <p class="faq-home-a">First check that the operating system balance is centered and test another app or source. Then use the <a href="/speaker-test/">left/right speaker test</a> to hear how each channel is routed. A silent side can have several causes; this listening check cannot diagnose a cable or driver.</p>
        </details>

        <details class="faq-home-item">
          <summary class="faq-home-q">Why does my headphone audio sound muffled?</summary>
          <p class="faq-home-a">Check volume, equalizer, fit, and device audio effects first. Compare both sides with the <a href="/headphone-test/">headphone sound test</a>, then try another source. A listening comparison cannot confirm driver damage or measure frequency response.</p>
        </details>

        <details class="faq-home-item">
          <summary class="faq-home-q">How do I test audio latency?</summary>
          <p class="faq-home-a">Open the <a href="/latency-test/">Audio Latency Test</a> to view browser-reported output timing or run a playback-to-microphone round-trip estimate. Neither method isolates codec delay or measures sound at your ear.</p>
        </details>

        <details class="faq-home-item">
          <summary class="faq-home-q">What is latency in audio?</summary>
          <p class="faq-home-a">Audio latency is the time taken by an audio path, usually described in milliseconds. Whether delay is noticeable or disruptive depends on the task, app synchronization, and the full playback path; one fixed threshold does not apply to every use.</p>
        </details>

        <details class="faq-home-item">
          <summary class="faq-home-q">What is low latency audio?</summary>
          <p class="faq-home-a">Low-latency audio means reducing delay through the full playback path. This depends on the app, device, connection, buffering, and hardware. Our <a href="/latency-test/">browser tool</a> reports browser timing or estimates playback-to-microphone delay; it does not certify end-to-end latency.</p>
        </details>

        <details class="faq-home-item">
          <summary class="faq-home-q">How do I check if my mic is working?</summary>
          <p class="faq-home-a">If the level display responds, the browser is receiving input from the selected microphone. If it does not, check site permission and input selection in the browser and operating system, then try another browser or app.</p>
        </details>

        <details class="faq-home-item">
          <summary class="faq-home-q">How do I do a left right audio test?</summary>
          <p class="faq-home-a">Open the <a href="/speaker-test/">Speaker Test</a>, play the left and right signals separately, and listen for which side produces each sound. If routing seems unexpected, check mono, balance, spatial-audio, and output-device settings. The result does not identify a faulty driver.</p>
        </details>

        <details class="faq-home-item">
          <summary class="faq-home-q">What is a stereo audio test?</summary>
          <p class="faq-home-a">A stereo test plays left and right signals separately so you can listen for channel routing. It cannot measure equal acoustic volume or diagnose wiring. Try the <a href="/speaker-test/">speaker test</a> with the output device you want to check.</p>
        </details>

        <details class="faq-home-item">
          <summary class="faq-home-q">Why does my microphone have echo or sound distorted?</summary>
          <p class="faq-home-a">Echo can occur when speaker audio is picked up by a microphone, but meeting apps and rooms can also affect it. Try headphones and check the call app?s input/output selection. Use the <a href="/echo-test/">echo test</a> to listen to a local playback-and-recording check; it cannot certify the app?s echo cancellation. For distortion, lower input gain and retry the <a href="/mic-test/">microphone test</a>.</p>
        </details>

      </div>
    </div>
  </section>

</Layout>

<style>
  /* Hero */
  .hero {
    position: relative;
    padding: var(--s-section) var(--container-pad) var(--s-5xl);
    text-align: center;
    overflow: hidden;
    background: var(--canvas);
    border-bottom: 1px solid var(--hairline);
  }
  .hero-gradient {
    position: absolute;
    inset: -30% -10%;
    background: var(--grad-hero);
    pointer-events: none;
    z-index: 0;
  }
  .hero-content { position: relative; z-index: 1; }
  .hero-badge-row { margin-bottom: var(--s-xl); }
  .hero-title {
    font-size: clamp(40px, 7vw, 72px);
    font-weight: 600;
    line-height: .96;
    letter-spacing: -3.5px;
    color: var(--ink);
    margin-bottom: var(--s-lg);
  }
  .hero-desc {
    font-size: 18px;
    color: var(--body-text);
    max-width: 500px;
    margin-inline: auto;
    margin-bottom: var(--s-xl);
    line-height: 1.6;
  }
  .hero-actions { display: flex; gap: var(--s-sm); justify-content: center; flex-wrap: wrap; }

  /* Tools grid - 3 columns */
  .tools-section { padding: var(--s-5xl) var(--container-pad); }
  .tools-header {
    text-align: center; margin-bottom: var(--s-2xl);
    display: flex; flex-direction: column; gap: var(--s-sm); align-items: center;
  }
  .tools-title { color: var(--ink); }
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-md);
    max-width: 960px;
    margin-inline: auto;
  }
  .tool-card-link { text-decoration: none; display: block; }
  .tool-card-item {
    background: var(--canvas); border-radius: var(--r-lg);
    box-shadow: var(--shadow-3); overflow: hidden;
    display: flex; flex-direction: column;
    transition: box-shadow .2s, transform .15s; height: 100%;
  }
  .tool-card-link:hover .tool-card-item { box-shadow: var(--shadow-4); transform: translateY(-2px); }
  .tool-card-accent { height: 4px; width: 100%; flex-shrink: 0; }
  .accent-develop { background: var(--grad-develop); }
  .accent-preview  { background: var(--grad-preview); }
  .accent-ship     { background: var(--grad-ship); }
  .tool-card-body { padding: var(--s-xl); flex: 1; display: flex; flex-direction: column; gap: var(--s-xs); }
  .tool-card-title { font-size: 20px; font-weight: 600; letter-spacing: -0.6px; color: var(--ink); margin-top: var(--s-xs); }
  .tool-card-desc { font-size: 14px; color: var(--body-text); line-height: 1.6; }
  .tool-card-footer { padding: var(--s-md) var(--s-xl); border-top: 1px solid var(--hairline); }
  .tool-card-cta { font-size: 13px; font-weight: 500; color: var(--body-text); transition: color .15s; }
  .tool-card-link:hover .tool-card-cta { color: var(--ink); }

  /* Why */
  .why-section { padding: var(--s-5xl) var(--container-pad); background: var(--canvas-soft); border-top: 1px solid var(--hairline); }
  .why-header { text-align: center; margin-bottom: var(--s-2xl); display: flex; flex-direction: column; gap: var(--s-sm); align-items: center; }
  .why-title { color: var(--ink); }
  .why-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s-md); max-width: 900px; margin-inline: auto; }
  .why-card { display: flex; flex-direction: column; gap: var(--s-sm); }
  .why-icon { font-size: 20px; }
  .why-card-title { font-size: 15px; font-weight: 600; color: var(--ink); letter-spacing: -0.3px; }
  .why-card-desc { font-size: 14px; color: var(--body-text); line-height: 1.6; }

  /* SEO content */
  .seo-section {
    padding: var(--s-5xl) var(--container-pad);
    background: var(--canvas);
    border-top: 1px solid var(--hairline);
  }
  .seo-inner {
    max-width: 760px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--s-lg);
  }
  .seo-inner h2 {
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -1px;
    color: var(--ink);
    line-height: 1.2;
    margin-bottom: var(--s-xs);
  }
  .seo-inner h3 {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.4px;
    color: var(--ink);
    margin-top: var(--s-md);
    margin-bottom: calc(-1 * var(--s-xs));
  }
  .seo-inner p {
    font-size: 15px;
    color: var(--body-text);
    line-height: 1.75;
  }

  /* FAQ */
  .faq-home-section {
    padding: var(--s-5xl) var(--container-pad);
    background: var(--canvas-soft);
    border-top: 1px solid var(--hairline);
  }
  .faq-home-inner { max-width: 860px; margin-inline: auto; }
  .faq-home-header {
    display: flex; flex-direction: column; gap: var(--s-sm);
    align-items: center; text-align: center;
    margin-bottom: var(--s-2xl);
    color: var(--ink);
  }
  .faq-home-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s-xs);
  }
  .faq-home-item {
    background: var(--canvas);
    border-radius: var(--r-md);
    box-shadow: var(--shadow-2);
    overflow: hidden;
  }
  .faq-home-q {
    display: block;
    font-size: 14px;
    font-weight: 500;
    color: var(--ink);
    padding: var(--s-md) var(--s-lg);
    cursor: pointer;
    list-style: none;
    position: relative;
    padding-right: var(--s-3xl);
    line-height: 1.4;
    user-select: none;
  }
  .faq-home-q::-webkit-details-marker { display: none; }
  .faq-home-q::after {
    content: '+';
    position: absolute;
    right: var(--s-md);
    top: 50%;
    transform: translateY(-50%);
    font-size: 18px;
    font-weight: 300;
    color: var(--mute);
    transition: transform .2s;
  }
  .faq-home-item[open] .faq-home-q::after {
    content: '−';
