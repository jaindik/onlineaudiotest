---
import Layout from '../layouts/Layout.astro';
import { buildToolAlternates } from '../lib/i18n';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Bluetooth Latency Test",
      "url": "https://onlineaudiotest.com/bluetooth-latency-test/",
      "description": "Free browser tool showing reported output latency or estimating playback-to-microphone round-trip delay on a Bluetooth audio route. It cannot identify the active codec.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "Any",
      "browserRequirements": "Requires Web Audio API support",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "provider": { "@type": "Organization", "name": "OnlineAudioTest.com", "url": "https://onlineaudiotest.com/" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://onlineaudiotest.com/" },
        { "@type": "ListItem", "position": 2, "name": "Latency Test", "item": "https://onlineaudiotest.com/latency-test/" },
        { "@type": "ListItem", "position": 3, "name": "Bluetooth Latency Test", "item": "https://onlineaudiotest.com/bluetooth-latency-test/" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Which Bluetooth codec has the lowest latency?",
          "acceptedAnswer": { "@type": "Answer", "text": "Some codecs are designed to reduce codec-related delay, but no codec name guarantees a specific end-to-end result. Delay also depends on both devices, operating system, buffering, and the app. Source and headphones need compatible support for a codec to be available." }
        },
        {
          "@type": "Question",
          "name": "How do I reduce Bluetooth audio delay on Android?",
          "acceptedAnswer": { "@type": "Answer", "text": "First check whether your Android version and manufacturer expose negotiated codec details in Developer Options or a companion app. Available settings vary, and a manual selection may not be supported by both devices. This browser test cannot confirm a codec change; compare repeated measurements using the same setup." }
        },
        {
          "@type": "Question",
          "name": "Does Bluetooth 5.0 reduce audio latency?",
          "acceptedAnswer": { "@type": "Answer", "text": "A Bluetooth version number alone does not establish audio latency. Codec support, device implementation, buffering, and the full audio path all matter. Check the specifications for the exact source and headphones; some gaming products use a separate 2.4 GHz dongle rather than Bluetooth." }
        },
        {
          "@type": "Question",
          "name": "My gaming headset has a 'Game Mode' — will it reduce Bluetooth latency?",
          "acceptedAnswer": { "@type": "Answer", "text": "A Game Mode may change processing or the wireless connection, but the name does not reveal which protocol is used or guarantee a latency figure. Some products use a separate 2.4 GHz USB dongle rather than Bluetooth. Check the exact product documentation and connection mode." }
        },
        {
          "@type": "Question",
          "name": "Why is Bluetooth audio delayed on iPhone?",
          "acceptedAnswer": { "@type": "Answer", "text": "iOS does not provide a general user-facing Bluetooth codec selector. Codec negotiation depends on the device and accessory. For timing-sensitive use, compare a wired connection with the same app and setup; this test cannot identify the active codec or explain app-specific synchronization." }
        },
        {
          "@type": "Question",
          "name": "How do I know which Bluetooth codec I'm using?",
          "acceptedAnswer": { "@type": "Answer", "text": "Some Android versions and manufacturer tools may display codec information while headphones are connected; menu names and availability vary. iOS does not provide a general user-facing codec display. This site cannot detect the active codec." }
        }
      ]
    }
  ]
};
---

<Layout
  title="Bluetooth Latency Test (Free) — Measure Audio Delay in ms"
  description="Check Bluetooth audio delay in your browser. View reported output latency or estimate playback-to-microphone round-trip delay."
  keywords="bluetooth latency test, bluetooth audio delay, wireless audio latency, bluetooth headphone latency, bluetooth 5.0 latency test, bluetooth audio lag test, aptx latency test, sbc latency test"
  canonical="https://onlineaudiotest.com/bluetooth-latency-test/"
  schema={schema}
  alternates={buildToolAlternates('/bluetooth-latency-test/', '/pt-br/teste-de-latencia-bluetooth/')}
  sidebar={true}
>

  <!-- HERO -->
  <section class="tool-hero container">
    <h1>Bluetooth Latency Test</h1>
    <p>Connect your Bluetooth headphones, earbuds, or speaker before testing. The first result uses latency values reported by your browser and audio device; the microphone round-trip test estimates playback-to-mic delay and may be affected by your room and setup.</p>
    <p style="font-size:16px;color:var(--body-text);max-width:540px;margin-inline:auto;margin-top:var(--s-md);line-height:1.6">Results can vary by browser, operating system, device, codec, and audio routing. Use the same test and setup when comparing a change; this page cannot identify the active codec by itself.</p>
  </section>

  <!-- TOOL -->
  <div class="tool-card-wrap">
    <div class="tool-card" id="latency-tool">

      <div class="status-bar">
        <div class="status-pill">
          <span class="dot" id="status-dot"></span>
          <span id="status-text">Connect Bluetooth device, then measure</span>
        </div>
        <span class="eyebrow caption-mono" id="phase-label"></span>
      </div>

      <div class="result-panel" id="result-panel" hidden>
        <div class="latency-display">
          <span class="latency-num" id="latency-num">-</span>
          <span class="latency-unit">ms</span>
        </div>
        <div class="grade-badge" id="grade-badge"></div>
        <div class="latency-breakdown" id="latency-breakdown" hidden>
          <span class="breakdown-item">Base <strong id="base-ms">-</strong> ms</span>
          <span class="breakdown-sep">·</span>
          <span class="breakdown-item">Output <strong id="output-ms">-</strong> ms</span>
        </div>
        <p class="latency-advice" id="latency-advice"></p>
      </div>

      <div class="action-row">
        <button class="btn btn-primary btn-lg" id="btn-measure" style="min-width:200px">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.4"/>
            <path d="M7 4v3.2l2 1.3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Test Bluetooth Latency
        </button>
        <button class="btn btn-secondary btn-sm" id="btn-roundtrip">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <rect x="4.5" y="1" width="3" height="6" rx="1.5" stroke="currentColor" stroke-width="1.3"/>
            <path d="M2.5 6a3.5 3.5 0 007 0" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
            <line x1="6" y1="9.5" x2="6" y2="11" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
          </svg>
          Round-Trip Test (mic)
        </button>
      </div>

      <p class="result-note" id="result-note">Make sure your Bluetooth device is set as your output before measuring.</p>
    </div>
  </div>

  <!-- CODEC COMPARISON -->
  <div class="how-section">
    <h2>Bluetooth codec latency comparison</h2>
    <p style="font-size:14px;color:var(--mute);margin-bottom:var(--s-md)">Codec choice can affect Bluetooth audio delay, but it is only one part of the audio path. Source and headphone implementation, buffering, operating-system processing, and the app also matter. This browser tool cannot detect the active codec or isolate its contribution. <a href="/bluetooth-codec-guide/">Learn how Bluetooth codecs work →</a></p>
    <div class="level-table-wrap">
      <table class="level-table">
        <thead>
          <tr>
            <th>Codec</th>
            <th>What to know</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td><strong>SBC</strong></td>
            <td>Baseline codec; total delay varies by implementation and audio path</td>
          </tr>
          <tr>
            <td><strong>AAC</strong></td>
            <td>Performance varies by source, headphones, and software</td>
          </tr>
          <tr>
            <td><strong>aptX</strong></td>
            <td>Codec support at both ends is required; total delay varies</td>
          </tr>
          <tr>
            <td><strong>aptX Adaptive</strong></td>
            <td>Adaptive modes and device implementation affect delay</td>
          </tr>
          <tr>
            <td><strong>aptX Low Latency</strong></td>
            <td>Designed for lower codec delay; end-to-end latency still varies</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- WHAT YOUR RESULT MEANS -->
  <div class="how-section">
    <h2>What does my result mean?</h2>
    <div class="steps">
      <div class="step">
        <span class="step-num">1</span>
        <p class="step-body">Read the value as a browser or device report, depending on the selected test. It does not identify a codec, establish a universal quality grade, or predict synchronization in a specific app.</p>
      </div>
      <div class="step">
        <span class="step-num">2</span>
        <p class="step-body">For comparisons, keep the same device, browser, output route, app state, and measurement method. Repeat the measurement to see whether a change is consistent.</p>
      </div>
      <div class="step">
        <span class="step-num">3</span>
        <p class="step-body">The microphone round-trip option estimates playback-to-microphone delay. Room acoustics, microphone placement, and browser or operating-system processing can affect it.</p>
      </div>
      <div class="step">
        <span class="step-num">4</span>
        <p class="step-body">To check a Bluetooth codec, use your device settings or the headphone maker’s documentation. This page cannot tell whether a codec change occurred.</p>
      </div>
    </div>
  </div>

  <!-- HOW TO CHECK CODEC ON ANDROID -->
  <div class="how-section">
    <h2>How to check and change your Bluetooth codec (Android)</h2>
    <div class="steps">
      <div class="step">
        <span class="step-num">1</span>
        <p class="step-body"><strong>Enable Developer Options.</strong> Go to Settings → About Phone → tap Build Number seven times. You'll see a confirmation that Developer Options is now enabled.</p>
      </div>
      <div class="step">
        <span class="step-num">2</span>
        <p class="step-body"><strong>Open Developer Options.</strong> Go back to Settings → System → Developer Options (location varies by manufacturer). Scroll down to find "Bluetooth Audio Codec".</p>
      </div>
      <div class="step">
        <span class="step-num">3</span>
        <p class="step-body"><strong>Check current codec information.</strong> If your Android version and manufacturer expose Bluetooth codec details in Developer Options, inspect the negotiated value while the headphones are connected. Menu names and available choices vary.</p>
      </div>
      <div class="step">
        <span class="step-num">4</span>
        <p class="step-body"><strong>Use supported device guidance.</strong> Codec settings may be unavailable, reset on reconnect, or ignored when one device does not support the selected option. Compare using the same setup and treat browser values as limited indicators.</p>
      </div>
    </div>
    <p style="font-size:13px;color:var(--mute);margin-top:var(--s-md)">Menu names and codec visibility vary across Android versions and manufacturers. iOS does not provide a general user-facing Bluetooth codec selector.</p>
  </div>

  <!-- GAMING HEADSETS -->
  <div class="how-section">
    <h2>Gaming headsets and Bluetooth latency</h2>
    <div class="steps">
      <div class="step">
        <span class="step-num">!</span>
        <p class="step-body"><strong>For timing-sensitive play, compare the complete setup.</strong> The browser value here does not predict audio and video synchronization inside a particular game. Test the game itself and check its audio settings and device guidance.</p>
      </div>
      <div class="step">
        <span class="step-num">✓</span>
        <p class="step-body"><strong>Check the connection type.</strong> Some gaming headsets use a USB dongle and proprietary 2.4 GHz wireless instead of Bluetooth. This page reports browser or device timing; it does not validate manufacturer latency claims. Select the intended output and compare using the same test setup.</p>
      </div>
      <div class="step">
        <span class="step-num">~</span>
        <p class="step-body"><strong>Check what Game Mode changes.</strong> The feature may change processing or wireless protocol, depending on the product. Check the headset manual to see whether it uses Bluetooth or a separate wireless dongle.</p>
      </div>
    </div>
  </div>

  <!-- FAQ -->
  <div class="faq-section">
    <h2>Frequently asked questions</h2>
    <div class="faq-item">
      <p class="faq-q">Which Bluetooth codec has the lowest latency?</p>
      <p class="faq-a">Some codecs are designed to reduce codec-related delay, but no codec name guarantees a specific end-to-end result. Delay also depends on both devices, operating system, buffering, and the app. Source and headphones need compatible support for a codec to be available.</p>
    </div>
    <div class="faq-item">
      <p class="faq-q">How do I reduce Bluetooth audio delay on Android?</p>
      <p class="faq-a">First check whether your Android version and manufacturer expose negotiated codec details in Developer Options or a companion app. Available settings vary, and a manual selection may not persist or be supported by both devices. This browser test cannot confirm a codec change; compare repeated measurements using the same setup.</p>
    </div>
    <div class="faq-item">
      <p class="faq-q">Does Bluetooth 5.0 reduce audio latency?</p>
      <p class="faq-a">A Bluetooth version number alone does not establish audio latency. Codec support, device implementation, buffering, and the full audio path all matter. Check the specifications for the exact source and headphones; some gaming products use a separate 2.4 GHz dongle rather than Bluetooth.</p>
    </div>
    <div class="faq-item">
      <p class="faq-q">My gaming headset has a 'Game Mode' — will it reduce Bluetooth latency?</p>
      <p class="faq-a">A Game Mode can change processing or wireless protocol, but behavior varies by product. Some gaming headsets use a separate 2.4 GHz USB dongle instead of Bluetooth. Check the documentation for the exact connection mode.</p>
    </div>
    <div class="faq-item">
      <p class="faq-q">Why is Bluetooth audio delayed on iPhone?</p>
      <p class="faq-a">iOS does not provide a general user-facing Bluetooth codec selector. Codec negotiation depends on the device and accessory. For timing-sensitive use, compare a wired connection with the same app and setup; this test cannot identify the active codec or explain app-specific synchronization.</p>
    </div>
    <div class="faq-item">
      <p class="faq-q">How do I know which Bluetooth codec I'm using?</p>
      <p class="faq-a">Some Android versions and manufacturer tools may display codec information while headphones are connected; menu names and availability vary. iOS does not provide a general user-facing codec display. This site cannot detect the active codec.</p>
    </div>
    <div class="faq-item">
      <p class="faq-q">Is LDAC better than aptX for low latency?</p>
      <p class="faq-a">LDAC is associated with higher-bitrate audio modes, but bitrate alone does not establish sound quality or end-to-end delay. Choose based on supported modes and your listening needs; this page cannot measure codec-specific delay.</p>
    </div>
    <div class="faq-item">
      <p class="faq-q">What is a good Bluetooth latency score?</p>
      <p class="faq-a">There is no universal score threshold on this page: one result may be a browser-reported output value, while the microphone option estimates a round trip. Neither identifies codec or predicts synchronization in a specific game or app.</p>
    </div>
    <div class="faq-item">
      <p class="faq-q">Why is my Bluetooth audio delayed?</p>
      <p class="faq-a">Bluetooth delay can involve codec processing, buffering, radio conditions, device firmware, operating-system processing, and the app. Their relative effects vary, so this test cannot identify a single cause. Check the device maker guidance and compare changes under the same conditions.</p>
    </div>
    <div class="faq-item">
      <p class="faq-q">Does Bluetooth version affect latency?</p>
      <p class="faq-a">A Bluetooth version number alone does not establish audio latency or LE Audio support. Check specifications for the exact source, headphones, operating system, and supported audio profile. End-to-end delay also depends on the full audio path.</p>
    </div>
  </div>

  <!-- WHY LATENCY MATTERS -->
  <div class="how-section">
    <h2>Why Bluetooth latency matters</h2>
    <div class="steps">
      <div class="step">
        <span class="step-num">!</span>
        <p class="step-body"><strong>Gaming</strong> — In competitive games, Bluetooth latency means you hear gunshots, footsteps, or alerts after they happen. Even 100 ms of delay is enough to put you at a disadvantage. Wired audio or a 2.4 GHz wireless headset is the standard for serious gaming.</p>
      </div>
      <div class="step">
        <span class="step-num">~</span>
        <p class="step-body"><strong>Watching movies and streaming video</strong> — Video players compensate for Bluetooth delay by buffering audio and video together, so you typically don't notice the latency. This is why AirPods and Bluetooth headphones work fine for Netflix and YouTube despite their delay.</p>
      </div>
      <div class="step">
        <span class="step-num">~</span>
        <p class="step-body"><strong>Video calls (Zoom, FaceTime, Teams)</strong> — Bluetooth latency affects how quickly you hear the other person, but both sides are on Bluetooth so the conversation feels natural. The main issue is when the microphone causes a codec switch, degrading audio quality — not the latency itself.</p>
      </div>
      <div class="step">
        <span class="step-num">✓</span>
        <p class="step-body"><strong>Music listening</strong> — Bluetooth latency is irrelevant for music. There's no reference event to sync against, so the delay is completely imperceptible. Codec choice for music should prioritize audio quality (LDAC, AAC, aptX HD) rather than latency.</p>
      </div>
      <div class="step">
        <span class="step-num">!</span>
        <p class="step-body"><strong>Video editing and audio production</strong> — Bluetooth latency causes audible delay when monitoring recordings or editing audio to picture. For any production work, use wired headphones or wired monitors to avoid unreliable playback timing.</p>
      </div>
    </div>
  </div>

  <!-- RELATED TESTS -->
  <div class="how-section">
    <h2>Related audio tests</h2>
    <div class="steps">
      <div class="step">
        <span class="step-num">→</span>
        <p class="step-body"><a href="/latency-test/"><strong>Audio Latency Test</strong></a> — Measures system output delay for any audio device. Use as a baseline before and after changing your Bluetooth codec settings.</p>
      </div>
      <div class="step">
        <span class="step-num">→</span>
        <p class="step-body"><a href="/airpods-latency-test/"><strong>AirPods Latency Test</strong></a> — Specific latency measurement and guidance for all AirPods models, including the SCO codec issue during calls on Mac.</p>
      </div>
      <div class="step">
        <span class="step-num">→</span>
        <p class="step-body">Want to understand why some Bluetooth devices feel faster than others? Read our <a href="/bluetooth-codec-guide/"><strong>Bluetooth Codec Guide</strong></a> for a comparison of SBC, AAC, aptX, aptX Adaptive, and aptX Low Latency.</p>
      </div>
      <div class="step">
        <span class="step-num">→</span>
        <p class="step-body"><a href="/mic-test/"><strong>Mic Test</strong></a> — Check if your Bluetooth headset microphone is working correctly, with real-time waveform and level monitoring.</p>
      </div>
      <div class="step">
        <span class="step-num">→</span>
        <p class="step-body"><a href="/devices/"><strong>Bluetooth Device Guides</strong></a> — Exact latency by codec for Sony, Bose, Samsung, Google, and Apple headphones and earbuds.</p>
      </div>
    </div>
  </div>

</Layout>

<script>
  (() => {
    type Phase = 'idle' | 'measuring' | 'result' | 'rt-requesting' | 'rt-running' | 'rt-result';

    let phase: Phase = 'idle';
    let audioCtx: AudioContext | null = null;

    const btnMeasure   = document.getElementById('btn-measure') as HTMLButtonElement;
    const btnRoundtrip = document.getElementById('btn-roundtrip') as HTMLButtonElement;
    const statusDot    = document.getElementById('status-dot')!;
    const statusText   = document.getElementById('status-text')!;
    const phaseLabel   = document.getElementById('phase-label')!;
    const resultPanel  = document.getElementById('result-panel')!;
    const latencyNum   = document.getElementById('latency-num')!;
    const gradeBadge   = document.getElementById('grade-badge')!;
    const breakdown    = document.getElementById('latency-breakdown')!;
    const baseMs       = document.getElementById('base-ms')!;
    const outputMs     = document.getElementById('output-ms')!;
    const latencyAdvice = document.getElementById('latency-advice')!;
    const resultNote   = document.getElementById('result-note')!;

    function getCtx() {
      if (!audioCtx) audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
      return audioCtx;
    }

    function setStatus(active: boolean, warning: boolean, text: string) {
      statusText.textContent = text;
      statusDot.className = 'dot' + (active ? ' active' : warning ? ' warning' : '');
    }

    function grade(_ms: number): { label: string; cls: string; advice: string } {
      return {
        label: 'Browser-reported value',
        cls: 'grade-fair',
        advice: 'This value does not identify your Bluetooth codec or provide a universal latency grade. Results depend on your browser, operating system, device, and audio route.'
      };
    }

    function showResult(ms: number, label: string, baseVal?: number, outputVal?: number) {
      const g = grade(ms);
      latencyNum.textContent = ms < 1 ? '<1' : ms.toFixed(ms < 10 ? 1 : 0);
      gradeBadge.textContent = g.label;
      gradeBadge.className = 'grade-badge ' + g.cls;
      latencyAdvice.textContent = g.advice;
      phaseLabel.textContent = label;

      if (baseVal !== undefined && outputVal !== undefined) {
        baseMs.textContent = baseVal.toFixed(1);
        outputMs.textContent = outputVal.toFixed(1);
        breakdown.hidden = false;
      } else {
        breakdown.hidden = true;
      }

      resultPanel.hidden = false;
    }

    async function measureSystem() {
      phase = 'measuring';
      setStatus(true, false, 'Measuring Bluetooth latency…');
      btnMeasure.disabled = true;
      btnRoundtrip.disabled = true;
      resultNote.textContent = 'Initializing audio context…';

      const ctx = getCtx();
      if (ctx.state === 'suspended') await ctx.resume();

      const warmup = ctx.createBuffer(1, ctx.sampleRate * 0.1, ctx.sampleRate);
      const src = ctx.createBufferSource();
      src.buffer = warmup;
      src.connect(ctx.destination);
      src.start();

      await new Promise<void>(r => setTimeout(r, 150));

      const base   = (ctx.baseLatency   ?? 0) * 1000;
      const output = (ctx.outputLatency ?? 0) * 1000;
      const total  = base + output;

      phase = 'result';
      setStatus(false, false, 'Measurement complete');

      if (total < 0.5) {
        showResult(0, 'Bluetooth latency');
        resultNote.textContent = 'Your browser does not expose latency values. Use the Round-Trip Test for a direct measurement.';
        resultNote.className = 'result-note';
      } else {
        showResult(total, 'Bluetooth latency', base, output);
        resultNote.textContent = 'Browser-reported system latency. Confirm your Bluetooth device is the active output; compare results with the same setup.';
        resultNote.className = 'result-note success';
      }

      btnMeasure.textContent = 'Measure Again';
      btnMeasure.disabled = false;
      btnRoundtrip.disabled = false;
    }

    async function runRoundTrip() {
      phase = 'rt-requesting';
      setStatus(false, true, 'Requesting mic…');
      btnMeasure.disabled = true;
      btnRoundtrip.disabled = true;
      resultNote.textContent = 'Allow microphone access to run the round-trip test.';
      resultNote.className = 'result-note';

      let stream: MediaStream;
      try {
        stream = await navigator.mediaDevices.getUserMedia({
          audio: { echoCancellation: false, noiseSuppression: false, autoGainControl: false }
        });
      } catch {
        setStatus(false, false, 'Mic access denied');
        resultNote.textContent = 'Microphone access is required for the round-trip test.';
        resultNote.className = 'result-note error';
        btnMeasure.disabled = false;
        btnRoundtrip.disabled = false;
        phase = 'result';
        return;
      }

      phase = 'rt-running';
      setStatus(true, false, 'Running round-trip test…');
      resultNote.textContent = 'Keep your microphone near your Bluetooth speakers or headphones. Running test…';

      const ctx = getCtx();
      if (ctx.state === 'suspended') await ctx.resume();

      const micSrc  = ctx.createMediaStreamSource(stream);
      const analyser = ctx.createAnalyser();
      analyser.fftSize = 256;
      micSrc.connect(analyser);

      const baseline = await measureBaseline(analyser, 400);

      const clickDelay = 0.3;
      const clickAt = ctx.currentTime + clickDelay;
      playImpulse(ctx, clickAt, 0.85);
      const clickWallMs = Date.now() + clickDelay * 1000;

      const latencyMs = await detectImpulse(analyser, baseline, clickWallMs);

      stream.getTracks().forEach(t => t.stop());
      micSrc.disconnect();

      phase = 'rt-result';
      setStatus(false, false, 'Test complete');

      if (latencyMs === null) {
        resultNote.textContent = 'Could not detect the test click. Make sure your speakers are audible and try in a quieter environment.';
        resultNote.className = 'result-note error';
      } else {
        showResult(latencyMs, 'Round-trip latency');
        resultNote.textContent = 'Round-trip delay estimate detected from playback to microphone. Room acoustics and microphone placement can affect the result.';
        resultNote.className = 'result-note success';
      }

      btnMeasure.disabled = false;
      btnRoundtrip.disabled = false;
    }

    function measureBaseline(analyser: AnalyserNode, durationMs: number): Promise<number> {
      return new Promise(resolve => {
        const buf = new Uint8Array(analyser.frequencyBinCount);
        let sum = 0, count = 0;
        const start = Date.now();
        const tick = () => {
          analyser.getByteTimeDomainData(buf);
          let s = 0;
          for (let i = 0; i < buf.length; i++) s += ((buf[i] / 128) - 1) ** 2;
          sum += Math.sqrt(s / buf.length);
          count++;
          if (Date.now() - start < durationMs) requestAnimationFrame(tick);
          else resolve(count > 0 ? sum / count : 0);
        };
        tick();
      });
    }

    function playImpulse(ctx: AudioContext, when: number, gain: number) {
      const duration = 0.01;
      const buf = ctx.createBuffer(1, Math.floor(ctx.sampleRate * duration), ctx.sampleRate);
      const data = buf.getChannelData(0);
      for (let i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1);

      const gainNode = ctx.createGain();
      gainNode.gain.value = gain;
      gainNode.connect(ctx.destination);

      const src = ctx.createBufferSource();
      src.buffer = buf;
      src.connect(gainNode);
      src.start(when);
    }

    function detectImpulse(analyser: AnalyserNode, baseline: number, clickWallMs: number): Promise<number | null> {
      return new Promise(resolve => {
        const threshold = Math.max(baseline * 3.5, 0.05);
        const buf = new Uint8Array(analyser.frequencyBinCount);
        const giveUpAt = clickWallMs + 3000;

        const poll = () => {
          const now = Date.now();
          if (now > giveUpAt) { resolve(null); return; }

          analyser.getByteTimeDomainData(buf);
          let s = 0;
          for (let i = 0; i < buf.length; i++) s += ((buf[i] / 128) - 1) ** 2;
          const rms = Math.sqrt(s / buf.length);

          if (now >= clickWallMs && rms > threshold) {
            resolve(now - clickWallMs);
            return;
          }

          setTimeout(poll, 4);
        };

        const waitMs = Math.max(0, clickWallMs - Date.now() - 50);
        setTimeout(poll, waitMs);
      });
    }

    btnMeasure.addEventListener('click', measureSystem);
    btnRoundtrip.addEventListener('click', runRoundTrip);
  })();
</script>

