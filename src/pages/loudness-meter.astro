---
import Layout from '../layouts/Layout.astro';
import { buildToolAlternates } from '../lib/i18n';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Loudness Meter Online (LUFS Estimate)",
      "url": "https://onlineaudiotest.com/loudness-meter/",
      "description": "Free online loudness meter. Get a live LUFS-style loudness estimate from your microphone or system audio, directly in your browser.",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Any",
      "browserRequirements": "Requires getUserMedia API support",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "provider": { "@type": "Organization", "name": "OnlineAudioTest.com", "url": "https://onlineaudiotest.com" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://onlineaudiotest.com/" },
        { "@type": "ListItem", "position": 2, "name": "Loudness Meter", "item": "https://onlineaudiotest.com/loudness-meter/" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "Is this a broadcast-certified LUFS meter?", "acceptedAnswer": { "@type": "Answer", "text": "No. This tool applies a simplified approximation of the ITU-R BS.1770 K-weighting curve used in real LUFS meters, so readings are directionally accurate but not certified for broadcast delivery (EBU R128, ATSC A/85, or streaming platform loudness compliance). For those, use a dedicated DAW plugin or hardware meter." } },
        { "@type": "Question", "name": "What LUFS target should I aim for?", "acceptedAnswer": { "@type": "Answer", "text": "Common targets: Spotify and Apple Music normalize to around -14 LUFS integrated, YouTube to around -14 LUFS, and podcasts typically target -16 to -19 LUFS. Broadcast TV (EBU R128) targets -23 LUFS. Mixing louder than your platform's target usually just gets turned down on playback, so there's no benefit to exceeding it." } },
        { "@type": "Question", "name": "What is the difference between LUFS and dB?", "acceptedAnswer": { "@type": "Answer", "text": "Decibels (dB) measure raw signal amplitude with no regard for how loud a sound is perceived. LUFS (Loudness Units Full Scale) apply frequency weighting that approximates human hearing sensitivity, so two signals with the same peak dB can have very different perceived loudness (and different LUFS values) depending on their frequency content." } },
        { "@type": "Question", "name": "Can I measure a song or video file with this tool?", "acceptedAnswer": { "@type": "Answer", "text": "This version measures live microphone input. To measure a file, play it through your speakers with the mic active (less accurate, picks up room acoustics), or use a dedicated offline LUFS analyzer / DAW plugin for file-based measurement." } }
      ]
    }
  ]
};
---

<Layout
  title="Loudness Meter Online — Free LUFS Estimate"
  description="Free online loudness meter with a live LUFS-style estimate from your microphone. Check integrated loudness against Spotify, YouTube, and podcast targets."
  keywords="loudness meter online, lufs meter online, free lufs meter, online loudness meter, integrated loudness test, podcast loudness meter, lufs test online"
  canonical="https://onlineaudiotest.com/loudness-meter/"
  alternates={buildToolAlternates('/loudness-meter/', '/pt-br/medidor-de-volume/')}
  schema={schema}
  sidebar={true}
>
  <section class="tool-hero container">
    <h1>Loudness Meter</h1>
    <p>A live LUFS-style loudness estimate from your microphone, right in your browser.</p>
  </section>

  <div class="tool-card-wrap">
    <div class="tool-card">
      <div class="status-bar">
        <div class="status-pill"><span class="dot" id="lm-dot"></span><span id="lm-status">Ready</span></div>
      </div>

      <div class="dm-display">
        <span class="dm-num" id="lm-num">—</span>
        <span class="dm-unit">LUFS (estimate, integrated)</span>
      </div>

      <div class="dm-bar-track" role="progressbar" aria-label="Loudness meter">
        <div class="dm-bar-fill" id="lm-bar-fill"></div>
      </div>

      <div class="dm-stats">
        <div class="dm-stat"><span class="dm-stat-label">Momentary</span><span class="dm-stat-val" id="lm-momentary">—</span></div>
        <div class="dm-stat"><span class="dm-stat-label">Integrated</span><span class="dm-stat-val" id="lm-integrated">—</span></div>
        <div class="dm-stat"><span class="dm-stat-label">Peak</span><span class="dm-stat-val" id="lm-peak">—</span></div>
      </div>

      <div class="action-row">
        <button class="btn btn-primary btn-lg" id="lm-btn">Start Loudness Meter</button>
        <button class="btn btn-secondary" id="lm-reset" hidden>Reset</button>
      </div>

      <p class="fg-disclaimer">
        <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true" style="flex-shrink:0;margin-top:1px"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.3"/><line x1="8" y1="5" x2="8" y2="9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="8" cy="11.5" r="0.75" fill="currentColor"/></svg>
        Approximate K-weighted estimate, not a certified broadcast LUFS meter. See FAQ.
      </p>
    </div>
  </div>

  <div class="edu-section">
    <h2>What Is LUFS?</h2>
    <p>LUFS (Loudness Units relative to Full Scale) is a standardized loudness measurement (ITU-R BS.1770) that applies K-weighting - a frequency curve that approximates how the human ear perceives loudness - before measuring signal power. Unlike a raw dB/RMS meter, LUFS gives a much closer estimate of how loud something will actually sound to a listener, which is why every major streaming platform uses it for loudness normalization.</p>
    <h2>Streaming Platform Loudness Targets</h2>
    <table class="freq-table">
      <thead><tr><th>Platform</th><th>Target (Integrated LUFS)</th></tr></thead>
      <tbody>
        <tr><td>Spotify</td><td>≈ −14 LUFS</td></tr>
        <tr><td>Apple Music</td><td>≈ −16 LUFS</td></tr>
        <tr><td>YouTube</td><td>≈ −14 LUFS</td></tr>
        <tr><td>Podcasts (Apple guideline)</td><td>−16 to −19 LUFS</td></tr>
        <tr><td>Broadcast TV (EBU R128)</td><td>−23 LUFS</td></tr>
      </tbody>
    </table>
    <p>Mixing louder than a platform's target has no benefit — most platforms turn overly loud content down automatically on playback, so extra loudness just costs you dynamic range. Use this tool to get directionally close, then verify final masters with a dedicated LUFS plugin before release. For raw signal level, see the <a href="/decibel-meter/">decibel meter</a>.</p>
  </div>

  <div class="faq-section">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-item"><p class="faq-q">Is this a broadcast-certified LUFS meter?</p><p class="faq-a">No. It applies a simplified approximation of ITU-R BS.1770 K-weighting, so readings are directionally accurate but not certified for broadcast delivery. Use a DAW plugin or hardware meter for compliance work.</p></div>
    <div class="faq-item"><p class="faq-q">What LUFS target should I aim for?</p><p class="faq-a">Spotify and YouTube normalize around −14 LUFS, Apple Music around −16, podcasts −16 to −19, and broadcast TV −23. Mixing louder than your target platform gets turned down anyway.</p></div>
    <div class="faq-item"><p class="faq-q">What is the difference between LUFS and dB?</p><p class="faq-a">dB measures raw amplitude with no regard for perceived loudness. LUFS applies frequency weighting that approximates human hearing, so two signals with the same peak dB can have very different LUFS values depending on frequency content.</p></div>
    <div class="faq-item"><p class="faq-q">Can I measure a song or video file with this?</p><p class="faq-a">This measures live microphone input. To check a file, play it through your speakers with the mic active (less accurate — picks up room acoustics), or use a dedicated offline LUFS analyzer for file-based measurement.</p></div>
  </div>
</Layout>

<style>
  .dm-display { text-align: center; padding: var(--s-lg) 0; }
  .dm-num { font-size: 64px; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--ink); }
  .dm-unit { display: block; font-size: 13px; color: var(--muted); margin-top: 4px; }
  .dm-bar-track { height: 14px; border-radius: 7px; background: var(--surface-2, #ebebeb); overflow: hidden; margin: var(--s-md) 0; }
  .dm-bar-fill { height: 100%; width: 0%; background: #0070f3; transition: width .1s linear, background .15s; border-radius: 7px; }
  .dm-bar-fill.high { background: #f5a623; }
  .dm-bar-fill.clip { background: var(--error, #e5484d); }
  .dm-stats { display: flex; justify-content: space-between; gap: var(--s-sm); margin: var(--s-md) 0; }
  .dm-stat { flex: 1; text-align: center; padding: var(--s-sm); border: 1px solid var(--hairline); border-radius: 10px; }
  .dm-stat-label { display: block; font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
  .dm-stat-val { display: block; font-size: 18px; font-weight: 600; margin-top: 2px; font-variant-numeric: tabular-nums; }

  .edu-section { max-width: 680px; margin-inline: auto; padding: 0 var(--container-pad); margin-bottom: var(--s-3xl); }
  .edu-section h2 { font-size: 22px; font-weight: 600; letter-spacing: -0.8px; margin-bottom: var(--s-md); margin-top: var(--s-3xl); color: var(--ink); }
  .edu-section h2:first-child { margin-top: 0; }
  .edu-section p { font-size: 15px; color: var(--body-text); line-height: 1.75; margin-bottom: var(--s-md); }
  .edu-section strong { color: var(--ink); font-weight: 500; }
  .edu-section a { color: var(--link); text-decoration: underline; text-underline-offset: 2px; }
  .freq-table { width: 100%; border-collapse: collapse; margin-bottom: var(--s-lg); font-size: 14px; }
  .freq-table th { text-align: left; padding: var(--s-xs) var(--s-sm); border-bottom: 2px solid var(--hairline); font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: var(--mute); }
  .freq-table td { padding: var(--s-xs) var(--s-sm); border-bottom: 1px solid var(--hairline); color: var(--body-text); }
  .freq-table tr:last-child td { border-bottom: none; }
  .freq-table tbody tr:hover td { background: var(--canvas-soft); }
</style>

<script>
  (() => {
    const btn = document.getElementById('lm-btn') as HTMLButtonElement;
    const resetBtn = document.getElementById('lm-reset') as HTMLButtonElement;
    const dot = document.getElementById('lm-dot')!;
    const statusEl = document.getElementById('lm-status')!;
    const num = document.getElementById('lm-num')!;
    const barFill = document.getElementById('lm-bar-fill')!;
    const momentaryEl = document.getElementById('lm-momentary')!;
    const integratedEl = document.getElementById('lm-integrated')!;
    const peakEl = document.getElementById('lm-peak')!;

    let audioCtx: AudioContext | null = null;
    let analyser: AnalyserNode | null = null;
    let stream: MediaStream | null = null;
    let rafId = 0;
    let running = false;

    // Simplified BS.1770 K-weighting: high-shelf (~4dB @ ~1.5kHz) + high-pass (~38Hz)
    let shelf: BiquadFilterNode | null = null;
    let hpf: BiquadFilterNode | null = null;

    let integratedSumSq = 0, integratedCount = 0;
    let peakDb = -Infinity;
    const GATE_LUFS = -70;
    const K_OFFSET = -0.691; // ITU-R BS.1770 constant

    function fmt(v: number) { return v > -69 ? v.toFixed(1) + ' LUFS' : '−∞ LUFS'; }

    function resetStats() {
      integratedSumSq = 0; integratedCount = 0; peakDb = -Infinity;
      integratedEl.textContent = '—'; peakEl.textContent = '—';
    }

    function tick() {
      if (!analyser || !running) return;
      const buf = new Float32Array(analyser.fftSize);
      analyser.getFloatTimeDomainData(buf);
      let sumSq = 0, peakAbs = 0;
      for (let i = 0; i < buf.length; i++) {
        sumSq += buf[i] * buf[i];
        const a = Math.abs(buf[i]);
        if (a > peakAbs) peakAbs = a;
      }
      const meanSq = sumSq / buf.length;
      const momentary = K_OFFSET + 10 * Math.log10(Math.max(meanSq, 1e-12));
      const peakDbfs = 20 * Math.log10(Math.max(peakAbs, 1e-10));

      const clampedM = Math.max(-70, momentary);
      num.textContent = fmt(clampedM);
      momentaryEl.textContent = fmt(clampedM);
      const pct = Math.min(100, Math.max(0, (clampedM + 70) / 70 * 100));
      barFill.style.width = pct + '%';
      barFill.className = 'dm-bar-fill' + (clampedM > -9 ? ' clip' : clampedM > -18 ? ' high' : '');

      if (peakDbfs > peakDb) { peakDb = peakDbfs; peakEl.textContent = peakDb.toFixed(1) + ' dBFS'; }

      // Gated integration (simplified — absolute gate only, no relative gate)
      if (momentary > GATE_LUFS) {
        integratedSumSq += meanSq;
        integratedCount++;
        const integrated = K_OFFSET + 10 * Math.log10(integratedSumSq / integratedCount);
        integratedEl.textContent = fmt(integrated);
      }

      rafId = requestAnimationFrame(tick);
    }

    async function start() {
      btn.disabled = true;
      statusEl.textContent = 'Requesting mic access…';
      dot.className = 'dot warning';
      try {
        stream = await navigator.mediaDevices.getUserMedia({ audio: { echoCancellation: false, noiseSuppression: false, autoGainControl: false } });
      } catch {
        statusEl.textContent = 'Microphone permission denied';
        dot.className = 'dot error';
        btn.disabled = false;
        return;
      }
      audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
      const src = audioCtx.createMediaStreamSource(stream);

      shelf = audioCtx.createBiquadFilter();
      shelf.type = 'highshelf';
      shelf.frequency.value = 1500;
      shelf.gain.value = 4;

      hpf = audioCtx.createBiquadFilter();
      hpf.type = 'highpass';
      hpf.frequency.value = 38;

      analyser = audioCtx.createAnalyser();
      analyser.fftSize = 2048;

      src.connect(hpf).connect(shelf).connect(analyser);

      running = true;
      resetStats();
      dot.className = 'dot active';
      statusEl.textContent = 'Measuring…';
      btn.textContent = 'Stop';
      btn.disabled = false;
      resetBtn.hidden = false;
      tick();
    }

    function stop() {
      running = false;
      cancelAnimationFrame(rafId);
      stream?.getTracks().forEach(t => t.stop());
      audioCtx?.close();
      stream = null; audioCtx = null; analyser = null; shelf = null; hpf = null;
      dot.className = 'dot';
      statusEl.textContent = 'Ready';
      btn.textContent = 'Start Loudness Meter';
      num.textContent = '—';
      momentaryEl.textContent = '—';
      barFill.style.width = '0%';
    }

    btn.addEventListener('click', () => { running ? stop() : start(); });
    resetBtn.addEventListener('click', resetStats);
  })();
</script>
