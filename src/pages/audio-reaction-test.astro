---
import Layout from '../layouts/Layout.astro';
import { buildToolAlternates } from '../lib/i18n';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      "name": "Audio Reaction Time Test",
      "url": "https://onlineaudiotest.com/audio-reaction-test/",
      "description": "Try a five-round browser sound-reaction test. Results include device audio and input timing and are not a clinical or standardized benchmark.",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Any",
      "browserRequirements": "Requires Web Audio API support",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "provider": { "@type": "Organization", "name": "OnlineAudioTest.com", "url": "https://onlineaudiotest.com" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://onlineaudiotest.com/" },
        { "@type": "ListItem", "position": 2, "name": "Audio Reaction Test", "item": "https://onlineaudiotest.com/audio-reaction-test/" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "What is a good audio reaction time?", "acceptedAnswer": { "@type": "Answer", "text": "There is no universal cutoff for this browser test. Results vary with attention, practice, audio output scheduling, headphones or speakers, display refresh, and input-device timing. Use the score to compare your own attempts on the same setup, not as a clinical or standardized benchmark." } },
        { "@type": "Question", "name": "How does this test measure reaction time?", "acceptedAnswer": { "@type": "Answer", "text": "The page records a browser timestamp when it schedules a tone and another when you activate the response area. The difference includes browser and device timing as well as your response; it is not a measure of biological reaction time alone." } },
        { "@type": "Question", "name": "Why is my reaction time inconsistent between rounds?", "acceptedAnswer": { "@type": "Answer", "text": "Reaction time naturally varies round to round due to attention, fatigue, and anticipation. This is why the test runs 5 rounds and shows your average and best time rather than a single result - a single round is not a reliable measurement." } },
        { "@type": "Question", "name": "Does my audio setup affect the result?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Audio output, browser scheduling, display refresh, and input-device timing all affect the result. Wired audio may reduce one source of delay, but this browser test cannot isolate the human response from device timing." } }
      ]
    }
  ]
};
---

<Layout
  title="Audio Reaction Test — How Fast Do You React to Sound?"
  description="Try a five-round browser sound-reaction test. The score includes device audio and input timing; compare attempts on the same setup."
  keywords="audio reaction test, sound reaction time test, reaction time test online, hearing reaction test, how fast do you react to sound, audio reflex test"
  canonical="https://onlineaudiotest.com/audio-reaction-test/"
  alternates={buildToolAlternates('/audio-reaction-test/', '/pt-br/teste-de-reacao-audio/')}
  schema={schema}
  sidebar={true}
>
  <section class="tool-hero container">
    <h1>Audio Reaction Test</h1>
    <p>Listen for the tone, then click or press space as fast as you can. 5 rounds, no warning.</p>
  </section>

  <div class="tool-card-wrap">
    <div class="tool-card">
      <div class="status-bar">
        <div class="status-pill"><span class="dot" id="rt-dot"></span><span id="rt-status">Ready</span></div>
        <span class="eyebrow caption-mono" id="rt-round">Round 0 / 5</span>
      </div>

      <button id="rt-zone" class="rt-zone" aria-label="Reaction zone — click when you hear the tone">
        <span id="rt-zone-label">Press Start</span>
      </button>

      <div class="dm-stats" id="rt-stats" hidden>
        <div class="dm-stat"><span class="dm-stat-label">Last</span><span class="dm-stat-val" id="rt-last">—</span></div>
        <div class="dm-stat"><span class="dm-stat-label">Best</span><span class="dm-stat-val" id="rt-best">—</span></div>
        <div class="dm-stat"><span class="dm-stat-label">Average</span><span class="dm-stat-val" id="rt-avg">—</span></div>
      </div>

      <div class="action-row">
        <button class="btn btn-primary btn-lg" id="rt-start">Start Test</button>
      </div>

      <p class="fg-disclaimer">
        <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true" style="flex-shrink:0;margin-top:1px"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.3"/><line x1="8" y1="5" x2="8" y2="9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="8" cy="11.5" r="0.75" fill="currentColor"/></svg>
        The result includes browser and device audio/input timing as well as your response. Compare attempts on the same setup.
      </p>
    </div>
  </div>

  <div class="edu-section">
    <h2>What Is Audio Reaction Time?</h2>
    <p>This browser test measures the interval between scheduling a tone and receiving a click or key response. That interval includes human response time along with audio scheduling/output, display, and input-device timing, so it is not a clinical or standardized measure of reflexes.</p>
    <h2>How to compare attempts</h2>
    <p>There is no universal good or poor cutoff for this browser test. The measured interval includes response time plus browser scheduling, audio output, screen refresh, and input-device timing. Compare repeated attempts on the same setup rather than treating the score as a standardized reflex benchmark.</p>    <p>Wireless audio can add output delay before the tone reaches you. Wired audio may reduce that factor, but this page cannot subtract device timing from your response. For a fair personal comparison, use the same browser, audio setup, and input device each time.</p>
  </div>

  <div class="faq-section">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-item"><p class="faq-q">What is a good audio reaction time?</p><p class="faq-a">There is no universal cutoff for this browser test. Compare your attempts on the same device and setup; the result includes browser, audio output, display, input timing, attention, and practice.</p></div>
    <div class="faq-item"><p class="faq-q">How does this test measure reaction time?</p><p class="faq-a">It records a browser timestamp when the tone is scheduled and another when you respond. The difference includes device timing and is not biological reaction time alone.</p></div>
    <div class="faq-item"><p class="faq-q">Why is my reaction time inconsistent between rounds?</p><p class="faq-a">Reaction time naturally varies with attention, fatigue, and anticipation. That's why this test runs 5 rounds and reports your average and best time rather than a single result.</p></div>
    <div class="faq-item"><p class="faq-q">Does my audio setup affect the result?</p><p class="faq-a">Yes. Audio output, browser scheduling, display refresh, and input-device timing all affect the score. Wired audio may reduce one source of delay, but this page cannot isolate human response from device timing.</p></div>
  </div>
</Layout>

<style>
  .rt-zone { width: 100%; aspect-ratio: 3 / 1; border: 2px dashed var(--hairline); border-radius: 16px; background: var(--surface-2, #f5f5f5); display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 600; color: var(--muted); cursor: pointer; transition: background .12s, border-color .12s, color .12s; }
  .rt-zone.waiting { border-color: #f5a623; color: #f5a623; }
  .rt-zone.go { background: #0070f3; border-color: #0070f3; color: #fff; border-style: solid; }
  .rt-zone.early { background: var(--error, #e5484d); border-color: var(--error, #e5484d); color: #fff; border-style: solid; }
  .rt-zone.done { background: #22c55e; border-color: #22c55e; color: #fff; border-style: solid; }
  .dm-stats { display: flex; justify-content: space-between; gap: var(--s-sm); margin: var(--s-md) 0; }
  .dm-stat { flex: 1; text-align: center; padding: var(--s-sm); border: 1px solid var(--hairline); border-radius: 10px; }
  .dm-stat-label { display: block; font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
  .dm-stat-val { display: block; font-size: 18px; font-weight: 600; margin-top: 2px; font-variant-numeric: tabular-nums; }

  .edu-section { max-width: 680px; margin-inline: auto; padding: 0 var(--container-pad); margin-bottom: var(--s-3xl); }
  .edu-section h2 { font-size: 22px; font-weight: 600; letter-spacing: -0.8px; margin-bottom: var(--s-md); margin-top: var(--s-3xl); color: var(--ink); }
  .edu-section h2:first-child { margin-top: 0; }
  .edu-section p { font-size: 15px; color: var(--body-text); line-height: 1.75; margin-bottom: var(--s-md); }
  .edu-section strong { color: var(--ink); font-weight: 500; }
  .edu-section a { color: var(--link); text-decoration: underline; text-underline-offset: 2px; }
  .freq-table { width: 100%; border-collapse: collapse; margin-bottom: var(--s-lg); font-size: 14px; }
  .freq-table th { text-align: left; padding: var(--s-xs) var(--s-sm); border-bottom: 2px solid var(--hairline); font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: var(--mute); }
  .freq-table td { padding: var(--s-xs) var(--s-sm); border-bottom: 1px solid var(--hairline); color: var(--body-text); }
  .freq-table tr:last-child td { border-bottom: none; }
  .freq-table tbody tr:hover td { background: var(--canvas-soft); }
</style>

<script>
  (() => {
    const startBtn = document.getElementById('rt-start') as HTMLButtonElement;
    const zone = document.getElementById('rt-zone') as HTMLButtonElement;
    const zoneLabel = document.getElementById('rt-zone-label')!;
    const dot = document.getElementById('rt-dot')!;
    const statusEl = document.getElementById('rt-status')!;
    const roundEl = document.getElementById('rt-round')!;
    const statsWrap = document.getElementById('rt-stats')!;
    const lastEl = document.getElementById('rt-last')!;
    const bestEl = document.getElementById('rt-best')!;
    const avgEl = document.getElementById('rt-avg')!;

    const TOTAL_ROUNDS = 5;
    let round = 0;
    let phase: 'idle' | 'waiting' | 'go' | 'early' | 'done' = 'idle';
    let toneTime = 0;
    let timer: ReturnType<typeof setTimeout>;
    let results: number[] = [];
    let audioCtx: AudioContext | null = null;

    function beep() {
      audioCtx = audioCtx || new (window.AudioContext || (window as any).webkitAudioContext)();
      if (audioCtx.state === 'suspended') audioCtx.resume();
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      osc.type = 'sine';
      osc.frequency.value = 880;
      gain.gain.setValueAtTime(0.5, audioCtx.currentTime);
      gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.25);
      osc.connect(gain).connect(audioCtx.destination);
      osc.start();
      osc.stop(audioCtx.currentTime + 0.25);
    }

    function nextRound() {
      round++;
      roundEl.textContent = `Round ${round} / ${TOTAL_ROUNDS}`;
      phase = 'waiting';
      zone.className = 'rt-zone waiting';
      zoneLabel.textContent = 'Wait for it…';
      statusEl.textContent = 'Listening…';
      dot.className = 'dot warning';
      const delay = 1200 + Math.random() * 3000;
      timer = setTimeout(() => {
        phase = 'go';
        zone.className = 'rt-zone go';
        zoneLabel.textContent = 'GO — click now!';
        toneTime = performance.now();
        beep();
      }, delay);
    }

    function endRound(reactionMs: number | null, early: boolean) {
      clearTimeout(timer);
      if (early) {
        phase = 'early';
        zone.className = 'rt-zone early';
        zoneLabel.textContent = 'Too early — clicked before tone';
        statusEl.textContent = 'Too early';
        setTimeout(() => nextRound(), 1400);
        return;
      }
      if (reactionMs !== null) {
        results.push(reactionMs);
        lastEl.textContent = Math.round(reactionMs) + ' ms';
        const best = Math.min(...results);
        const avg = results.reduce((a, b) => a + b, 0) / results.length;
        bestEl.textContent = Math.round(best) + ' ms';
        avgEl.textContent = Math.round(avg) + ' ms';
      }
      if (round >= TOTAL_ROUNDS) {
        phase = 'done';
        zone.className = 'rt-zone done';
        zoneLabel.textContent = `Done! Average: ${Math.round(results.reduce((a, b) => a + b, 0) / results.length)} ms`;
        statusEl.textContent = 'Test complete';
        dot.className = 'dot';
        startBtn.textContent = 'Test Again';
        startBtn.disabled = false;
      } else {
        setTimeout(() => nextRound(), 900);
      }
    }

    zone.addEventListener('click', () => {
      if (phase === 'waiting') { endRound(null, true); return; }
      if (phase === 'go') { endRound(performance.now() - toneTime, false); return; }
    });

    document.addEventListener('keydown', (e) => {
      if (e.code !== 'Space') return;
      if (phase === 'waiting' || phase === 'go') { e.preventDefault(); zone.click(); }
    });

    startBtn.addEventListener('click', () => {
      round = 0;
      results = [];
      statsWrap.hidden = false;
      lastEl.textContent = '—'; bestEl.textContent = '—'; avgEl.textContent = '—';
      startBtn.disabled = true;
      nextRound();
    });
  })();
</script>
