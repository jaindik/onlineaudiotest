---
import Layout from '../layouts/Layout.astro';
import { buildToolAlternates } from '../lib/i18n';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Audio Latency Test — Bluetooth & AirPods Delay Checker",
      "url": "https://onlineaudiotest.com/latency-test/",
      "description": "Check audio delay with browser-reported output latency or estimate playback-to-microphone round-trip delay.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "Any",
      "browserRequirements": "Requires Web Audio API support",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "featureList": ["Audio latency test", "Bluetooth audio test", "AirPods latency test", "System output lag measurement", "Round-trip loopback test", "Output & base latency breakdown"],
      "provider": { "@type": "Organization", "name": "OnlineAudioTest.com", "url": "https://onlineaudiotest.com/" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://onlineaudiotest.com/" },
        { "@type": "ListItem", "position": 2, "name": "Audio Latency Test", "item": "https://onlineaudiotest.com/latency-test/" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "Why can Bluetooth audio feel delayed?", "acceptedAnswer": { "@type": "Answer", "text": "Bluetooth is one part of the audio path. Source and headphone buffering, operating-system processing, codec, radio conditions, and the playback app can all affect perceived delay. A codec name alone does not reveal end-to-end latency." } },
        { "@type": "Question", "name": "What does this browser latency test measure?", "acceptedAnswer": { "@type": "Answer", "text": "The browser test can show audio-context output latency values reported by the browser. Its microphone option estimates a playback-to-microphone round trip. Neither is a lab measurement at the listener's ear or an isolated Bluetooth codec measurement." } },
        { "@type": "Question", "name": "How is echo different from latency?", "acceptedAnswer": { "@type": "Answer", "text": "Echo is unwanted repeated audio, often caused when a microphone captures speaker sound. Latency is delay through an audio path. They are different issues and may need different troubleshooting." } },
        { "@type": "Question", "name": "How can I compare two audio setups?", "acceptedAnswer": { "@type": "Answer", "text": "Use the same browser, test mode, app, content, volume, and microphone placement, changing one part of the setup at a time. Treat the browser values as estimates and confirm sync in the app where you notice the issue." } }
      ]
    }
  ]
};
---

<Layout
  title="Audio Latency Test — Measure Bluetooth & Audio Delay in ms"
  description="Run an online audio latency test. See browser-reported output delay or use the microphone round-trip test to estimate acoustic delay."
  keywords="audio latency test, sound latency test, latency test audio, bluetooth audio test, audio delay test, bluetooth latency checker, audio lag test, wireless audio latency"
  schema={schema}
  alternates={buildToolAlternates('/latency-test/', '/pt-br/teste-de-latencia/')}
  sidebar={true}
>

  <!-- HERO -->
  <section class="tool-hero container">
    <h1>Audio Latency Test</h1>
    <p>Check audio delay in your browser. The first result uses latency values reported by your browser; the microphone round-trip test estimates the full path from playback to microphone and needs mic permission.</p>
  </section>

  <!-- TOOL -->
  <div class="tool-card-wrap">
    <div class="tool-card" id="latency-tool">

      <!-- Status -->
      <div class="status-bar">
        <div class="status-pill">
          <span class="dot" id="status-dot"></span>
          <span id="status-text">Ready to measure</span>
        </div>
        <span class="eyebrow caption-mono" id="phase-label"></span>
      </div>

      <!-- Result panel -->
      <div class="result-panel" id="result-panel" hidden>
        <div class="latency-display">
          <span class="latency-num" id="latency-num">-</span>
          <span class="latency-unit">ms</span>
        </div>
        <div class="grade-badge" id="grade-badge"></div>
        <div class="latency-breakdown" id="latency-breakdown" hidden>
          <span class="breakdown-item">Base <strong id="base-ms">-</strong> ms</span>
          <span class="breakdown-sep">·</span>
          <span class="breakdown-item">Output <strong id="output-ms">-</strong> ms</span>
        </div>
        <p class="latency-advice" id="latency-advice"></p>
      </div>

      <!-- Actions -->
      <div class="action-row">
        <button class="btn btn-primary btn-lg" id="btn-measure" style="min-width:200px">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.4"/>
            <path d="M7 4v3.2l2 1.3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Measure Latency
        </button>
        <button class="btn btn-secondary btn-sm" id="btn-roundtrip">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <rect x="4.5" y="1" width="3" height="6" rx="1.5" stroke="currentColor" stroke-width="1.3"/>
            <path d="M2.5 6a3.5 3.5 0 007 0" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
            <line x1="6" y1="9.5" x2="6" y2="11" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
          </svg>
          Round-Trip Test (mic)
        </button>
      </div>

      <p class="result-note" id="result-note">Measures your audio output delay. No microphone needed for the first test.</p>
    </div>
  </div>

  <!-- HOW IT WORKS -->
  <div class="how-section">
    <h2>How the latency test works</h2>
    <div class="steps">
      <div class="step">
        <span class="step-num">1</span>
        <p class="step-body"><strong>Click "Measure Latency"</strong> to read the audio context's reported base and output latency values. This is a browser and device estimate, not a direct acoustic measurement of sound reaching your ears.</p>
      </div>
      <div class="step">
        <span class="step-num">2</span>
        <p class="step-body"><strong>For a microphone round-trip estimate</strong>, click "Round-Trip Test" and allow microphone access. The tool plays a short sound and detects it at the mic. Room acoustics, speaker volume, microphone placement, and echo processing can affect this result.</p>
      </div>
      <div class="step">
        <span class="step-num">3</span>
        <p class="step-body"><strong>Compare results carefully.</strong> A browser-reported value is not directly comparable to an acoustic round-trip result or a lab measurement. Repeat the same test with one device or setting changed at a time; use wired audio as a practical comparison when investigating Bluetooth delay.</p>
      </div>
    </div>
  </div>

  <!-- BENCHMARK TABLE -->
  <div class="how-section">
    <h2>Audio latency by connection type</h2>
    <p class="section-intro">Connection type changes the audio path, but actual delay depends on the full setup, including buffering, software, drivers, and output hardware. This overview is qualitative, not a measured ranking of every device.</p>
    <div class="level-table-wrap">
      <table class="level-table">
        <thead>
          <tr>
            <th>Connection</th>
            <th>What can affect the result</th>
            <th>Practical check</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Wired (3.5mm / USB)</td>
            <td>Adapter, driver, system settings, and app buffering</td>
            <td>Compare the same output route and app</td>
          </tr>
          <tr>
            <td>2.4 GHz wireless (USB dongle)</td>
            <td>Dongle, headset, firmware, and mode</td>
            <td>Confirm the headset is using its dongle mode</td>
          </tr>
          <tr>
            <td>Bluetooth aptX LL / LC3</td>
            <td>Codec support and the complete source-to-headphone path</td>
            <td>Check the exact codec support at both ends</td>
          </tr>
          <tr>
            <td>Bluetooth AAC / aptX</td>
            <td>Device implementation, buffering, and app processing</td>
            <td>Test in the app where timing matters</td>
          </tr>
          <tr>
            <td>Bluetooth SBC</td>
            <td>Device implementation, buffering, and app processing</td>
            <td>Do not infer a numeric delay from the codec name</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- WHAT CAUSES LATENCY -->
  <div class="how-section">
    <h2>What causes audio latency?</h2>
    <div class="steps">
      <div class="step">
        <span class="step-num">1</span>
        <p class="step-body"><strong>Audio generation</strong> — Your software or app produces an audio signal. This is near-instantaneous but requires the processor to complete the current task first, adding a small variable delay that increases under CPU load.</p>
      </div>
      <div class="step">
        <span class="step-num">2</span>
        <p class="step-body"><strong>Buffering</strong> — Audio systems collect samples into chunks (buffers) before sending them to the output. Larger buffers reduce the risk of glitches but increase latency. Buffer size is adjustable in professional audio software and is often the most impactful setting to tune.</p>
      </div>
      <div class="step">
        <span class="step-num">3</span>
        <p class="step-body"><strong>Processing</strong> — Codecs, software effects, mixing, and digital signal processing contribute to delay. Their effect depends on the implementation and buffering; a more complex codec does not by itself predict end-to-end latency.</p>
      </div>
      <div class="step">
        <span class="step-num">4</span>
        <p class="step-body"><strong>Transmission</strong> — Wireless transmission and buffering can add delay. Radio conditions and the source, receiver, and app implementation affect the total; this browser test cannot isolate the transmission portion.</p>
      </div>
      <div class="step">
        <span class="step-num">5</span>
        <p class="step-body"><strong>Playback hardware</strong> — The audio driver and output hardware add delay. The Web Audio API can expose an output-latency estimate, but the value may not include every part of the Bluetooth path and is not a direct measurement at the listener's ear.</p>
      </div>
    </div>
  </div>

  <!-- WIRED VS BLUETOOTH -->
  <div class="how-section">
    <h2>Wired vs Bluetooth audio latency</h2>
    <div class="steps">
      <div class="step">
        <span class="step-num">1</span>
        <p class="step-body"><strong>Wired audio</strong> — A cable removes the Bluetooth radio link, but audio drivers, buffers, and output hardware still contribute delay. Wired audio can be a useful comparison when troubleshooting. Best for: competitive gaming, music production, live vocal monitoring, and video editing where timing precision matters.</p>
      </div>
      <div class="step">
        <span class="step-num">2</span>
        <p class="step-body"><strong>Bluetooth audio</strong> — Audio travels through encoding, wireless transmission, buffering, decoding, and device or operating-system processing. Codec choice can affect delay, but it does not determine total end-to-end latency by itself. The complete result depends on the source, headphones, software, settings, and measurement method. <a href="/bluetooth-codec-guide/">Bluetooth codec guide: SBC, AAC, aptX, LDAC, LC3 explained →</a></p>
      </div>
      <div class="step">
        <span class="step-num">3</span>
        <p class="step-body"><strong>2.4 GHz wireless</strong> — Many gaming headsets use a proprietary 2.4 GHz USB dongle instead of standard Bluetooth. This is a different radio technology with lower overhead, typically achieving latency much closer to wired. If your headset came with a USB dongle, it likely uses 2.4 GHz rather than standard Bluetooth.</p>
      </div>
    </div>
  </div>

  <div class="faq-section">
    <h2>Frequently asked questions</h2>
    <div class="faq-item"><p class="faq-q">Why can Bluetooth audio feel delayed?</p><p class="faq-a">Bluetooth is one part of the audio path. Source and headphone buffering, operating-system processing, codec, radio conditions, and the playback app can all affect perceived delay. A codec name alone does not tell you end-to-end latency.</p></div>
    <div class="faq-item"><p class="faq-q">What does this browser latency test measure?</p><p class="faq-a">The browser test can show audio-context output latency reported by your browser. Its microphone option estimates a playback-to-microphone round trip. Neither is a lab measurement at your ear or an isolated Bluetooth codec measurement.</p></div>
    <div class="faq-item"><p class="faq-q">How is echo different from latency?</p><p class="faq-a">Echo is unwanted repeated audio, often caused when a microphone captures speaker sound. Latency is delay through an audio path. They are different issues and may need different troubleshooting.</p></div>
    <div class="faq-item"><p class="faq-q">How can I compare two audio setups?</p><p class="faq-a">Use the same browser, test mode, app, content, volume, and microphone placement, changing one part of the setup at a time. Treat browser values as estimates and confirm sync in the app where you notice the issue.</p></div>
  </div>
</Layout>

<script>
  (() => {
    type Phase = 'idle' | 'measuring' | 'result' | 'rt-requesting' | 'rt-running' | 'rt-result';

    let phase: Phase = 'idle';
    let audioCtx: AudioContext | null = null;

    const btnMeasure   = document.getElementById('btn-measure') as HTMLButtonElement;
    const btnRoundtrip = document.getElementById('btn-roundtrip') as HTMLButtonElement;
    const statusDot    = document.getElementById('status-dot')!;
    const statusText   = document.getElementById('status-text')!;
    const phaseLabel   = document.getElementById('phase-label')!;
    const resultPanel  = document.getElementById('result-panel')!;
    const latencyNum   = document.getElementById('latency-num')!;
    const gradeBadge   = document.getElementById('grade-badge')!;
    const breakdown    = document.getElementById('latency-breakdown')!;
    const baseMs       = document.getElementById('base-ms')!;
    const outputMs     = document.getElementById('output-ms')!;
    const latencyAdvice = document.getElementById('latency-advice')!;
    const resultNote   = document.getElementById('result-note')!;

    function getCtx() {
      if (!audioCtx) audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
      return audioCtx;
    }

    function setStatus(active: boolean, warning: boolean, text: string) {
      statusText.textContent = text;
      statusDot.className = 'dot' + (active ? ' active' : warning ? ' warning' : '');
    }

    function grade(ms: number): { label: string; cls: string; advice: string } {
      return {
        label: 'Browser-reported value',
        cls: 'grade-fair',
        advice: 'This value does not identify a Bluetooth codec or provide a universal latency grade. Results depend on your browser, operating system, audio device, and route.'
      };
    }

    function showResult(ms: number, label: string, baseVal?: number, outputVal?: number) {
      const g = grade(ms);
      latencyNum.textContent = ms < 1 ? '<1' : ms.toFixed(ms < 10 ? 1 : 0);
      gradeBadge.textContent = g.label;
      gradeBadge.className = 'grade-badge ' + g.cls;
      latencyAdvice.textContent = g.advice;
      phaseLabel.textContent = label;

      if (baseVal !== undefined && outputVal !== undefined) {
        baseMs.textContent = baseVal.toFixed(1);
        outputMs.textContent = outputVal.toFixed(1);
        breakdown.hidden = false;
      } else {
        breakdown.hidden = true;
      }

      resultPanel.hidden = false;
    }

    async function measureSystem() {
      phase = 'measuring';
      setStatus(true, false, 'Measuring…');
      btnMeasure.disabled = true;
      btnRoundtrip.disabled = true;
      resultNote.textContent = 'Initializing audio context…';

      const ctx = getCtx();
      if (ctx.state === 'suspended') await ctx.resume();

      // Play a silent buffer to warm up the context and get accurate latency values
      const warmup = ctx.createBuffer(1, ctx.sampleRate * 0.1, ctx.sampleRate);
      const src = ctx.createBufferSource();
      src.buffer = warmup;
      src.connect(ctx.destination);
      src.start();

      await new Promise<void>(r => setTimeout(r, 150));

      const base   = (ctx.baseLatency   ?? 0) * 1000;
      const output = (ctx.outputLatency ?? 0) * 1000;
      const total  = base + output;

      phase = 'result';
      setStatus(false, false, 'Measurement complete');

      if (total < 0.5) {
        // Browser doesn't expose latency values (e.g. Safari)
        showResult(0, 'System latency');
        resultNote.textContent = 'Your browser does not expose latency values. Use the Round-Trip Test for a measurement.';
        resultNote.className = 'result-note';
      } else {
        showResult(total, 'System latency', base, output);
        resultNote.textContent = 'Browser-reported system latency. Run the round-trip test to estimate playback-to-microphone delay.';
        resultNote.className = 'result-note success';
      }

      btnMeasure.textContent = 'Measure Again';
      btnMeasure.disabled = false;
      btnRoundtrip.disabled = false;
    }

    async function runRoundTrip() {
      phase = 'rt-requesting';
      setStatus(false, true, 'Requesting mic…');
      btnMeasure.disabled = true;
      btnRoundtrip.disabled = true;
      resultNote.textContent = 'Allow microphone access to run the round-trip test.';
      resultNote.className = 'result-note';

      let stream: MediaStream;
      try {
        stream = await navigator.mediaDevices.getUserMedia({
          audio: { echoCancellation: false, noiseSuppression: false, autoGainControl: false }
        });
      } catch {
        setStatus(false, false, 'Mic access denied');
        resultNote.textContent = 'Microphone access is required for the round-trip test.';
        resultNote.className = 'result-note error';
        btnMeasure.disabled = false;
        btnRoundtrip.disabled = false;
        phase = 'result';
        return;
      }

      phase = 'rt-running';
      setStatus(true, false, 'Running round-trip test…');
      resultNote.textContent = 'Keep your microphone near your speakers or headphone mic. Running test…';

      const ctx = getCtx();
      if (ctx.state === 'suspended') await ctx.resume();

      const micSrc  = ctx.createMediaStreamSource(stream);
      const analyser = ctx.createAnalyser();
      analyser.fftSize = 256;
      micSrc.connect(analyser);

      // Measure baseline RMS over 400ms
      const baseline = await measureBaseline(analyser, 400);

      // Play 10ms white noise burst - loud enough to detect over ambient noise
      const clickDelay = 0.3;
      const clickAt = ctx.currentTime + clickDelay;
      playImpulse(ctx, clickAt, 0.85);
      const clickWallMs = Date.now() + clickDelay * 1000;

      // Poll until we detect the impulse in the mic
      const latencyMs = await detectImpulse(analyser, baseline, clickWallMs);

      stream.getTracks().forEach(t => t.stop());
      micSrc.disconnect();

      phase = 'rt-result';
      setStatus(false, false, 'Test complete');

      if (latencyMs === null) {
        resultNote.textContent = 'Could not detect the test click. Make sure your speakers are audible and try again in a quieter environment.';
        resultNote.className = 'result-note error';
      } else {
        showResult(latencyMs, 'Round-trip latency');
        resultNote.textContent = 'Round-trip delay estimate detected from playback to microphone. Room acoustics and microphone placement can affect the result.';
        resultNote.className = 'result-note success';
      }

      btnMeasure.disabled = false;
      btnRoundtrip.disabled = false;
    }

    function measureBaseline(analyser: AnalyserNode, durationMs: number): Promise<number> {
      return new Promise(resolve => {
        const buf = new Uint8Array(analyser.frequencyBinCount);
        let sum = 0, count = 0;
        const start = Date.now();
        const tick = () => {
          analyser.getByteTimeDomainData(buf);
          let s = 0;
          for (let i = 0; i < buf.length; i++) s += ((buf[i] / 128) - 1) ** 2;
          sum += Math.sqrt(s / buf.length);
          count++;
          if (Date.now() - start < durationMs) requestAnimationFrame(tick);
          else resolve(count > 0 ? sum / count : 0);
        };
        tick();
      });
    }

    function playImpulse(ctx: AudioContext, when: number, gain: number) {
      const duration = 0.01; // 10ms
      const buf = ctx.createBuffer(1, Math.floor(ctx.sampleRate * duration), ctx.sampleRate);
      const data = buf.getChannelData(0);
      for (let i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1);

      const gainNode = ctx.createGain();
      gainNode.gain.value = gain;
      gainNode.connect(ctx.destination);

      const src = ctx.createBufferSource();
      src.buffer = buf;
      src.connect(gainNode);
      src.start(when);
    }

    function detectImpulse(analyser: AnalyserNode, baseline: number, clickWallMs: number): Promise<number | null> {
      return new Promise(resolve => {
        const threshold = Math.max(baseline * 3.5, 0.05);
        const buf = new Uint8Array(analyser.frequencyBinCount);
        const giveUpAt = clickWallMs + 3000;

        const poll = () => {
          const now = Date.now();
          if (now > giveUpAt) { resolve(null); return; }

          analyser.getByteTimeDomainData(buf);
          let s = 0;
          for (let i = 0; i < buf.length; i++) s += ((buf[i] / 128) - 1) ** 2;
          const rms = Math.sqrt(s / buf.length);

          if (now >= clickWallMs && rms > threshold) {
            resolve(now - clickWallMs);
            return;
          }

          setTimeout(poll, 4);
        };

        // Start polling 50ms before the click is due
        const waitMs = Math.max(0, clickWallMs - Date.now() - 50);
        setTimeout(poll, waitMs);
      });
    }

    btnMeasure.addEventListener('click', measureSystem);
    btnRoundtrip.addEventListener('click', runRoundTrip);
  })();
</script>

<style>
  .result-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-sm);
    padding: var(--s-lg) 0;
  }

  .latency-display {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .latency-num {
    font-family: var(--font-mono);
    font-size: 64px;
    font-weight: 700;
    line-height: 1;
    color: var(--ink);
    letter-spacing: -2px;
  }
  .latency-unit {
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 500;
    color: var(--mute);
  }

  .grade-badge {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .04em;
    text-transform: uppercase;
    padding: 3px 12px;
    border-radius: var(--r-full);
  }
  .grade-excellent { background: var(--grade-excellent-bg); color: var(--grade-excellent-fg); }
  .grade-good      { background: var(--grade-good-bg); color: var(--grade-good-fg); }
  .grade-fair      { background: var(--grade-fair-bg); color: var(--grade-fair-fg); }
  .grade-poor      { background: var(--grade-poor-bg); color: var(--grade-poor-fg); }

  .latency-breakdown {
    display: flex;
    align-items: center;
    gap: var(--s-sm);
    font-size: 12px;
    color: var(--mute);
    font-family: var(--font-mono);
  }
  .breakdown-item strong { color: var(--ink); }
  .breakdown-sep { color: var(--hairline-strong); }

  .latency-advice {
    font-size: 13px;
    color: var(--body-text);
    text-align: center;
    max-width: 420px;
    line-height: 1.6;
    margin: 0;
  }

  .section-intro {
    font-size: 14px;
    color: var(--body-text);
    line-height: 1.6;
    margin: 0 0 var(--s-md);
  }

  .level-table-wrap { overflow-x: auto; }

  .level-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    line-height: 1.5;
  }

  .level-table th {
    text-align: left;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--mute);
    padding: var(--s-xs) var(--s-sm);
    border-bottom: 1px solid var(--hairline);
  }

  .level-table td {
    padding: var(--s-xs) var(--s-sm);
    border-bottom: 1px solid var(--hairline);
    color: var(--body-text);
    vertical-align: top;
  }

  .level-table td:first-child {
    font-weight: 500;
    color: var(--ink);
    white-space: nowrap;
  }

  .level-table tbody tr:last-child td { border-bottom: none; }
</style>
