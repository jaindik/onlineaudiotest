---
import Layout from '../../layouts/Layout.astro';
import { DEVICES, getDeviceBySlug, getAllSlugs } from '../../data/devices';
import { CODECS } from '../../data/codecs';
import { buildDevicePageSchema, generateDeviceKeywords } from '../../lib/seo';
import { getRelatedDevices, getSameManufacturerDevices, getRelatedResources, categoryLabel } from '../../lib/related';
import { buildDeviceAlternates } from '../../lib/i18n';

export function getStaticPaths() {
  return getAllSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const device = getDeviceBySlug(slug!);
if (!device) return Astro.redirect('/404/');

const schema = buildDevicePageSchema(device);
const keywords = generateDeviceKeywords(device);
const relatedDevices = getRelatedDevices(device.slug);
const sameManufacturer = getSameManufacturerDevices(device.slug);
const relatedResources = getRelatedResources(device);

const canonicalURL = `https://onlineaudiotest.com/devices/${device.slug}/`;
const catLabel = categoryLabel(device.category);
---

<Layout
  title={`${device.name} Codec Support & Compatibility Guide`}
  description={`Codec support and platform compatibility notes for ${device.name}. Actual audio delay varies by device, software, and test method.`}
  keywords={keywords}
  canonical={canonicalURL}
  alternates={buildDeviceAlternates(device.slug)}
  schema={schema}
  sidebar={true}
>

  <!-- ── HERO ── -->
  <section class="tool-hero container">
    <p class="eyebrow" style="margin-bottom:var(--s-sm)">{device.manufacturer} · {catLabel}</p>
    <h1>{device.name} Codec Support</h1>
    <p>This reference does not independently verify the current codec specifications for this model. Check the manufacturer’s current documentation for the exact model and region. Codec availability also depends on the connected source and operating system.</p>
  </section>

  <!-- ── QUICK STATS STRIP ── -->
  <div class="device-stats-wrap container">
    <div class="device-stats">
      <div class="stat-cell">
        <span class="stat-label">Specification status</span>
        <span class="stat-value">Verify with manufacturer</span>
      </div>
      <div class="stat-divider" aria-hidden="true"></div>
      <div class="stat-cell">
        <span class="stat-label">Latency data</span>
        <span class="stat-value">No controlled model result</span>
      </div>
      <div class="stat-divider" aria-hidden="true"></div>
      <div class="stat-cell">
        <span class="stat-label">Test note</span>
        <span class="stat-value">Depends on paired setup</span>
      </div>
    </div>
  </div>

  <!-- ── TEST CTA ── -->
  <div class="device-cta-wrap container">
    <div class="device-cta-card">
      <div class="device-cta-text">
        <strong>Check audio output timing on your setup</strong>
        <p>Connect your {device.name} and run the browser test. It reports browser-provided timing where available; it cannot isolate or certify this headphone model's end-to-end Bluetooth delay.</p>
      </div>
      <a href="/latency-test/" class="btn btn-primary btn-lg device-cta-btn">
        <svg width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.5"/>
          <path d="M10 6v4.5l2.5 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        Run Latency Test
      </a>
    </div>
  </div>

  <section class="device-section container">
    <h2>How to verify codec compatibility</h2>
    <p class="section-intro">We have not verified the current codec list for this exact model against its manufacturer documentation, so this page does not guess which codecs it supports. Check the product specifications and your source device documentation. A codec must be supported at both ends, and the operating system, settings, app, and region can affect the active mode.</p>
    <p>For a general overview, read the <a href="/bluetooth-codec-guide/">Bluetooth audio codec guide</a>. For a timing check on your own setup, use the <a href="/latency-test/">browser audio latency test</a>; its output is not a model-specific Bluetooth measurement.</p>
  </section>

  <section class="device-section container">
    <h2>Check audio timing in your own setup</h2>
    <p>Bluetooth audio delay depends on the source, operating system, selected codec, app, buffers, and connection conditions. Video apps may synchronize audio and video differently from games or live monitoring. If timing matters for your task, check it in the app and setup you actually use.</p>
    <p><a href="/bluetooth-latency-test/">Read the Bluetooth latency guide</a> for measurement limits, or <a href="/airpods-latency-test/">read the AirPods guide</a> for Apple-specific setup context.</p>
  </section>

  <section class="device-section container">
    <h2>Bluetooth troubleshooting steps</h2>
    <ol class="troubleshoot-list">
      <li>Confirm the headphones are connected to the intended source and selected as the output.</li>
      <li>Check battery, distance, and connection stability; then reconnect and retry.</li>
      <li>Check the source device’s Bluetooth settings for the active codec or a low-latency mode, when available.</li>
      <li>For app-specific lip sync, use that app’s audio delay controls if it provides them.</li>
    </ol>
    <p>Button names and available settings vary by manufacturer, operating system, and model. Use the current product manual for model-specific instructions.</p>
  </section>

  <!-- ── RELATED DEVICES ── -->
  {relatedDevices.length > 0 && (
    <section class="device-section container">
      <h2>Compare Similar Devices</h2>
      <div class="related-devices-grid">
        {relatedDevices.map((rel) => {
          return (
            <a href={`/devices/${rel.slug}/`} class="related-device-card">
              <div class="related-device-header">
                <span class="related-manufacturer">{rel.manufacturer}</span>
              </div>
              <strong class="related-device-name">{rel.name}</strong>
              <p class="related-device-meta">{categoryLabel(rel.category)} · Codec details require manufacturer verification</p>
              <span class="related-cta">View latency guide →</span>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <!-- ── SAME MANUFACTURER ── -->
  {sameManufacturer.length > 0 && (
    <section class="device-section container">
      <h2>Other {device.manufacturer} Devices</h2>
      <div class="same-mfr-list">
        {sameManufacturer.map((rel) => (
          <a href={`/devices/${rel.slug}/`} class="same-mfr-item">
            <span>{rel.name}</span>
            <span class="same-mfr-meta">{categoryLabel(rel.category)} · See official codec specifications</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- ── RELATED RESOURCES ── -->
  <section class="device-section container">
    <h2>Related Tools & Guides</h2>
    <div class="resources-grid">
      {relatedResources.map((res) => (
        <a href={res.href} class="resource-card">
          <strong>{res.title}</strong>
          <p>{res.desc}</p>
        </a>
      ))}
    </div>
  </section>

</Layout>

<style>
  /* ── Stats strip ── */
  .device-stats-wrap {
    margin-bottom: var(--s-xl);
  }
  .device-stats {
    display: flex;
    align-items: stretch;
    background: var(--canvas);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-3);
    overflow: hidden;
    flex-wrap: wrap;
  }
  .stat-cell {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--s-md) var(--s-lg);
    flex: 1;
    min-width: 120px;
  }
  .stat-divider {
    width: 1px;
    background: var(--hairline);
    flex-shrink: 0;
  }
  .stat-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--mute);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .stat-value {
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
  }
  .grade-good { color: var(--grade-good-fg); }
  .grade-fair { color: var(--grade-fair-fg); }
  .grade-excellent { color: var(--grade-excellent-fg); }
  .grade-poor { color: var(--grade-poor-fg); }

  /* ── CTA card ── */
  .device-cta-wrap {
    margin-bottom: var(--s-3xl);
  }
  .device-cta-card {
    background: var(--canvas);
    border-radius: var(--r-lg);
    padding: var(--s-xl);
    box-shadow: var(--shadow-3);
    display: flex;
    align-items: center;
    gap: var(--s-xl);
    flex-wrap: wrap;
  }
  .device-cta-text {
    flex: 1;
    min-width: 200px;
  }
  .device-cta-text strong {
    display: block;
    font-size: 16px;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: var(--s-xs);
  }
  .device-cta-text p {
    font-size: 14px;
    color: var(--body-text);
    line-height: 1.6;
  }
  .device-cta-btn {
    flex-shrink: 0;
  }

  /* ── Section commons ── */
  .device-section {
    margin-bottom: var(--s-3xl);
  }
  .device-section h2 {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.7px;
    color: var(--ink);
    margin-bottom: var(--s-md);
  }
  .section-intro {
    font-size: 15px;
    color: var(--body-text);
    line-height: 1.7;
    margin-bottom: var(--s-lg);
    max-width: 680px;
  }

  /* ── Codec table ── */
  .codec-table-wrap {
    overflow-x: auto;
    border-radius: var(--r-md);
    box-shadow: var(--shadow-2);
    margin-bottom: var(--s-md);
  }
  .codec-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--canvas);
    font-size: 14px;
  }
  .codec-table thead {
    background: var(--canvas-soft-2);
  }
  .codec-table th {
    text-align: left;
    padding: var(--s-sm) var(--s-md);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--mute);
    border-bottom: 1px solid var(--hairline);
    white-space: nowrap;
  }
  .codec-table td {
    padding: var(--s-sm) var(--s-md);
    border-bottom: 1px solid var(--hairline);
    color: var(--body-text);
    vertical-align: middle;
  }
  .codec-table tbody tr:last-child td {
    border-bottom: none;
  }
  .codec-table .row-recommended {
    background: var(--success-bg);
  }
  .codec-name {
    font-weight: 500;
    color: var(--ink);
  }
  .recommended-badge {
    display: inline-block;
    margin-left: var(--s-xs);
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--success-fg);
    background: var(--success-bg);
    border: 1px solid var(--success-border);
    border-radius: var(--r-full);
    padding: 1px 6px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .latency-chip {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    border-radius: var(--r-full);
    padding: 2px 8px;
  }
  .latency-chip.grade-excellent { background: var(--grade-excellent-bg); color: var(--grade-excellent-fg); }
  .latency-chip.grade-good      { background: var(--grade-good-bg);      color: var(--grade-good-fg); }
  .latency-chip.grade-fair      { background: var(--grade-fair-bg);      color: var(--grade-fair-fg); }
  .latency-chip.grade-poor      { background: var(--grade-poor-bg);      color: var(--grade-poor-fg); }
  .note-col { font-size: 13px; max-width: 200px; }
  .platform-col { font-size: 13px; white-space: nowrap; }

  .codec-notes {
    display: flex;
    flex-direction: column;
    gap: var(--s-xs);
  }
  .codec-note {
    font-size: 13px;
    color: var(--body-text);
    line-height: 1.6;
    padding-left: var(--s-sm);
    border-left: 2px solid var(--hairline);
  }
  .codec-note strong { color: var(--ink); }

  /* ── Use case grid ── */
  .use-case-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--s-md);
  }
  .use-case-card {
    background: var(--canvas);
    border-radius: var(--r-lg);
    padding: var(--s-lg);
    box-shadow: var(--shadow-2);
    display: flex;
    flex-direction: column;
    gap: var(--s-sm);
  }
  .use-case-header {
    display: flex;
    align-items: center;
    gap: var(--s-sm);
    flex-wrap: wrap;
  }
  .use-case-header h3 {
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
    flex: 1;
  }
  .use-case-header svg { color: var(--mute); flex-shrink: 0; }
  .use-case-badge {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: var(--r-full);
    padding: 2px 8px;
  }
  .badge-pass { background: var(--grade-good-bg); color: var(--grade-good-fg); }
  .badge-fail { background: var(--grade-fair-bg); color: var(--grade-fair-fg); }
  .badge-warn { background: var(--grade-fair-bg); color: var(--grade-fair-fg); }
  .use-case-card p {
    font-size: 14px;
    color: var(--body-text);
    line-height: 1.65;
  }
  .use-case-link {
    font-size: 13px;
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 2px;
    margin-top: auto;
  }
  .use-case-meta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--mute);
  }
  .gaming-mode-note {
    font-size: 13px;
    color: var(--body-text);
    background: var(--grade-good-bg);
    color: var(--grade-good-fg);
    border-radius: var(--r-sm);
    padding: var(--s-xs) var(--s-sm);
  }

  /* ── Troubleshooting ── */
  .troubleshoot-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .troubleshoot-item {
    padding: var(--s-lg) 0;
    border-top: 1px solid var(--hairline);
  }
  .troubleshoot-item:last-child { border-bottom: 1px solid var(--hairline); }
  .troubleshoot-issue {
    display: flex;
    align-items: baseline;
    gap: var(--s-sm);
    margin-bottom: var(--s-sm);
  }
  .troubleshoot-num {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--mute);
    flex-shrink: 0;
  }
  .troubleshoot-issue strong {
    font-size: 15px;
    font-weight: 500;
    color: var(--ink);
  }
  .troubleshoot-fix {
    font-size: 14px;
    color: var(--body-text);
    line-height: 1.65;
    padding-left: calc(var(--s-sm) + 24px);
  }

  /* ── Related devices ── */
  .related-devices-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--s-md);
  }
  .related-device-card {
    display: flex;
    flex-direction: column;
    gap: var(--s-xs);
    background: var(--canvas);
    border-radius: var(--r-lg);
    padding: var(--s-lg);
    box-shadow: var(--shadow-2);
    text-decoration: none;
    transition: box-shadow .15s, transform .1s;
    color: inherit;
  }
  .related-device-card:hover {
    box-shadow: var(--shadow-4);
    transform: translateY(-1px);
  }
  .related-device-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-xs);
  }
  .related-manufacturer {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--mute);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .related-device-name {
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
  }
  .related-device-meta {
    font-size: 13px;
    color: var(--mute);
  }
  .related-cta {
    font-size: 13px;
    color: var(--link);
    margin-top: auto;
  }

  /* ── Same manufacturer ── */
  .same-mfr-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .same-mfr-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-md);
    padding: var(--s-md) 0;
    border-top: 1px solid var(--hairline);
    text-decoration: none;
    color: var(--ink);
    font-size: 15px;
    font-weight: 500;
    transition: color .15s;
  }
  .same-mfr-item:last-child { border-bottom: 1px solid var(--hairline); }
  .same-mfr-item:hover { color: var(--link); }
  .same-mfr-meta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--mute);
    font-weight: 400;
    white-space: nowrap;
  }

  /* ── Resources ── */
  .resources-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--s-md);
  }
  .resource-card {
    display: flex;
    flex-direction: column;
    gap: var(--s-xs);
    background: var(--canvas-soft);
    border-radius: var(--r-md);
    padding: var(--s-md);
    box-shadow: var(--shadow-1);
    text-decoration: none;
    color: inherit;
    transition: background .15s;
  }
  .resource-card:hover { background: var(--canvas-soft-2); }
  .resource-card strong {
    font-size: 14px;
    font-weight: 600;
    color: var(--link);
  }
  .resource-card p {
    font-size: 13px;
    color: var(--body-text);
    line-height: 1.55;
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .device-stats { flex-direction: column; }
    .stat-divider { width: 100%; height: 1px; }
    .device-cta-card { flex-direction: column; }
    .codec-table th, .codec-table td { padding: var(--s-xs) var(--s-sm); }
    .note-col { display: none; }
    .troubleshoot-fix { padding-left: 0; }
  }
</style>
