---
import Layout from '../layouts/Layout.astro';
import { buildToolAlternates } from '../lib/i18n';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Online Speaker Sound Test",
      "url": "https://onlineaudiotest.com/speaker-test/",
      "description": "Free browser speaker sound test for left/right channel routing and a listening comparison. Results depend on your browser, output device, room, and audio settings.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "Any",
      "browserRequirements": "Requires Web Audio API (Chrome, Firefox, Safari, Edge)",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "featureList": ["Play separate left and right channel signals", "Listen to both channels together", "Play pink noise and selected test tones", "Works with speakers and headphones", "No download required"],
      "provider": { "@type": "Organization", "name": "OnlineAudioTest.com", "url": "https://onlineaudiotest.com/" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://onlineaudiotest.com/" },
        { "@type": "ListItem", "position": 2, "name": "Online Speaker Test", "item": "https://onlineaudiotest.com/speaker-test/" }
      ]
    }
  ]
};
---

<Layout
  title="Online Speaker Sound Test — Check Left and Right Audio"
  description="Run a free browser speaker test for left/right channel routing and a listening comparison with test tones and pink noise. Results depend on your audio setup."
  keywords="online speaker test, speaker test, speaker sound test, check my speaker, left right speaker test, left right sound test, left right channel test, stereo speaker test, audio channel test, speaker balance test"
  schema={schema}
  alternates={buildToolAlternates('/speaker-test/', '/pt-br/teste-de-alto-falante/')}
  sidebar={true}
>

  <!-- HERO -->
  <section class="tool-hero container">
    <h1>Online Speaker Sound Test</h1>
    <p>Check your speaker sound with this free online speaker test. Test left and right channels separately, compare stereo balance, and listen to bass and full-range tones on speakers, soundbars, headphones, or earbuds. No download or account required.</p>
  </section>

  <!-- TOOL — unchanged -->
  <div class="tool-card-wrap">
    <div class="tool-card" id="speaker-tool">

      <div class="status-bar">
        <div class="status-pill">
          <span class="dot" id="status-dot"></span>
          <span id="status-text">Ready to test</span>
        </div>
      </div>

      <div class="speaker-diagram" aria-label="Speaker channel visualization">
        <div class="speaker-block" id="spk-left">
          <div class="speaker-icon" aria-hidden="true">
            <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
              <rect x="6" y="14" width="10" height="12" rx="2" stroke="currentColor" stroke-width="1.5"/>
              <path d="M16 14L26 8v24L16 26" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
              <path d="M29 14c2.5 1.5 4 3.5 4 6s-1.5 4.5-4 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <span class="speaker-label">Left</span>
          <div class="speaker-pulse" id="pulse-left" aria-hidden="true"></div>
        </div>

        <div class="speaker-center-info">
          <div class="vol-ring">
            <span class="vol-pct" id="vol-pct">25</span>
            <span class="vol-unit">%</span>
          </div>
        </div>

        <div class="speaker-block" id="spk-right">
          <div class="speaker-icon" aria-hidden="true">
            <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
              <rect x="24" y="14" width="10" height="12" rx="2" stroke="currentColor" stroke-width="1.5"/>
              <path d="M24 14L14 8v24l10-6" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
              <path d="M11 14C8.5 15.5 7 17.5 7 20s1.5 4.5 4 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <span class="speaker-label">Right</span>
          <div class="speaker-pulse" id="pulse-right" aria-hidden="true"></div>
        </div>
      </div>

      <div class="vol-row">
        <span class="eyebrow">Room volume</span>
        <input type="range" id="vol-slider" min="0" max="100" value="25" class="vol-slider" aria-label="Test volume" />
        <span class="vol-hint caption-mono">Set a level you can clearly hear across the room</span>
      </div>

      <div class="freq-row">
        <span class="eyebrow">Signal type</span>
        <div class="freq-chips">
          <button class="freq-chip active" data-freq="pink">
            Pink noise <span class="chip-badge">full spectrum</span>
          </button>
          <button class="freq-chip" data-freq="100">100 Hz <span class="chip-sub">woofer</span></button>
          <button class="freq-chip" data-freq="440">440 Hz <span class="chip-sub">mid</span></button>
          <button class="freq-chip" data-freq="1000">1 kHz <span class="chip-sub">high-mid</span></button>
        </div>
      </div>

      <div class="action-row">
        <button class="btn btn-secondary btn-sm" id="btn-left">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M8 2L4 6l4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Left only
        </button>
        <button class="btn btn-primary btn-lg" id="btn-both" style="min-width:148px">
          <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true"><path d="M2.5 1.5l7 4-7 4V1.5z" fill="currentColor"/></svg>
          Both Speakers
        </button>
        <button class="btn btn-secondary btn-sm" id="btn-right">
          Right only
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M4 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>

      <p class="result-note" id="result-note">Select a channel to begin the speaker test.</p>
    </div>
  </div>

  <!-- HOW TO USE -->
  <div class="how-section">
    <h2>How to check your speakers and left/right audio</h2>
    <div class="steps">
      <div class="step"><span class="step-num">1</span><p class="step-body"><strong>Set a comfortable volume.</strong> Start low, then raise it only enough to hear the test clearly. Avoid loud or prolonged tones.</p></div>
      <div class="step"><span class="step-num">2</span><p class="step-body"><strong>Play Left only, then Right only.</strong> Listen for the channel labels to match the side where you hear sound. Your operating system, adapter, soundbar, or wireless device may remap or mix channels.</p></div>
      <div class="step"><span class="step-num">3</span><p class="step-body"><strong>Play both channels.</strong> Pink noise and test tones let you compare the sound by ear. This is a listening comparison, not a calibrated level or frequency-response measurement.</p></div>
      <div class="step"><span class="step-num">4</span><p class="step-body"><strong>If something seems wrong, check the route.</strong> Confirm the selected output and app settings, then try another browser or device. For external speakers, check connections only when safe and follow the manufacturer's guidance.</p></div>
    </div>
  </div>

  <div class="how-section">
    <h2>What this speaker sound test can tell you</h2>
    <p>The tool plays left-channel, right-channel, combined, pink-noise, and selected tone signals through your browser's chosen output. You can use it to listen for channel routing differences or compare the two sides in your current setup.</p>
    <p>It cannot measure acoustic output, confirm that a speaker driver is healthy or damaged, isolate an amplifier fault, or prove that the channels are perfectly balanced. Results can change with mono settings, spatial audio, Bluetooth modes, soundbar processing, room acoustics, hearing differences, and the selected output device.</p>
    <p>For headphone checks, use the same channel controls and listen for left/right routing. For a frequency sweep and headphone-specific guidance, see the <a href="/headphone-test/">headphone sound test</a>. If you need to check whether the browser selected the right output device, use the <a href="/audio-device-check/">audio device check</a>.</p>
  </div>

  <!-- FAQ -->
  <div class="faq-section">
    <h2>Frequently asked questions</h2>
    <div class="faq-item"><p class="faq-q">How do I test my left and right speakers online?</p><p class="faq-a">Choose Left only and then Right only, and listen for sound on the corresponding side. The result reflects your current browser, operating system, audio route, and speakers; some devices may mix or remap channels.</p></div>
    <div class="faq-item"><p class="faq-q">Can this test tell me if a speaker is broken?</p><p class="faq-a">No. It can help you hear whether the test signal reaches each side in your current setup, but silence or distortion does not identify a damaged driver. Check the selected output and app settings, then consult the device maker or a qualified technician if the problem continues.</p></div>
    <div class="faq-item"><p class="faq-q">Can I use this as a speaker balance test?</p><p class="faq-a">You can compare the channels by listening to both together, but this is not a calibrated volume measurement. Room placement, reflections, device processing, and hearing can affect the perceived center.</p></div>
    <div class="faq-item"><p class="faq-q">What does pink noise check?</p><p class="faq-a">Pink noise is a broadband signal you can use to compare the sound from both sides. It does not isolate a specific speaker driver or measure frequency response.</p></div>
    <div class="faq-item"><p class="faq-q">Can I test headphones with this tool?</p><p class="faq-a">Yes. Select Left only and Right only and listen for sound in the corresponding ear. Your device or headphone processing may affect channel routing.</p></div>
    <div class="faq-item"><p class="faq-q">Why do both soundbar sides play during a left-only test?</p><p class="faq-a">A soundbar or other playback device may apply its own processing or channel mixing. This page cannot determine whether that behavior comes from the soundbar, operating system, app, or browser route. Check the product settings and documentation.</p></div>
  </div>

</Layout>

<script>
  (() => {
    let audioCtx: AudioContext | null = null;
    let activeNodes: { osc?: OscillatorNode; gain: GainNode; buf?: AudioBufferSourceNode }[] = [];
    let currentFreq: number | 'pink' = 'pink';
    let volume = 0.25;
    let isPlaying = false;
    let currentChannel: 'left' | 'right' | 'both' | null = null;

    const statusDot   = document.getElementById('status-dot')!;
    const statusText  = document.getElementById('status-text')!;
    const resultNote  = document.getElementById('result-note')!;
    const btnLeft     = document.getElementById('btn-left') as HTMLButtonElement;
    const btnRight    = document.getElementById('btn-right') as HTMLButtonElement;
    const btnBoth     = document.getElementById('btn-both') as HTMLButtonElement;
    const volSlider   = document.getElementById('vol-slider') as HTMLInputElement;
    const volPct      = document.getElementById('vol-pct')!;
    const spkLeft     = document.getElementById('spk-left')!;
    const spkRight    = document.getElementById('spk-right')!;
    const pulseLeft   = document.getElementById('pulse-left')!;
    const pulseRight  = document.getElementById('pulse-right')!;

    function getCtx() {
      if (!audioCtx) audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
      return audioCtx;
    }

    function stopAll() {
      const ctx = getCtx();
      activeNodes.forEach(({ gain, osc, buf }) => {
        try { gain.gain.setTargetAtTime(0, ctx.currentTime, 0.04); } catch {}
        try { osc?.stop(ctx.currentTime + 0.1); } catch {}
        try { buf?.stop(ctx.currentTime + 0.1); } catch {}
      });
      activeNodes = [];
      isPlaying = false;
      currentChannel = null;
      spkLeft.classList.remove('active');
      spkRight.classList.remove('active');
      pulseLeft.classList.remove('pulsing');
      pulseRight.classList.remove('pulsing');
    }

    function makePinkNoise(ctx: AudioContext): AudioBuffer {
      const len = ctx.sampleRate * 2;
      const buf = ctx.createBuffer(1, len, ctx.sampleRate);
      const out = buf.getChannelData(0);
      let b0=0,b1=0,b2=0,b3=0,b4=0,b5=0,b6=0;
      for (let i = 0; i < len; i++) {
        const w = Math.random() * 2 - 1;
        b0=0.99886*b0+w*0.0555179; b1=0.99332*b1+w*0.0750759;
        b2=0.96900*b2+w*0.1538520; b3=0.86650*b3+w*0.3104856;
        b4=0.55000*b4+w*0.5329522; b5=-0.7616*b5-w*0.0168980;
        out[i]=(b0+b1+b2+b3+b4+b5+b6+w*0.5362)/7; b6=w*0.115926;
      }
      return buf;
    }

    function play(channel: 'left' | 'right' | 'both') {
      stopAll();
      const ctx = getCtx();
      if (ctx.state === 'suspended') ctx.resume();

      const gain   = ctx.createGain();
      const panner = ctx.createStereoPanner();
      gain.connect(panner);
      panner.connect(ctx.destination);
      gain.gain.setValueAtTime(0, ctx.currentTime);
      gain.gain.linearRampToValueAtTime(volume, ctx.currentTime + 0.08);
      panner.pan.value = channel === 'left' ? -1 : channel === 'right' ? 1 : 0;

      if (currentFreq === 'pink') {
        const src = ctx.createBufferSource();
        src.buffer = makePinkNoise(ctx);
        src.loop = true;
        src.connect(gain);
        src.start();
        activeNodes.push({ gain, buf: src });
      } else {
        const osc = ctx.createOscillator();
        osc.type = 'sine';
        osc.frequency.value = currentFreq;
        osc.connect(gain);
        osc.start();
        activeNodes.push({ gain, osc });
      }

      isPlaying = true;
      currentChannel = channel;
      statusDot.className = 'dot active';
      btnBoth.innerHTML = `<svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true"><rect x="1.5" y="1.5" width="8" height="8" rx="1.5" fill="currentColor"/></svg> Stop`;

      spkLeft.classList.toggle('active',  channel === 'left'  || channel === 'both');
      spkRight.classList.toggle('active', channel === 'right' || channel === 'both');
      pulseLeft.classList.toggle('pulsing',  channel === 'left'  || channel === 'both');
      pulseRight.classList.toggle('pulsing', channel === 'right' || channel === 'both');

      if (channel === 'both') {
        statusText.textContent = 'Playing - both speakers';
        resultNote.textContent = 'Both speakers should produce equal volume and tonal character.';
      } else {
        const side = channel === 'left' ? 'LEFT' : 'RIGHT';
        statusText.textContent = `Playing - ${channel} channel`;
        resultNote.textContent = `Sound should come from your ${side} physical speaker only.`;
      }
      resultNote.className = 'result-note success';
    }

    function stop() {
      stopAll();
      statusDot.className = 'dot';
      statusText.textContent = 'Ready to test';
      resultNote.textContent = 'Select a channel to begin the speaker test.';
      resultNote.className = 'result-note';
      btnBoth.innerHTML = `<svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true"><path d="M2.5 1.5l7 4-7 4V1.5z" fill="currentColor"/></svg> Both Speakers`;
    }

    btnLeft.addEventListener('click',  () => { if (isPlaying && currentChannel === 'left')  { stop(); return; } play('left'); });
    btnRight.addEventListener('click', () => { if (isPlaying && currentChannel === 'right') { stop(); return; } play('right'); });
    btnBoth.addEventListener('click',  () => { if (isPlaying) { stop(); return; } play('both'); });

    volSlider.addEventListener('input', () => {
      volume = Number(volSlider.value) / 100;
      volPct.textContent = volSlider.value;
      if (isPlaying) activeNodes.forEach(({ gain }) => { try { gain.gain.value = volume; } catch {} });
    });

    document.querySelectorAll('.freq-chip').forEach(chip => {
      chip.addEventListener('click', (e) => {
        document.querySelectorAll('.freq-chip').forEach(c => c.classList.remove('active'));
        (e.currentTarget as HTMLElement).classList.add('active');
        const f = (e.currentTarget as HTMLElement).dataset.freq!;
        currentFreq = f === 'pink' ? 'pink' : Number(f);
        if (isPlaying && currentChannel) play(currentChannel);
      });
    });
  })();
</script>

<style>

  .device-nudge {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--mute);
    letter-spacing: .02em;
  }

  .speaker-diagram {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--s-xl);
    padding: var(--s-lg) 0;
  }
  .speaker-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-xs);
    position: relative;
    padding: var(--s-lg);
    border-radius: var(--r-lg);
    transition: background .2s;
  }
  .speaker-block.active { background: var(--canvas-soft-2); }
  .speaker-icon {
    width: 72px; height: 72px;
    background: var(--canvas-soft);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-2);
    color: var(--mute);
    transition: color .2s, box-shadow .2s;
  }
  .speaker-block.active .speaker-icon { color: var(--ink); box-shadow: var(--shadow-4); }
  .speaker-label { font-family: var(--font-mono); font-size: 12px; color: var(--mute); }
  .speaker-block.active .speaker-label { color: var(--ink); }
  .speaker-pulse {
    position: absolute;
    inset: 0;
    border-radius: var(--r-lg);
    border: 2px solid transparent;
    pointer-events: none;
  }
  .speaker-pulse.pulsing {
    border-color: var(--link);
    animation: pulse-ring .9s ease-out infinite;
  }
  @keyframes pulse-ring {
    0%   { opacity: .8; transform: scale(1); }
    100% { opacity: 0;  transform: scale(1.06); }
  }

  .speaker-center-info { display: flex; flex-direction: column; align-items: center; }
  .vol-ring {
    width: 64px; height: 64px;
    border-radius: 50%;
    background: var(--canvas-soft);
    box-shadow: var(--shadow-1);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2px;
  }
  .vol-pct  { font-family: var(--font-mono); font-size: 16px; font-weight: 600; color: var(--ink); }
  .vol-unit { font-family: var(--font-mono); font-size: 10px; color: var(--mute); }

  .vol-row { display: flex; flex-direction: column; gap: var(--s-xs); align-items: center; }
  .vol-slider { width: 100%; max-width: 300px; accent-color: var(--ink); cursor: pointer; height: 4px; }
  .vol-hint { color: var(--mute); }

  .freq-row { display: flex; flex-direction: column; gap: var(--s-xs); align-items: center; }
  .freq-chips { display: flex; gap: var(--s-xs); flex-wrap: wrap; justify-content: center; }
  .freq-chip {
    font-family: var(--font-mono);
    font-size: 12px;
    background: var(--canvas-soft-2);
    border: 1px solid var(--hairline);
    border-radius: var(--r-full);
    padding: 3px 12px;
    color: var(--body-text);
    cursor: pointer;
    transition: all .15s;
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .freq-chip:hover { border-color: var(--hairline-strong); color: var(--ink); }
  .freq-chip.active { background: var(--invert-bg); color: var(--invert-fg); border-color: var(--invert-bg); }
  .chip-sub { font-size: 10px; opacity: .6; }
  .chip-badge {
    font-size: 10px;
    padding: 1px 6px;
    border-radius: var(--r-full);
  }
  .freq-chip.active .chip-badge { background: var(--chip-active-badge); opacity: .85; }
  .freq-chip:not(.active) .chip-badge {
    background: var(--canvas-soft);
    color: var(--mute);
    border: 1px solid var(--hairline);
  }

  /* ── Content section additions ── */

  .how-section p {
    font-size: 14px;
    color: var(--body-text);
    line-height: 1.7;
    margin-bottom: var(--s-md);
  }
  .how-section p:last-child { margin-bottom: 0; }

  .how-section h3 {
    font-size: 15px;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: var(--s-xs);
  }

  .how-section ul,
  .how-section ol {
    padding-left: var(--s-lg);
    margin-bottom: var(--s-md);
  }
  .how-section li {
    font-size: 14px;
    color: var(--body-text);
    line-height: 1.7;
    margin-bottom: 4px;
  }
  .how-section ul { list-style: disc; }
  .how-section ol { list-style: decimal; }
  .how-section li strong { color: var(--ink); font-weight: 500; }

  .how-section a { color: var(--link); text-decoration: underline; text-underline-offset: 2px; }
  .how-section strong { color: var(--ink); font-weight: 500; }

  /* Content images */
  .content-img {
    margin: var(--s-xl) auto;
    max-width: 100%;
  }
  .content-img img {
    width: 100%;
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-3);
    display: block;
  }
  .content-img figcaption {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--mute);
    text-align: center;
    margin-top: var(--s-xs);
    line-height: 1.5;
  }

  /* Signal grid */
  .signal-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-md);
    margin-top: var(--s-lg);
  }
  .signal-card {
    background: var(--canvas);
    border-radius: var(--r-md);
    padding: var(--s-md);
    box-shadow: var(--shadow-2);
    display: flex;
    flex-direction: column;
    gap: var(--s-xs);
  }
  .signal-name {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
  }
  .signal-freq {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--mute);
  }
  .signal-desc {
    font-size: 13px;
    color: var(--body-text);
    line-height: 1.55;
    flex: 1;
  }
  .signal-result {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 3px 8px;
    border-radius: var(--r-full);
    display: inline-block;
    width: fit-content;
    line-height: 1.4;
  }
  .signal-result.pass {
    background: var(--success-bg);
    color: var(--success-fg);
    border: 1px solid var(--success-border);
  }
  .signal-result.fail {
    background: var(--grade-poor-bg);
    color: var(--grade-poor-fg);
  }

  /* Problem blocks */
  .problem-block {
    border-top: 1px solid var(--hairline);
    padding-top: var(--s-lg);
    margin-top: var(--s-lg);
  }

  /* Conclusion paragraph inside FAQ section */
  .conclusion-text {
    font-size: 14px;
    color: var(--body-text);
    line-height: 1.7;
    margin-top: var(--s-xl);
    padding-top: var(--s-lg);
    border-top: 1px solid var(--hairline);
  }
  .conclusion-text a { color: var(--link); text-decoration: underline; text-underline-offset: 2px; }

  @media (max-width: 560px) {
    .signal-grid { grid-template-columns: 1fr; }
    .content-img { max-width: 100%; }
  }

  @media (max-width: 480px) {
    .speaker-diagram { gap: var(--s-md); padding: var(--s-sm) 0; }
    .speaker-block { padding: var(--s-sm); }
    .speaker-icon { width: 56px; height: 56px; }
    .vol-ring { width: 52px; height: 52px; }
    .vol-pct { font-size: 14px; }
    .freq-chips { gap: var(--s-xxs); }
    .freq-chip { padding: 3px 8px; }
  }
</style>
