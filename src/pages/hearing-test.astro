---
import Layout from '../layouts/Layout.astro';
import { buildToolAlternates } from '../lib/i18n';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "Online Hearing Test — Frequency Sweep",
      "url": "https://onlineaudiotest.com/hearing-test/",
      "description": "Browser tone sweep that reports the highest frequency heard in a session. Playback equipment affects results; not a clinical hearing assessment.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "Any",
      "browserRequirements": "Requires Web Audio API support",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "provider": { "@type": "Organization", "name": "OnlineAudioTest.com", "url": "https://onlineaudiotest.com" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://onlineaudiotest.com/" },
        { "@type": "ListItem", "position": 2, "name": "Online Hearing Test", "item": "https://onlineaudiotest.com/hearing-test/" }
      ]
    }
  ]
};
---

<Layout
  title="Hearing Test Online – Free Frequency Hearing Test"
  description="Try a browser tone sweep from 20 Hz to 20 kHz and see the highest tone heard in this session. Equipment affects results; not a clinical hearing test."
  keywords="hearing test online, free hearing test online, online frequency hearing test, frequency hearing test online, high frequency hearing test online, sound frequency hearing test, hearing range test"
  canonical="https://onlineaudiotest.com/hearing-test/"
  alternates={buildToolAlternates('/hearing-test/', '/pt-br/teste-de-audicao/')}
  schema={schema}
  sidebar={true}
>

  <!-- HERO -->
  <section class="tool-hero container">
    <h1>Hearing Test Online — Free Frequency Hearing Test</h1>
    <p>A browser-generated tone sweep from 20 Hz to 20,000 Hz. Stop when you no longer hear the tone to view this session's playback result. Headphones, volume, and environment affect the result; this is not a clinical hearing assessment.</p>
  </section>

  <!-- TOOL CARD -->
  <div class="tool-card-wrap">
    <div class="tool-card" id="ht-card">

      <!-- Status pill -->
      <div class="status-bar">
        <div class="status-pill">
          <span class="dot" id="ht-dot"></span>
          <span id="ht-status">Ready</span>
        </div>
        <span class="eyebrow caption-mono" id="ht-label"></span>
      </div>

      <!-- ── IDLE ── -->
      <div id="phase-idle">
        <p class="phase-desc">Use these steps for a more consistent listening check:</p>
        <ul class="checklist">
          <li><span class="chk">✓</span>Use headphones — laptop speakers cannot reproduce high frequencies</li>
          <li><span class="chk">✓</span>Set volume to a comfortable level before starting</li>
          <li><span class="chk">✓</span>Test in a quiet room</li>
          <li><span class="chk">✓</span>Results are educational only — not a medical diagnosis</li>
        </ul>
        <div class="action-row">
          <button class="btn btn-primary btn-lg" id="btn-start">
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true"><polygon points="2,1 12,6.5 2,12" fill="currentColor"/></svg>
            Start Test
          </button>
        </div>
      </div>

      <!-- ── TESTING ── -->
      <div id="phase-test" hidden>
        <p class="test-instruction">The tone is rising. Press the button the moment you <strong>can no longer hear it.</strong></p>

        <div class="freq-display" aria-live="polite" aria-label="Current frequency">
          <span class="freq-num" id="freq-num">20</span>
          <span class="freq-unit" id="freq-unit">Hz</span>
        </div>

        <div class="tone-bars" id="tone-bars" aria-hidden="true">
          <span></span><span></span><span></span><span></span><span></span>
        </div>

        <div class="sweep-track" role="progressbar" aria-label="Frequency sweep progress">
          <div class="sweep-fill" id="sweep-fill"></div>
          <div class="sweep-labels">
            <span>20 Hz</span><span>1 kHz</span><span>5 kHz</span><span>10 kHz</span><span>20 kHz</span>
          </div>
        </div>

        <div class="action-row" style="margin-top:var(--s-lg)">
          <button class="btn-stop" id="btn-stop" aria-label="Stop,I can no longer hear this tone">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="3" y="3" width="10" height="10" rx="2" fill="currentColor"/></svg>
            I Can No Longer Hear It
          </button>
        </div>
        <p class="result-note" style="text-align:center;margin-top:var(--s-sm)">Click as soon as the tone fades out of your hearing.</p>
      </div>

      <!-- ── RESULTS ── -->
      <div id="phase-results" hidden>
        <div class="result-max-wrap">
          <span class="result-label">Your maximum audible frequency</span>
          <div class="result-freq-row">
            <span class="result-freq-num" id="result-num">—</span>
            <span class="result-freq-unit" id="result-unit">Hz</span>
          </div>
        </div>

        <!-- Grade badge -->
        <div class="result-interp" id="result-interp"></div>

        <!-- Personalized interpretation -->
        <div class="personalized-block" id="personalized-block"></div>

        <!-- You vs Average -->
        <div class="comparison-block" id="comparison-block"></div>

        <p class="result-disclaimer">No hearing-age estimate is provided. This result is the tone cutoff reported for this session only.</p>
        <!-- Shareable badge -->
        <div class="badge-block" id="badge-block"></div>

        <!-- Dynamic SEO section -->
        <div class="dynamic-seo" id="dynamic-seo"></div>

        <div class="result-disclaimer">
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" stroke="currentColor" stroke-width="1.3"/><line x1="8" y1="5" x2="8" y2="9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><circle cx="8" cy="11.5" r="0.75" fill="currentColor"/></svg>
          For educational purposes only. Not a substitute for professional hearing evaluation.
        </div>

        <div class="action-row" style="margin-top:var(--s-lg)">
          <button class="btn btn-secondary" id="btn-retake">Take Test Again</button>
          <button class="btn btn-primary" id="btn-copy-badge">Copy Result</button>
        </div>
      </div>

    </div>
  </div>

  <!-- ═══ EDUCATIONAL CONTENT ═══ -->
  <div class="edu-section">
    <h2>How this online frequency test works</h2>
    <p>The browser plays a tone sweep from 20 Hz to 20,000 Hz. Stop when you can no longer hear it; the result is the approximate frequency at that point in this playback session. The page does not record your microphone or measure the sound reaching your ears.</p>
    <p>Headphone frequency response, volume, device audio processing, hearing environment, and attention can all change the result. A tone you cannot hear here does not establish a hearing loss, and a high result does not rule one out. This is an entertainment and listening check, not a diagnostic test or substitute for an audiogram.</p>
    <h2>For a more consistent listening check</h2>
    <ul>
      <li>Use the same headphones and device each time.</li>
      <li>Choose a quiet room and set a comfortable listening level before starting.</li>
      <li>Stop if any tone feels uncomfortable; do not raise volume to chase a result.</li>
      <li>Contact a qualified hearing professional if you have hearing concerns or symptoms.</li>
    </ul>
    <p>To check whether your speakers reproduce left and right channels, use the <a href="/speaker-test/">speaker test</a>. To generate a selected tone for listening, use the <a href="/frequency-generator/">online frequency generator</a>.</p>
  </div>

  <div class="faq-section">
    <h2>Frequently asked questions</h2>
    <div class="faq-item"><p class="faq-q">Does this online hearing test diagnose hearing loss?</p><p class="faq-a">No. It reports the point where you stopped hearing a browser-generated tone sweep. It is affected by playback equipment and listening conditions and is not a clinical hearing assessment.</p></div>
    <div class="faq-item"><p class="faq-q">Why can my result change between attempts?</p><p class="faq-a">Headphone response, device audio processing, volume, background noise, attention, and the way you judge the tone can change what you hear. Use the same setup for a rough comparison, not as a medical measurement.</p></div>
    <div class="faq-item"><p class="faq-q">Should I turn up the volume if I cannot hear a tone?</p><p class="faq-a">No. Keep the volume comfortable and do not increase it to force a tone to become audible. Stop if you experience discomfort.</p></div>
    <div class="faq-item"><p class="faq-q">When should I seek a professional hearing check?</p><p class="faq-a">If you are concerned about your hearing or notice a change, contact a qualified hearing professional. This browser test cannot determine the cause or degree of a hearing problem.</p></div>
  </div>
</Layout>

<script>
  (() => {
    const START_FREQ  = 20;
    const END_FREQ    = 20000;
    const MID_FREQ    = Math.sqrt(START_FREQ * END_FREQ); // ~632 Hz,log midpoint
    const PHASE1_DUR  = 10;  // 20 Hz → 632 Hz  (was 30s → 3× faster)
    const PHASE2_DUR  = 15;  // 632 Hz → 20 kHz (was 30s → 2× faster)
    const DURATION    = PHASE1_DUR + PHASE2_DUR; // 25s total

    let phase: 'idle' | 'testing' | 'results' = 'idle';
    let audioCtx: AudioContext | null = null;
    let osc: OscillatorNode | null = null;
    let gainNode: GainNode | null = null;
    let rafId = 0;
    let sweepStartCtxTime = 0;
    let stoppedFreq = 0;

    const phaseIdle    = document.getElementById('phase-idle')!;
    const phaseTest    = document.getElementById('phase-test')!;
    const phaseResults = document.getElementById('phase-results')!;
    const htDot        = document.getElementById('ht-dot')!;
    const htStatus     = document.getElementById('ht-status')!;
    const htLabel      = document.getElementById('ht-label')!;
    const freqNum      = document.getElementById('freq-num')!;
    const freqUnit     = document.getElementById('freq-unit')!;
    const sweepFill    = document.getElementById('sweep-fill')!;
    const toneBars     = document.getElementById('tone-bars')!;
    const btnStart     = document.getElementById('btn-start') as HTMLButtonElement;
    const btnStop      = document.getElementById('btn-stop') as HTMLButtonElement;
    const btnRetake    = document.getElementById('btn-retake') as HTMLButtonElement;
    const resultNum        = document.getElementById('result-num')!;
    const resultUnit       = document.getElementById('result-unit')!;
    const resultInterp     = document.getElementById('result-interp')!;
    const personalizedBlock= document.getElementById('personalized-block')!;
    const comparisonBlock  = document.getElementById('comparison-block')!;
    const badgeBlock       = document.getElementById('badge-block')!;
    const dynamicSeo       = document.getElementById('dynamic-seo')!;

    function audio(): AudioContext {
      if (!audioCtx) audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
      if (audioCtx.state === 'suspended') audioCtx.resume();
      return audioCtx;
    }

    function freqAtTime(elapsed: number): number {
      if (elapsed <= PHASE1_DUR) {
        const t = elapsed / PHASE1_DUR;
        return START_FREQ * Math.pow(MID_FREQ / START_FREQ, t);
      }
      const t = Math.min((elapsed - PHASE1_DUR) / PHASE2_DUR, 1);
      return MID_FREQ * Math.pow(END_FREQ / MID_FREQ, t);
    }

    function formatFreq(hz: number): { num: string; unit: string } {
      if (hz >= 1000) return { num: (hz / 1000).toFixed(1), unit: 'kHz' };
      return { num: Math.round(hz).toLocaleString(), unit: 'Hz' };
    }

    function showPhase(p: typeof phase) {
      phase = p;
      phaseIdle.hidden    = p !== 'idle';
      phaseTest.hidden    = p !== 'testing';
      phaseResults.hidden = p !== 'results';
    }

    // ── Start
    btnStart.addEventListener('click', () => {
      const ctx = audio();
      osc = ctx.createOscillator();
      gainNode = ctx.createGain();
      osc.type = 'sine';

      // Schedule piecewise logarithmic sweep
      const t0 = ctx.currentTime + 0.05;
      osc.frequency.setValueAtTime(START_FREQ, t0);
      osc.frequency.exponentialRampToValueAtTime(MID_FREQ, t0 + PHASE1_DUR);
      osc.frequency.exponentialRampToValueAtTime(END_FREQ, t0 + PHASE1_DUR + PHASE2_DUR);

      gainNode.gain.setValueAtTime(0, ctx.currentTime);
      gainNode.gain.linearRampToValueAtTime(0.4, t0 + 0.05);

      osc.connect(gainNode);
      gainNode.connect(ctx.destination);
      osc.start(t0);
      osc.stop(t0 + DURATION + 0.1);

      sweepStartCtxTime = t0;
      showPhase('testing');
      htDot.className = 'dot active';
      htStatus.textContent = 'Sweeping';
      toneBars.classList.add('is-playing');

      cancelAnimationFrame(rafId);
      rafId = requestAnimationFrame(tick);
    });

    function tick() {
      if (phase !== 'testing') return;
      const ctx = audio();
      const elapsed = ctx.currentTime - sweepStartCtxTime;
      const freq = freqAtTime(elapsed);
      const t = Math.min(elapsed / DURATION, 1);

      const { num, unit } = formatFreq(freq);
      freqNum.textContent = num;
      freqUnit.textContent = unit;
      sweepFill.style.width = (t * 100).toFixed(2) + '%';
      htLabel.textContent = num + ' ' + unit;

      if (t >= 1) { stopSweep(); return; }
      rafId = requestAnimationFrame(tick);
    }

    function stopSweep() {
      cancelAnimationFrame(rafId);
      const ctx = audio();
      const elapsed = ctx.currentTime - sweepStartCtxTime;
      stoppedFreq = Math.min(freqAtTime(elapsed), END_FREQ);

      if (gainNode) {
        gainNode.gain.cancelScheduledValues(ctx.currentTime);
        gainNode.gain.setValueAtTime(gainNode.gain.value, ctx.currentTime);
        gainNode.gain.linearRampToValueAtTime(0, ctx.currentTime + 0.04);
      }
      try { osc?.stop(ctx.currentTime + 0.05); } catch {}
      osc = null; gainNode = null;

      toneBars.classList.remove('is-playing');
      showResults();
    }

    btnStop.addEventListener('click', stopSweep);

    // ── Results helpers
    function getInterp(_hz: number): { label: string; text: string; cls: string } {
      return { label: 'Playback result', text: 'This is the highest tone you reported hearing in this session. It is not a clinical hearing test: headphones, volume, browser output, background noise, and listening conditions can change the result. Contact a hearing professional if you have concerns.', cls: 'grade-fair' };
    }


    function buildPersonalized(hz: number): string {
      const k = (hz / 1000).toFixed(1);
      return `<p><strong>Session result: ${k} kHz</strong></p><p>This is the approximate point where you stopped hearing the tone in this attempt. It cannot be used to estimate hearing age or diagnose a hearing condition. Playback equipment and listening conditions affect the result.</p>`;
    }

    function buildComparison(hz: number): string {
      const k = (hz / 1000).toFixed(1);
      return `<div class="comp-title">This attempt</div><p>You stopped near <strong>${k} kHz</strong>. Repeat only at a comfortable volume, using the same playback setup if you want to compare sessions.</p>`;
    }
    function buildBadge(hz: number): string {
      const k = (hz / 1000).toFixed(1);
      const copyText = `Highest tone heard in this session: ${k} kHz\nNot a clinical hearing test.\nTested at OnlineAudioTest.com`;
      return `<div class="badge-card"><div class="badge-lines"><div class="badge-line"><span class="badge-key">Highest tone heard in this session</span><span class="badge-val">${k} kHz</span></div><div class="badge-line"><span class="badge-key">Clinical result</span><span class="badge-val">Not a hearing diagnosis</span></div><div class="badge-line"><span class="badge-key">Tested at</span><span class="badge-val">OnlineAudioTest.com</span></div></div><button class="btn-copy-inner" data-text="${encodeURIComponent(copyText)}">Copy Result</button></div>`;
    }

    function buildDynamicSeo(hz: number): string {
      const k = (hz / 1000).toFixed(1);
      const hzRounded = Math.round(hz / 1000) * 1000;
      return `<div class="dyn-seo-block"><h3>Session result: ${hzRounded.toLocaleString()} Hz</h3><p>You stopped the tone sweep at approximately ${k} kHz. This result describes this playback session only. Output equipment and environment affect which tones are audible; it cannot establish hearing ability, compare your age group, or diagnose hearing loss.</p></div>`;
    }

    function showResults() {
      const hz = Math.round(stoppedFreq);
      const { num, unit } = formatFreq(hz);
      const interp = getInterp(hz);

      resultNum.textContent  = num;
      resultUnit.textContent = unit;

      resultInterp.innerHTML      = `<div class="interp-row"><span class="grade-badge ${interp.cls}">${interp.label}</span><p class="interp-text">${interp.text}</p></div>`;
      personalizedBlock.innerHTML = buildPersonalized(hz);
      comparisonBlock.innerHTML   = buildComparison(hz);
      badgeBlock.innerHTML        = buildBadge(hz);
      dynamicSeo.innerHTML        = buildDynamicSeo(hz);

      badgeBlock.querySelector<HTMLButtonElement>('.btn-copy-inner')?.addEventListener('click', async (e) => {
        const btn = e.currentTarget as HTMLButtonElement;
        const text = decodeURIComponent(btn.dataset.text || '');
        try { await navigator.clipboard.writeText(text); } catch {}
        btn.textContent = '✓ Copied!';
        setTimeout(() => { btn.textContent = 'Copy Result'; }, 2000);
      });

      htDot.className = 'dot';
      htStatus.textContent = 'Test complete';
      htLabel.textContent  = (hz / 1000).toFixed(1) + ' kHz max';
      showPhase('results');
    }

    btnRetake.addEventListener('click', () => {
      cancelAnimationFrame(rafId);
      try { osc?.stop(); } catch {}
      osc = null; gainNode = null;
      toneBars.classList.remove('is-playing');
      htDot.className = 'dot';
      htStatus.textContent = 'Ready';
      htLabel.textContent = '';
      freqNum.textContent = '20';
      freqUnit.textContent = 'Hz';
      sweepFill.style.width = '0%';
      showPhase('idle');
    });
  })();
</script>

<style>
  /* ── Checklist ── */
  .checklist { list-style: none; display: flex; flex-direction: column; gap: var(--s-sm); margin: var(--s-md) 0 var(--s-xl); padding: 0; }
  .checklist li { display: flex; align-items: flex-start; gap: var(--s-sm); font-size: 14px; color: var(--body-text); line-height: 1.5; }
  .chk { color: #10b981; font-weight: 700; flex-shrink: 0; margin-top: 1px; }
  .phase-desc { font-size: 14px; color: var(--body-text); line-height: 1.6; }

  /* ── Test instruction ── */
  .test-instruction { font-size: 15px; color: var(--body-text); line-height: 1.6; margin-bottom: var(--s-sm); }
  .test-instruction strong { color: var(--ink); }

  /* ── Frequency display ── */
  .freq-display { display: flex; align-items: baseline; gap: 8px; justify-content: center; padding: var(--s-lg) 0 var(--s-xs); }
  .freq-num { font-family: var(--font-mono); font-size: 64px; font-weight: 700; line-height: 1; letter-spacing: -3px; color: var(--ink); }
  .freq-unit { font-family: var(--font-mono); font-size: 24px; font-weight: 500; color: var(--mute); }

  /* ── Tone bars ── */
  .tone-bars { display: flex; align-items: flex-end; gap: 4px; height: 32px; justify-content: center; margin-bottom: var(--s-md); }
  .tone-bars span { width: 5px; border-radius: 3px; background: var(--link); height: 4px; opacity: 0.2; flex-shrink: 0; }
  .tone-bars.is-playing span { opacity: 0.8; }
  .tone-bars.is-playing span:nth-child(1) { animation: tb1 0.65s ease-in-out infinite; }
  .tone-bars.is-playing span:nth-child(2) { animation: tb2 0.65s ease-in-out infinite 0.1s; }
  .tone-bars.is-playing span:nth-child(3) { animation: tb3 0.65s ease-in-out infinite 0.2s; }
  .tone-bars.is-playing span:nth-child(4) { animation: tb2 0.65s ease-in-out infinite 0.15s; }
  .tone-bars.is-playing span:nth-child(5) { animation: tb1 0.65s ease-in-out infinite 0.05s; }
  @keyframes tb1 { 0%,100% { height: 5px; } 50% { height: 16px; } }
  @keyframes tb2 { 0%,100% { height: 4px; } 50% { height: 28px; } }
  @keyframes tb3 { 0%,100% { height: 8px; } 50% { height: 32px; } }

  /* ── Sweep progress bar ── */
  .sweep-track {
    position: relative; height: 8px;
    background: var(--canvas-soft-2); border-radius: var(--r-full);
    overflow: hidden; box-shadow: var(--shadow-1); margin-bottom: var(--s-xs);
  }
  .sweep-fill {
    height: 100%; width: 0%; border-radius: var(--r-full);
    background: linear-gradient(to right, #60a5fa, #818cf8, #a78bfa, #f472b6, #fb7185);
    transition: width 0.1s linear;
  }
  .sweep-labels {
    display: flex; justify-content: space-between;
    font-family: var(--font-mono); font-size: 10px; color: var(--mute);
    margin-top: 4px; padding: 0 2px;
  }

  /* ── Stop button ── */
  .btn-stop {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    width: 100%; max-width: 360px; height: 56px;
    background: #ef4444; color: #fff;
    font-family: var(--font-sans); font-size: 17px; font-weight: 700;
    border: none; border-radius: var(--r-pill); cursor: pointer;
    transition: opacity 0.15s, transform 0.1s;
    box-shadow: 0 4px 14px rgba(239,68,68,.35);
    margin-inline: auto; display: flex;
  }
  .btn-stop:hover { opacity: 0.9; }
  .btn-stop:active { transform: scale(0.97); }

  /* ── Results ── */
  .result-max-wrap { text-align: center; margin-bottom: var(--s-lg); }
  .result-label { display: block; font-size: 13px; color: var(--mute); margin-bottom: var(--s-xs); }
  .result-freq-row { display: flex; align-items: baseline; gap: 8px; justify-content: center; }
  .result-freq-num { font-family: var(--font-mono); font-size: 64px; font-weight: 700; line-height: 1; letter-spacing: -3px; color: var(--ink); }
  .result-freq-unit { font-family: var(--font-mono); font-size: 24px; font-weight: 500; color: var(--mute); }

  /* ── Interpretation ── */
  .result-interp { margin-bottom: var(--s-lg); }
  .interp-row { display: flex; align-items: flex-start; gap: var(--s-md); background: var(--canvas-soft); border: 1px solid var(--hairline); border-radius: var(--r-md); padding: var(--s-md) var(--s-lg); }
  .interp-text { font-size: 14px; color: var(--body-text); line-height: 1.6; margin: 0; }
  .grade-badge { font-family: var(--font-mono); font-size: 11px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; padding: 3px 10px; border-radius: var(--r-full); white-space: nowrap; flex-shrink: 0; }
  .grade-excellent { background: var(--grade-excellent-bg); color: var(--grade-excellent-fg); }
  .grade-good      { background: var(--grade-good-bg);      color: var(--grade-good-fg); }
  .grade-fair      { background: var(--grade-fair-bg);      color: var(--grade-fair-fg); }
  .grade-poor      { background: var(--grade-poor-bg);      color: var(--grade-poor-fg); }

  /* ── Hearing age ── */
  .result-age-box { text-align: center; background: var(--canvas-soft-2); border-radius: var(--r-md); padding: var(--s-md) var(--s-lg); margin-bottom: var(--s-lg); }
  .age-label { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--mute); }
  .age-value { font-size: 28px; font-weight: 600; color: var(--ink); letter-spacing: -0.5px; margin: var(--s-xs) 0; }
  .age-disc  { font-size: 12px; color: var(--mute); line-height: 1.5; }

  /* ── Age comparison table ── */
  .table-wrap { margin-bottom: var(--s-lg); }
  .table-title { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: var(--mute); margin-bottom: var(--s-sm); }
