---
import Layout from '../layouts/Layout.astro';
import { buildToolAlternates } from '../lib/i18n';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "name": "AirPods Latency Test",
      "url": "https://onlineaudiotest.com/airpods-latency-test/",
      "description": "Free AirPods latency test. Measure the audio delay your AirPods, AirPods Pro, or AirPods Max introduce when connected via Bluetooth. No download required.",
      "applicationCategory": "UtilitiesApplication",
      "operatingSystem": "Any",
      "browserRequirements": "Requires Web Audio API support",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "provider": { "@type": "Organization", "name": "OnlineAudioTest.com", "url": "https://onlineaudiotest.com/" }
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://onlineaudiotest.com/" },
        { "@type": "ListItem", "position": 2, "name": "Latency Test", "item": "https://onlineaudiotest.com/latency-test/" },
        { "@type": "ListItem", "position": 3, "name": "AirPods Latency Test", "item": "https://onlineaudiotest.com/airpods-latency-test/" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "What does this AirPods latency test measure?", "acceptedAnswer": { "@type": "Answer", "text": "The browser test shows audio-context output latency reported by the browser. Its microphone option estimates a playback-to-microphone round trip. Neither isolates AirPods codec delay or measures sound at the listener's ear." } },
        { "@type": "Question", "name": "Why can my AirPods audio feel delayed?", "acceptedAnswer": { "@type": "Answer", "text": "Perceived delay depends on the connected source, operating system, app, buffering, audio route, and playback conditions. Video apps may compensate for sync, but behavior varies by app and playback context." } },
        { "@type": "Question", "name": "Can I compare latency between AirPods models with this page?", "acceptedAnswer": { "@type": "Answer", "text": "This page does not provide controlled model-by-model measurements. You can compare the same browser test across setups, but keep the device, app, content, and test mode consistent and treat the readings as estimates." } },
        { "@type": "Question", "name": "How can I reduce audio delay?", "acceptedAnswer": { "@type": "Answer", "text": "Check the sync settings in the app where you notice the issue, confirm the intended output device is selected, and compare with wired audio if available. This page cannot diagnose codec or operating-system routing." } }
      ]
    }
  ]
};
---

<Layout
  title="AirPods Latency Test — Measure Delay in ms (All Models)"
  description="Check AirPods audio delay in your browser. View reported output latency or estimate playback-to-microphone round-trip delay."
  keywords="airpods latency test, airpods latency ms, airpods pro latency ms, airpods audio delay, airpods delay test, airpods lag test, airpods pro latency, airpods max latency, bluetooth airpods latency"
  canonical="https://onlineaudiotest.com/airpods-latency-test/"
  alternates={buildToolAlternates('/airpods-latency-test/', '/pt-br/teste-de-latencia-airpods/')}
  schema={schema}
  sidebar={true}
>

  <!-- HERO -->
  <section class="tool-hero container">
    <h1>AirPods Latency Test</h1>
    <p>Connect your AirPods as the output device, then run the test. The first result uses latency values reported by your browser and device; the microphone round-trip option estimates playback-to-mic delay and may be affected by your room and setup.</p>
  </section>

  <!-- TOOL -->
  <div class="tool-card-wrap">
    <div class="tool-card" id="latency-tool">

      <div class="status-bar">
        <div class="status-pill">
          <span class="dot" id="status-dot"></span>
          <span id="status-text">Connect AirPods, then measure</span>
        </div>
        <span class="eyebrow caption-mono" id="phase-label"></span>
      </div>

      <div class="result-panel" id="result-panel" hidden>
        <div class="latency-display">
          <span class="latency-num" id="latency-num">-</span>
          <span class="latency-unit">ms</span>
        </div>
        <div class="grade-badge" id="grade-badge"></div>
        <div class="latency-breakdown" id="latency-breakdown" hidden>
          <span class="breakdown-item">Base <strong id="base-ms">-</strong> ms</span>
          <span class="breakdown-sep">·</span>
          <span class="breakdown-item">Output <strong id="output-ms">-</strong> ms</span>
        </div>
        <p class="latency-advice" id="latency-advice"></p>
      </div>

      <div class="action-row">
        <button class="btn btn-primary btn-lg" id="btn-measure" style="min-width:200px">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.4"/>
            <path d="M7 4v3.2l2 1.3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Test AirPods Latency
        </button>
        <button class="btn btn-secondary btn-sm" id="btn-roundtrip">
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <rect x="4.5" y="1" width="3" height="6" rx="1.5" stroke="currentColor" stroke-width="1.3"/>
            <path d="M2.5 6a3.5 3.5 0 007 0" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
            <line x1="6" y1="9.5" x2="6" y2="11" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
          </svg>
          Round-Trip Test (mic)
        </button>
      </div>

      <p class="result-note" id="result-note">Make sure AirPods are set as your output device before measuring.</p>
    </div>
  </div>

  <div class="how-section">
    <h2>What this AirPods latency test can tell you</h2>
    <p class="section-intro">The browser-reported value describes timing information exposed by the browser's audio system. The microphone option estimates playback-to-microphone round-trip delay. Neither isolates Bluetooth codec delay or measures sound at your ear. Room acoustics, speaker volume, microphone placement, and software processing affect the round-trip result.</p>
    <div class="steps">
      <div class="step"><span class="step-num">1</span><p class="step-body"><strong>Confirm the output.</strong> Select your AirPods as the output device and use the same browser and test mode each time.</p></div>
      <div class="step"><span class="step-num">2</span><p class="step-body"><strong>Compare setups carefully.</strong> Change one setting at a time and treat the numbers as browser or loopback estimates, not a device specification.</p></div>
      <div class="step"><span class="step-num">3</span><p class="step-body"><strong>Check sync in the affected app.</strong> Video players, meeting apps, and games handle audio timing differently. Confirm whether the issue occurs in the app you use.</p></div>
    </div>
  </div>

  <div class="how-section">
    <h2>When audio timing matters</h2>
    <p>For lip sync, first check the playback app's audio/video sync options and compare another source. For live monitoring or timing-sensitive work, compare with wired output on the same computer and application. This browser test cannot determine whether a particular AirPods model or codec is defective.</p>
  </div>
  <!-- RELATED TESTS -->
  <div class="how-section">
    <h2>Related audio tests</h2>
    <div class="steps">
      <div class="step">
        <span class="step-num">→</span>
        <p class="step-body"><a href="/latency-test/"><strong>Audio Latency Test</strong></a> — Measures system output delay for any device. Use this to test speakers, a DAC, or a wired headset.</p>
      </div>
      <div class="step">
        <span class="step-num">→</span>
        <p class="step-body"><a href="/bluetooth-latency-test/"><strong>Bluetooth Latency Test</strong></a> — View browser-reported timing or estimate playback-to-microphone round-trip delay on a Bluetooth audio route. The tool cannot identify the active codec.</p>
      </div>
      <div class="step">
        <span class="step-num">→</span>
        <p class="step-body"><a href="/mic-test/"><strong>Mic Test</strong></a> — Check if your AirPods microphone is working correctly and see input levels in real time.</p>
      </div>
      <div class="step">
        <span class="step-num">→</span>
        <p class="step-body"><a href="/devices/"><strong>Bluetooth Device Guides</strong></a> — Review device pages for compatibility notes and test limitations; these pages do not provide controlled model-by-model latency rankings.</p>
      </div>
    </div>
  </div>

  <div class="faq-section">
    <h2>Frequently asked questions</h2>
    <div class="faq-item"><p class="faq-q">What does this AirPods latency test measure?</p><p class="faq-a">The browser test shows audio-context output latency reported by the browser. Its microphone option estimates a playback-to-microphone round trip. Neither isolates AirPods codec delay or measures sound at your ear.</p></div>
    <div class="faq-item"><p class="faq-q">Why can my AirPods audio feel delayed?</p><p class="faq-a">Perceived delay depends on the connected source, operating system, app, buffering, audio route, and playback conditions. Video apps may compensate for sync, but behavior varies by app and playback context.</p></div>
    <div class="faq-item"><p class="faq-q">Can I compare latency between AirPods models with this page?</p><p class="faq-a">This page does not provide controlled model-by-model measurements. You can compare the same browser test across setups, but keep the device, app, content, and test mode consistent and treat readings as estimates.</p></div>
    <div class="faq-item"><p class="faq-q">How can I reduce audio delay?</p><p class="faq-a">Check sync settings in the app where you notice the issue, confirm the intended output device is selected, and compare with wired audio if available. This page cannot diagnose codec or operating-system routing.</p></div>
  </div>
</Layout>

<script>
  (() => {
    type Phase = 'idle' | 'measuring' | 'result' | 'rt-requesting' | 'rt-running' | 'rt-result';

    let phase: Phase = 'idle';
    let audioCtx: AudioContext | null = null;

    const btnMeasure   = document.getElementById('btn-measure') as HTMLButtonElement;
    const btnRoundtrip = document.getElementById('btn-roundtrip') as HTMLButtonElement;
    const statusDot    = document.getElementById('status-dot')!;
    const statusText   = document.getElementById('status-text')!;
    const phaseLabel   = document.getElementById('phase-label')!;
    const resultPanel  = document.getElementById('result-panel')!;
    const latencyNum   = document.getElementById('latency-num')!;
    const gradeBadge   = document.getElementById('grade-badge')!;
    const breakdown    = document.getElementById('latency-breakdown')!;
    const baseMs       = document.getElementById('base-ms')!;
    const outputMs     = document.getElementById('output-ms')!;
    const latencyAdvice = document.getElementById('latency-advice')!;
    const resultNote   = document.getElementById('result-note')!;

    function getCtx() {
      if (!audioCtx) audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
      return audioCtx;
    }

    function setStatus(active: boolean, warning: boolean, text: string) {
      statusText.textContent = text;
      statusDot.className = 'dot' + (active ? ' active' : warning ? ' warning' : '');
    }

    function grade(_ms: number, measurementLabel: string): { label: string; cls: string; advice: string } {
      const isRoundTrip = measurementLabel.toLowerCase().includes('round-trip');
      return {
        label: isRoundTrip ? 'Round-trip estimate' : 'Browser-reported value',
        cls: 'grade-neutral',
        advice: isRoundTrip
          ? 'This playback-to-microphone estimate depends on room acoustics, speaker volume, microphone placement, and processing. It does not isolate AirPods delay.'
          : 'This value is reported by the browser audio system. It may not include the complete Bluetooth path and is not a measurement at your ear.'
      };
    }

    function showResult(ms: number, label: string, baseVal?: number, outputVal?: number) {
      const g = grade(ms, label);
      latencyNum.textContent = ms < 1 ? '<1' : ms.toFixed(ms < 10 ? 1 : 0);
      gradeBadge.textContent = g.label;
      gradeBadge.className = 'grade-badge ' + g.cls;
      latencyAdvice.textContent = g.advice;
      phaseLabel.textContent = label;

      if (baseVal !== undefined && outputVal !== undefined) {
        baseMs.textContent = baseVal.toFixed(1);
        outputMs.textContent = outputVal.toFixed(1);
        breakdown.hidden = false;
      } else {
        breakdown.hidden = true;
      }

      resultPanel.hidden = false;
    }

    async function measureSystem() {
      phase = 'measuring';
      setStatus(true, false, 'Measuring AirPods latency…');
      btnMeasure.disabled = true;
      btnRoundtrip.disabled = true;
      resultNote.textContent = 'Initializing audio context…';

      const ctx = getCtx();
      if (ctx.state === 'suspended') await ctx.resume();

      const warmup = ctx.createBuffer(1, ctx.sampleRate * 0.1, ctx.sampleRate);
      const src = ctx.createBufferSource();
      src.buffer = warmup;
      src.connect(ctx.destination);
      src.start();

      await new Promise<void>(r => setTimeout(r, 150));

      const base   = (ctx.baseLatency   ?? 0) * 1000;
      const output = (ctx.outputLatency ?? 0) * 1000;
      const total  = base + output;

      phase = 'result';
      setStatus(false, false, 'Measurement complete');

      if (total < 0.5) {
        showResult(0, 'AirPods latency');
        resultNote.textContent = 'Your browser does not expose latency values. Use the Round-Trip Test for a direct measurement.';
        resultNote.className = 'result-note';
      } else {
        showResult(total, 'AirPods latency', base, output);
        resultNote.textContent = 'Browser-reported system latency. Make sure AirPods were the active output device; compare results with the same setup.';
        resultNote.className = 'result-note success';
      }

      btnMeasure.textContent = 'Measure Again';
      btnMeasure.disabled = false;
      btnRoundtrip.disabled = false;
    }

    async function runRoundTrip() {
      phase = 'rt-requesting';
      setStatus(false, true, 'Requesting mic…');
      btnMeasure.disabled = true;
      btnRoundtrip.disabled = true;
      resultNote.textContent = 'Allow microphone access to run the round-trip test.';
      resultNote.className = 'result-note';

      let stream: MediaStream;
      try {
        stream = await navigator.mediaDevices.getUserMedia({
          audio: { echoCancellation: false, noiseSuppression: false, autoGainControl: false }
        });
      } catch {
        setStatus(false, false, 'Mic access denied');
        resultNote.textContent = 'Microphone access is required for the round-trip test.';
        resultNote.className = 'result-note error';
        btnMeasure.disabled = false;
        btnRoundtrip.disabled = false;
        phase = 'result';
        return;
      }

      phase = 'rt-running';
      setStatus(true, false, 'Running round-trip test…');
      resultNote.textContent = 'Keep your microphone near your AirPods or speakers. Running test…';

      const ctx = getCtx();
      if (ctx.state === 'suspended') await ctx.resume();

      const micSrc  = ctx.createMediaStreamSource(stream);
      const analyser = ctx.createAnalyser();
      analyser.fftSize = 256;
      micSrc.connect(analyser);

      const baseline = await measureBaseline(analyser, 400);

      const clickDelay = 0.3;
      const clickAt = ctx.currentTime + clickDelay;
      playImpulse(ctx, clickAt, 0.85);
      const clickWallMs = Date.now() + clickDelay * 1000;

      const latencyMs = await detectImpulse(analyser, baseline, clickWallMs);

      stream.getTracks().forEach(t => t.stop());
      micSrc.disconnect();

      phase = 'rt-result';
      setStatus(false, false, 'Test complete');

      if (latencyMs === null) {
        resultNote.textContent = 'Could not detect the test click. Make sure your speakers are audible and try in a quieter environment.';
        resultNote.className = 'result-note error';
      } else {
        showResult(latencyMs, 'Round-trip latency');
        resultNote.textContent = 'Round-trip delay estimate detected from AirPods playback to microphone. Room acoustics and microphone placement can affect the result.';
        resultNote.className = 'result-note success';
      }

      btnMeasure.disabled = false;
      btnRoundtrip.disabled = false;
    }

    function measureBaseline(analyser: AnalyserNode, durationMs: number): Promise<number> {
      return new Promise(resolve => {
        const buf = new Uint8Array(analyser.frequencyBinCount);
        let sum = 0, count = 0;
        const start = Date.now();
        const tick = () => {
          analyser.getByteTimeDomainData(buf);
          let s = 0;
          for (let i = 0; i < buf.length; i++) s += ((buf[i] / 128) - 1) ** 2;
          sum += Math.sqrt(s / buf.length);
          count++;
          if (Date.now() - start < durationMs) requestAnimationFrame(tick);
          else resolve(count > 0 ? sum / count : 0);
        };
        tick();
      });
    }

    function playImpulse(ctx: AudioContext, when: number, gain: number) {
      const duration = 0.01;
      const buf = ctx.createBuffer(1, Math.floor(ctx.sampleRate * duration), ctx.sampleRate);
      const data = buf.getChannelData(0);
      for (let i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1);

      const gainNode = ctx.createGain();
      gainNode.gain.value = gain;
      gainNode.connect(ctx.destination);

      const src = ctx.createBufferSource();
      src.buffer = buf;
      src.connect(gainNode);
      src.start(when);
    }

    function detectImpulse(analyser: AnalyserNode, baseline: number, clickWallMs: number): Promise<number | null> {
      return new Promise(resolve => {
        const threshold = Math.max(baseline * 3.5, 0.05);
        const buf = new Uint8Array(analyser.frequencyBinCount);
        const giveUpAt = clickWallMs + 3000;

        const poll = () => {
          const now = Date.now();
          if (now > giveUpAt) { resolve(null); return; }

          analyser.getByteTimeDomainData(buf);
          let s = 0;
          for (let i = 0; i < buf.length; i++) s += ((buf[i] / 128) - 1) ** 2;
          const rms = Math.sqrt(s / buf.length);

          if (now >= clickWallMs && rms > threshold) {
            resolve(now - clickWallMs);
            return;
          }

          setTimeout(poll, 4);
        };

        const waitMs = Math.max(0, clickWallMs - Date.now() - 50);
        setTimeout(poll, waitMs);
      });
    }

    btnMeasure.addEventListener('click', measureSystem);
    btnRoundtrip.addEventListener('click', runRoundTrip);
  })();
</script>

<style>
  .result-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-sm);
    padding: var(--s-lg) 0;
  }

  .latency-display {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .latency-num {
    font-family: var(--font-mono);
    font-size: 64px;
    font-weight: 700;
    line-height: 1;
    color: var(--ink);
    letter-spacing: -2px;
  }
  .latency-unit {
    font-family: var(--font-mono);
    font-size: 20px;
    font-weight: 500;
    color: var(--mute);
  }

  .grade-badge {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .04em;
    text-transform: uppercase;
    padding: 3px 12px;
    border-radius: var(--r-full);
  }
  .grade-neutral { color: var(--mute); background: var(--canvas-soft); }
  .grade-excellent { background: var(--grade-excellent-bg); color: var(--grade-excellent-fg); }
  .grade-good      { background: var(--grade-good-bg); color: var(--grade-good-fg); }
  .grade-fair      { background: var(--grade-fair-bg); color: var(--grade-fair-fg); }
  .grade-poor      { background: var(--grade-poor-bg); color: var(--grade-poor-fg); }

  .latency-breakdown {
    display: flex;
    align-items: center;
    gap: var(--s-sm);
    font-size: 12px;
    color: var(--mute);
    font-family: var(--font-mono);
  }
  .breakdown-item strong { color: var(--ink); }
  .breakdown-sep { color: var(--hairline-strong); }

  .latency-advice {
    font-size: 13px;
    color: var(--body-text);
    text-align: center;
    max-width: 420px;
    line-height: 1.6;
    margin: 0;
  }

  .section-intro {
    font-size: 14px;
    color: var(--body-text);
    line-height: 1.6;
    margin: 0 0 var(--s-md);
  }

  .level-table-wrap { overflow-x: auto; }

  .level-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    line-height: 1.5;
  }

  .level-table th {
    text-align: left;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .04em;
    text-transform: uppercase;
    color: var(--mute);
    padding: var(--s-xs) var(--s-sm);
    border-bottom: 1px solid var(--hairline);
  }

  .level-table td {
    padding: var(--s-xs) var(--s-sm);
    border-bottom: 1px solid var(--hairline);
    color: var(--body-text);
    vertical-align: top;
  }

  .level-table td:first-child {
    font-weight: 500;
    color: var(--ink);
    white-space: nowrap;
  }

  .level-table tbody tr:last-child td { border-bottom: none; }
</style>
