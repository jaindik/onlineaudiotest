---
import Layout from '../layouts/Layout.astro';
import { buildToolAlternates } from '../lib/i18n';

export interface Props {
  title: string;
  description: string;
  keywords: string;
  h1: string;
  intro: string;
  englishPath: string;
  portuguesePath: string;
  sections: Array<{ heading: string; body: string }>;
  related: Array<{ href: string; label: string }>;
}

const { title, description, keywords, h1, intro, englishPath, portuguesePath, sections, related } = Astro.props;
const canonical = `https://onlineaudiotest.com${portuguesePath}`;
const schema = { '@context': 'https://schema.org', '@type': 'TechArticle', headline: h1, description, url: canonical, author: { '@type': 'Organization', name: 'OnlineAudioTest.com', url: 'https://onlineaudiotest.com/' }, publisher: { '@type': 'Organization', name: 'OnlineAudioTest.com', url: 'https://onlineaudiotest.com/' } };
---

<Layout title={title} description={description} keywords={keywords} canonical={canonical} locale="pt-BR" alternates={buildToolAlternates(englishPath, portuguesePath)} schema={schema}>
  <article class="localized-article container"><header class="article-header"><p class="eyebrow">Guia de áudio</p><h1>{h1}</h1><p>{intro}</p></header>{sections.map((section) => <section class="article-section"><h2>{section.heading}</h2><p>{section.body}</p></section>)}<section class="article-section"><h2>Continue testando</h2><div class="related-grid">{related.map((item) => <a href={item.href}>{item.label} →</a>)}</div></section></article>
</Layout>

<style>
  .localized-article { max-width: 760px; padding-top: var(--s-4xl); padding-bottom: var(--s-5xl); } .article-header { text-align: center; margin-bottom: var(--s-3xl); } .article-header h1 { margin: var(--s-sm) 0 var(--s-md); } .article-header p:not(.eyebrow) { max-width: 660px; margin-inline: auto; color: var(--body-text); line-height: 1.7; } .article-section { border-top: 1px solid var(--hairline); padding: var(--s-2xl) 0 0; margin-top: var(--s-2xl); } .article-section h2 { margin-bottom: var(--s-md); } .article-section p { color: var(--body-text); line-height: 1.8; } .related-grid { display: grid; gap: var(--s-sm); } .related-grid a { color: var(--link); text-decoration: underline; text-underline-offset: 2px; }
</style>
